@page "/reset-password"
@rendermode InteractiveServer
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Web.ApiServices
@inject AuthApiService AuthApi
@inject NavigationManager Nav

<PageTitle>Zmiana hasła – ODDAJ DALEJ</PageTitle>

<div class="register-container">
    <div class="register-card">

        @if (done)
        {
            <h2>Hasło zostało zmienione</h2>
            <p>Możesz teraz zalogować się nowym hasłem.</p>
            <button type="button" class="register-button" @onclick='() => Nav.NavigateTo("/login", forceLoad: true)'>
                Zaloguj się
            </button>
        }
        else if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            <h2>Nieprawidłowy link</h2>
            <p>Ten link do zmiany hasła jest niepoprawny lub niekompletny. Poproś o nowy.</p>
            <button type="button" class="register-button" @onclick='() => Nav.NavigateTo("/forgot-password")'>
                Poproś o nowy link
            </button>
        }
        else
        {
            <h2>Zmiana hasła</h2>
            <p>Wpisz nowe hasło i powtórz je poniżej.</p>

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="avatar-upload-error">@error</p>
                @if (linkExpired)
                {
                    <button type="button" class="login-secondary" @onclick='() => Nav.NavigateTo("/forgot-password")'>
                        Poproś o nowy link
                    </button>
                }
            }

            <EditForm Model="@model" OnValidSubmit="Submit" FormName="reset-password">
                <DataAnnotationsValidator />
                <div class="register-field">
                    <label>Nowe hasło</label>
                    <InputText @bind-Value="model.NewPassword"
                               class="register-input"
                               type="password"
                               placeholder="Wpisz nowe hasło" />
                    <ValidationMessage For="@(() => model.NewPassword)" />
                </div>
                <div class="register-field">
                    <label>Powtórz nowe hasło</label>
                    <InputText @bind-Value="model.ConfirmPassword"
                               class="register-input"
                               type="password"
                               placeholder="Powtórz nowe hasło" />
                    <ValidationMessage For="@(() => model.ConfirmPassword)" />
                </div>
                <small>Co najmniej 8 znaków, wielka i mała litera oraz cyfra.</small>
                <button type="submit" class="register-button" disabled="@saving">
                    @(saving ? "Zapisywanie..." : "Zmień hasło")
                </button>
            </EditForm>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private ResetPasswordRequest model = new();
    private bool saving;
    private bool done;
    private bool linkExpired;
    private string? error;

    protected override void OnParametersSet()
    {
        model.Email = Email ?? "";
        model.Token = Token ?? "";
    }

    private async Task Submit()
    {
        saving = true;
        error = null;
        linkExpired = false;

        var result = await AuthApi.ResetPasswordAsync(model);

        saving = false;
        if (result == null)
        {
            done = true;
            return;
        }

        error = result;
        linkExpired = result.Contains("wygasł");
    }
}