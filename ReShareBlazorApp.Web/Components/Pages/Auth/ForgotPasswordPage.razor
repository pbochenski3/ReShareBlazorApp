@page "/forgot-password"
@rendermode InteractiveServer
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Web.ApiServices
@inject AuthApiService AuthApi
@inject NavigationManager Nav

<PageTitle>Odzyskiwanie hasła – ODDAJ DALEJ</PageTitle>

<div class="register-container">
    <div class="register-card">
        <h2>Nie pamiętasz hasła?</h2>

        @if (sent)
        {
            <p>
                Jeśli konto z adresem <strong>@model.Email</strong> istnieje, wysłaliśmy na nie
                wiadomość z linkiem do zmiany hasła. Link jest ważny przez 1 godzinę.
            </p>
            <p>Nie widzisz wiadomości? Sprawdź folder ze spamem.</p>
            <button type="button" class="register-button" @onclick='() => Nav.NavigateTo("/login")'>
                Wróć do logowania
            </button>
        }
        else
        {
            <p>Podaj adres e-mail powiązany z kontem, a wyślemy Ci link do ustawienia nowego hasła.</p>

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="avatar-upload-error">@error</p>
            }

            <EditForm Model="@model" OnValidSubmit="Submit" FormName="forgot-password">
                <DataAnnotationsValidator />
                <div class="register-field">
                    <label>E-mail</label>
                    <InputText @bind-Value="model.Email"
                               class="register-input"
                               type="email"
                               placeholder="Wpisz e-mail" />
                    <ValidationMessage For="@(() => model.Email)" />
                </div>
                <button type="submit" class="register-button" disabled="@sending">
                    @(sending ? "Wysyłanie..." : "Wyślij link")
                </button>
            </EditForm>

            <button type="button" class="login-secondary" @onclick='() => Nav.NavigateTo("/login")'>
                Wróć do logowania
            </button>
        }
    </div>
</div>

@code {
    private ForgotPasswordRequest model = new();
    private bool sending;
    private bool sent;
    private string? error;

    private async Task Submit()
    {
        sending = true;
        error = null;

        var ok = await AuthApi.ForgotPasswordAsync(model.Email.Trim());

        sending = false;
        if (ok)
            sent = true;
        else
            error = "Nie udało się wysłać wiadomości. Spróbuj ponownie później.";
    }
}