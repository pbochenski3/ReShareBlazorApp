@page "/odkrywaj"

<PageTitle>Odkrywaj – ODDAJ DALEJ</PageTitle>

<PageHeader Title="Odkrywaj" Subtitle="Przeglądaj ogłoszenia dodane przez innych użytkowników." />


<section class="home-section">
    <div class="home-container page-layout">

        <aside class="page-filters">
            <form method="get" action="/odkrywaj">
                <h2 class="page-filters-title">Filtry</h2>

                <label class="home-field">
                    <span>Czego szukasz?</span>
                    <input type="search" name="q" placeholder="np. rower" />
                </label>

                <label class="home-field">
                    <span>Kategoria</span>
                    <select name="kategoria">
                        <option value="">Wszystkie</option>
                        <option>Bilety i rezerwacje</option>
                        <option>Wyjazdy i podróże</option>
                        <option>Transport i miejsca</option>
                        <option>Sprzęt i wypożyczenia</option>
                        <option>Usługi i wolne terminy</option>
                        <option>Wspólne aktywności</option>
                        <option>Dom i przestrzeń</option>
                        <option>Edukacja i rozwój</option>
                        <option>Rodzina i dzieci</option>
                        <option>Biznes i współpraca</option>
                    </select>
                </label>

                <fieldset class="page-fieldset">
                    <legend>Typ ogłoszenia</legend>
                    <label><input type="checkbox" name="typ" value="sprzedam" /> Sprzedam</label>
                    <label><input type="checkbox" name="typ" value="oddam" /> Oddam</label>
                    <label><input type="checkbox" name="typ" value="wypozycze" /> Wypożyczę</label>
                    <label><input type="checkbox" name="typ" value="wolne-miejsce" /> Mam wolne miejsce</label>
                    <label><input type="checkbox" name="typ" value="wolny-termin" /> Wolny termin</label>
                    <label><input type="checkbox" name="typ" value="wymienie" /> Wymienię</label>
                </fieldset>

                <label class="home-field">
                    <span>Lokalizacja</span>
                    <input type="text" name="lokalizacja" placeholder="Miejscowość lub kod" />
                </label>

                <label class="home-field">
                    <span>Promień</span>
                    <select name="promien">
                        <option value="5">5 km</option>
                        <option value="10">10 km</option>
                        <option value="25">25 km</option>
                        <option value="50">50 km</option>
                        <option value="100">100 km</option>
                    </select>
                </label>

                <div class="page-price-row">
                    <label class="home-field">
                        <span>Cena od</span>
                        <input type="number" name="cenaMin" min="0" />
                    </label>
                    <label class="home-field">
                        <span>Cena do</span>
                        <input type="number" name="cenaMax" min="0" />
                    </label>
                </div>

                <button class="home-btn home-btn-primary page-full" type="submit">Pokaż wyniki</button>
            </form>
        </aside>

        <div class="page-results">
            <div class="home-section-head page-results-head">
                <p class="page-count">Znaleziono 6 ogłoszeń</p>

                <label class="page-sort">
                    <span>Sortuj:</span>
                    <select>
                        <option>Najnowsze</option>
                        <option>Cena rosnąco</option>
                        <option>Cena malejąco</option>
                        <option>Najbliżej mnie</option>
                    </select>
                </label>
            </div>

            <div class="home-cards">
                <ListingCard Title="2 bilety na koncert – Kraków" Category="Bilety i rezerwacje" Type="Sprzedam"
                             Price="240 zł" Location="Kraków" Term="12.12.2026" Published="08.11.2026" Verified="true" />
                <ListingCard Title="Wolne miejsce w aucie do Berlina" Category="Transport i miejsca" Type="Mam wolne miejsce"
                             Price="60 zł" Location="Warszawa" Term="20.11.2026" Published="08.11.2026" Verified="true" />
                <ListingCard Title="Wózek dziecięcy do oddania" Category="Rodzina i dzieci" Type="Oddam"
                             Price="Bezpłatnie" Location="Łódź" Term="od zaraz" Published="07.11.2026" />
                <ListingCard Title="Wiertarka udarowa na weekend" Category="Sprzęt i wypożyczenia" Type="Wypożyczę"
                             Price="30 zł / dzień" Location="Gdańsk" Term="cały rok" Published="06.11.2026" Verified="true" />
                <ListingCard Title="Nocleg dla dwóch osób – Zakopane" Category="Wyjazdy i podróże" Type="Sprzedam"
                             Price="350 zł" Location="Zakopane" Term="05.12.2026" Published="05.11.2026" />
                <ListingCard Title="Korepetycje z angielskiego" Category="Usługi i wolne terminy" Type="Mam wolny termin"
                             Price="70 zł / godz." Location="Poznań" Term="pon–pt po 16:00" Published="04.11.2026" Verified="true" />
            </div>

            <nav class="page-pagination" aria-label="Strony wyników">
                <a class="page-page" href="#">‹</a>
                <a class="page-page active" href="#">1</a>
                <a class="page-page" href="#">2</a>
                <a class="page-page" href="#">3</a>
                <a class="page-page" href="#">›</a>
            </nav>
        </div>
    </div>
</section>

<SiteFooter />
