@page "/odkrywaj"

@using ReShareBlazorApp.Api.Date.Enums
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Web.ApiServices
@using ReShareBlazorApp.Web.Components.Elements
@using System.Globalization

@inject ProductApiService productApi

<PageTitle>Odkrywaj – ODDAJ DALEJ</PageTitle>

<PageHeader Title="Odkrywaj"
            Subtitle="Przeglądaj ogłoszenia dodane przez innych użytkowników." />

<section class="home-section">
    <div class="home-container">

        <div class="home-search">

            <div class="home-search-row">

                <label class="home-field home-field-wide">
                    <span>Czego szukasz?</span>
                    <input type="search"
                           @bind="searchText"
                           @bind:event="oninput"
                           placeholder="np. bilety na koncert" />
                </label>

                <label class="home-field">
                    <span>Kategoria</span>
                    <select @bind="selectedCategory">
                        <option value="">Wszystkie</option>

                        @foreach (var category in Enum.GetValues<ProductCategory>())
                        {
                            <option value="@category.ToString()">
                                @GetCategoryName(category)
                            </option>
                        }
                    </select>
                </label>

               
                <label class="home-field">
                    <span>Lokalizacja</span>

                    <input type="text"
                           @bind="locationFilter"
                           @bind:event="oninput"
                           @bind:after="LoadSuggestedLocations"
                           list="polskie-miasta"
                           placeholder="Wpisz miejscowość..." />

                    <datalist id="polskie-miasta">
                        @foreach (var city in SuggestedLocations)
                        {
                            <option value="@city.Name"></option>
                        }
                    </datalist>
                </label>

            </div>

            <div class="home-search-row">

                <label class="home-field">
                    <span>Cena od (zł)</span>
                    <input type="number"
                           @bind="cenaMin"
                           @bind:event="oninput"
                           min="0"
                           step="0.01"
                           placeholder="0" />
                </label>

                <label class="home-field">
                    <span>Cena do (zł)</span>
                    <input type="number"
                           @bind="cenaMax"
                           @bind:event="oninput"
                           min="0"
                           step="0.01"
                           placeholder="1000" />
                </label>

            </div>

        </div>

        <div class="home-section-head page-results-head">

            <div>
                <h2>Wyniki wyszukiwania</h2>

                <p class="page-count">
                    Znaleziono @FilteredProducts.Count ogłoszeń
                </p>
            </div>

            <label class="page-sort">
                <span>Sortuj:</span>

                <select @bind="sortowanie">
                    <option value="najnowsze">Najnowsze</option>
                    <option value="cenaRosnaco">Cena rosnąco</option>
                    <option value="cenaMalejaco">Cena malejąco</option>
                </select>
            </label>

        </div>

        @if (!productsLoaded)
        {
            <p>Ładowanie ogłoszeń...</p>
        }
        else if (!FilteredProducts.Any())
        {
            <p>Nie znaleziono ogłoszeń spełniających kryteria wyszukiwania.</p>
        }
        else
        {
            <div class="home-cards">

                @foreach (var product in FilteredProducts)
                {
                    <ListingCard Title="@product.Name"
                                 Category="@GetCategoryName(product.Category)"
                                 Type="@product.Type"
                                 Price="@product.Price.ToString("F2", CultureInfo.InvariantCulture)"
                                 Location="@product.City"
                                 Term="@(product.ExpiresAt.ToString("HH:mm") ?? "Brak terminu")"
                                 Published="@product.AddedAt.ToString("dd.MM.yyyy HH:mm")"
                                 Link=@product.ProductId/>
                }

            </div>
        }

    </div>
</section>

@code {

    public List<ProductDTO> ProductsList { get; set; } = new();
    public List<LocationDTO> SuggestedLocations { get; set; } = new();

    [SupplyParameterFromQuery(Name = "q")]
    public string? InitialSearch { get; set; }

    [SupplyParameterFromQuery(Name = "kategoria")]
    public string? InitialCategory { get; set; }

    [SupplyParameterFromQuery(Name = "lokalizacja")]
    public string? InitialLocation { get; set; }

    [SupplyParameterFromQuery(Name = "cenaMin")]
    public string? InitialMinPrice { get; set; }

    [SupplyParameterFromQuery(Name = "cenaMax")]
    public string? InitialMaxPrice { get; set; }

    private string searchText = "";
    private string selectedCategory = "";
    private string locationFilter = "";

    private string cenaMin = "";
    private string cenaMax = "";
    private async Task LoadSuggestedLocations()
    {
        if (string.IsNullOrWhiteSpace(locationFilter) ||
            locationFilter.Trim().Length < 2)
        {
            SuggestedLocations.Clear();
            return;
        }

        SuggestedLocations = await productApi.SearchLocationsAsync(
            locationFilter.Trim());
    }

    private string sortowanie { get; set; } = "najnowsze";

    private bool productsLoaded;

    protected override async Task OnParametersSetAsync()
    {
        searchText = InitialSearch ?? "";
        selectedCategory = InitialCategory ?? "";
        locationFilter = InitialLocation ?? "";
        cenaMin = InitialMinPrice ?? "";
        cenaMax = InitialMaxPrice ?? "";

        if (!productsLoaded)
        {
            ProductsList = await productApi.GetProductsAsync(20);
            productsLoaded = true;
        }
    }

    private List<ProductDTO> FilteredProducts
    {
        get
        {
            var products = ProductsList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var search = searchText.Trim();

                products = products.Where(p =>
                    (!string.IsNullOrWhiteSpace(p.Name) &&
                     p.Name.Contains(search, StringComparison.OrdinalIgnoreCase))
                    ||
                    (!string.IsNullOrWhiteSpace(p.Description) &&
                     p.Description.Contains(search, StringComparison.OrdinalIgnoreCase))
                );
            }

            if (!string.IsNullOrWhiteSpace(selectedCategory))
            {
                products = products.Where(p =>
                    p.Category.ToString() == selectedCategory);
            }

            if (!string.IsNullOrWhiteSpace(locationFilter))
            {
                products = products.Where(p =>
                    !string.IsNullOrWhiteSpace(p.City) &&
                    p.City.Contains(locationFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (decimal.TryParse(cenaMin, NumberStyles.Number,
                CultureInfo.InvariantCulture, out var min))
            {
                products = products.Where(p => p.Price >= min);
            }

            if (decimal.TryParse(cenaMax, NumberStyles.Number,
                CultureInfo.InvariantCulture, out var max))
            {
                products = products.Where(p => p.Price <= max);
            }

            return sortowanie switch
            {
                "cenaRosnaco" => products.OrderBy(p => p.Price).ToList(),

                "cenaMalejaco" => products.OrderByDescending(p => p.Price).ToList(),

                _ => products.OrderByDescending(p => p.AddedAt).ToList()
            };
        }
    }

    private string GetCategoryName(ProductCategory category)
    {
        return category switch
        {
            ProductCategory.Tickets => "Bilety",
            ProductCategory.Reservations => "Rezerwacje",
            ProductCategory.Trips => "Wyjazdy i podróże",
            ProductCategory.Transports => "Transport",
            ProductCategory.Services => "Usługi",
            _ => category.ToString()
        };
    }
}
