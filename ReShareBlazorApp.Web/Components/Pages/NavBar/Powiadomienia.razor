@page "/powiadomienia"
@attribute [Authorize]
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Shared.Enums
@using ReShareBlazorApp.Web.ApiServices
@inject NotificationApiService NotificationApi
@inject NavigationManager Navigation

<PageTitle>Powiadomienia – ODDAJ DALEJ</PageTitle>

<section class="notifications-page home-section">
    <div class="home-container">
        <div class="notifications-toolbar">
            <div class="notifications-filters" role="group" aria-label="Filtruj powiadomienia">
                <button type="button" class="@FilterClass("all")" @onclick='() => activeFilter = "all"'>
                    Wszystkie <span>@notifications.Count</span>
                </button>
                <button type="button" class="@FilterClass("unread")" @onclick='() => activeFilter = "unread"'>
                    Nieprzeczytane <span>@UnreadCount</span>
                </button>
            </div>
            @if (UnreadCount > 0)
            {
                <button class="notifications-mark-all" type="button" disabled="@isBusy" @onclick="MarkAllAsReadAsync">
                    Oznacz wszystkie jako przeczytane
                </button>
            }
        </div>

        @if (isLoading)
        {
            <div class="notifications-state">
                <span class="notifications-spinner"></span>
                <p>Ładujemy powiadomienia...</p>
            </div>
        }
        else if (VisibleNotifications.Count == 0)
        {
            <div class="notifications-state notifications-empty">
                <div class="notifications-empty-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg>
                </div>
                <h2>@(activeFilter == "unread" ? "Wszystko przeczytane" : "Na razie cisza")</h2>
                <p>@(activeFilter == "unread" ? "Nie masz żadnych nieprzeczytanych powiadomień." : "Gdy pojawi się coś ważnego, znajdziesz to właśnie tutaj.")</p>
                @if (activeFilter == "unread")
                {
                    <button type="button" class="notifications-secondary-button" @onclick='() => activeFilter = "all"'>Zobacz wszystkie</button>
                }
            </div>
        }
        else
        {
            <div class="notifications-list">
                @foreach (var notification in VisibleNotifications)
                {
                    <article class="notification-card @(notification.IsRead ? "is-read" : "is-unread")" @key="notification.Id">
                        <div class="notification-card-icon @(notification.Type == NotificationType.OfferMatch ? "is-match" : notification.Type == NotificationType.NewReview ? "is-review" : notification.Type == NotificationType.AdminWarning || notification.Type == NotificationType.ReportResponse ? "is-warning" : notification.Type == NotificationType.BadgeEarned ? "is-badge" : "is-message")">
                            @if (notification.Type == NotificationType.OfferMatch)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7 10 17l-5-5"/><path d="M4 4h16v16H4z"/></svg>
                            }
                            else if (notification.Type == NotificationType.NewReview)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3z"/></svg>
                            }
                            else if (notification.Type == NotificationType.AdminWarning || notification.Type == NotificationType.ReportResponse)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4m0 3h.01"/></svg>
                            }
                            else if (notification.Type == NotificationType.BadgeEarned)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8m-4-4v4M7 4h10v5a5 5 0 0 1-10 0V4z"/><path d="M7 6H4v2a4 4 0 0 0 4 4m9-6h3v2a4 4 0 0 1-4 4"/></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"/></svg>
                            }
                        </div>
                        <div class="notification-card-content">
                            <div class="notification-card-heading">
                                <h2>@notification.Title</h2>
                                @if (!notification.IsRead)
                                {
                                    <span class="notification-new-label">Nowe</span>
                                }
                            </div>
                            <p>@notification.Message</p>
                            <time datetime="@notification.CreatedAt.ToString("O")">@FormatDate(notification.CreatedAt)</time>
                            <div class="notification-card-actions">
                                @if (notification.Type == NotificationType.NewMessage)
                                {
                                    <button type="button" class="notification-primary-action" @onclick="() => OpenMessagesAsync(notification)">Przejdź do wiadomości <span aria-hidden="true">→</span></button>
                                }
                                else if (notification.ProductId is int productId)
                                {
                                    <button type="button" class="notification-primary-action" @onclick="() => OpenProductAsync(notification, productId)">Zobacz ogłoszenie <span aria-hidden="true">→</span></button>
                                }
                                @if (!notification.IsRead)
                                {
                                    <button type="button" class="notification-text-action" disabled="@isBusy" @onclick="() => MarkAsReadAsync(notification)">Oznacz jako przeczytane</button>
                                }
                                <button type="button" class="notification-delete-action" aria-label="Usuń powiadomienie" disabled="@isBusy" @onclick="() => DeleteAsync(notification)">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2m3 0-.8 14H5.8L5 6m4 4v6m6-6v6"/></svg>
                                </button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
<SiteFooter />

@code {
    private List<NotificationDTO> notifications = new();
    private bool isLoading = true;
    private bool isBusy;
    private string activeFilter = "all";

    private int UnreadCount => notifications.Count(item => !item.IsRead);
    private List<NotificationDTO> VisibleNotifications => notifications
        .Where(item => activeFilter == "all" || !item.IsRead)
        .OrderByDescending(item => item.CreatedAt)
        .ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private string FilterClass(string filter) =>
        $"notifications-filter {(activeFilter == filter ? "active" : "")}";

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            notifications = await NotificationApi.GetNotificationsAsync();
        }
        catch
        {
            notifications = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task MarkAsReadAsync(NotificationDTO notification)
    {
        if (notification.IsRead || isBusy) return;
        isBusy = true;
        try
        {
            if (await NotificationApi.MarkAsReadAsync(notification.Id))
                notification.IsRead = true;
        }
        finally { isBusy = false; }
    }

    private async Task MarkAllAsReadAsync()
    {
        if (isBusy || UnreadCount == 0) return;
        isBusy = true;
        try
        {
            if (await NotificationApi.MarkAllAsReadAsync())
                notifications.ForEach(item => item.IsRead = true);
        }
        finally { isBusy = false; }
    }

    private async Task DeleteAsync(NotificationDTO notification)
    {
        if (isBusy) return;
        isBusy = true;
        try
        {
            if (await NotificationApi.DeleteAsync(notification.Id))
                notifications.Remove(notification);
        }
        finally { isBusy = false; }
    }

    private async Task OpenProductAsync(NotificationDTO notification, int productId)
    {
        await MarkAsReadAsync(notification);
        Navigation.NavigateTo($"/details/{productId}");
    }

    private async Task OpenMessagesAsync(NotificationDTO notification)
    {
        await MarkAsReadAsync(notification);
        Navigation.NavigateTo("/wiadomosci");
    }

    private static string FormatDate(DateTime value)
    {
        var local = value.Kind == DateTimeKind.Utc ? value.ToLocalTime() : value;
        var now = DateTime.Now;
        if (local.Date == now.Date) return $"Dzisiaj, {local:HH:mm}";
        if (local.Date == now.Date.AddDays(-1)) return $"Wczoraj, {local:HH:mm}";
        return local.ToString("d MMM yyyy, HH:mm", new System.Globalization.CultureInfo("pl-PL"));
    }
}
