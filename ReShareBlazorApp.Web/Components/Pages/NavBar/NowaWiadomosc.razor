@page "/wiadomosci/nowa/{SenderId:int}/{RecipientId:int}/{ProductId:int}"
@attribute [Authorize]
@using System.Security.Claims
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Web.ApiServices
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ProductApiService ProductApi
@inject ChatApiService ChatApi

<PageTitle>Nowa wiadomość – ODDAJ DALEJ</PageTitle>

<section class="home-section" style="padding: 2.5rem 0;">
    <div class="home-container" style="max-width: 720px; margin: 0 auto;">

        <div style="margin-bottom: 20px;">
            <a href="@($"/details/{ProductId}")" class="home-btn home-btn-outline" style="text-decoration: none;">
                &larr; Wróć do ogłoszenia
            </a>
        </div>

        <div class="profile-card" style="padding: 2rem; border: 1px solid var(--border); border-radius: 12px; background: #fff; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
            <h1 style="font-size: 1.6rem; margin-top: 0; margin-bottom: 1.2rem; color: var(--brand);">Nowa wiadomość</h1>

            @if (isLoadingProduct)
            {
                <p class="admin-muted">Ładowanie informacji o ogłoszeniu...</p>
            }
            else if (product != null)
            {
                <!-- Karta ogłoszenia -->
                <div style="display: flex; gap: 16px; align-items: center; padding: 14px; background: var(--gray, #f9fafb); border: 1px solid var(--border, #e5e7eb); border-radius: 8px; margin-bottom: 24px;">
                    @if (product.Images?.Any() == true)
                    {
                        <img src="@($"/images/{product.Images.First().Id}")"
                             alt="@product.Name"
                             style="width: 70px; height: 70px; object-fit: cover; border-radius: 6px; flex-shrink: 0;" />
                    }
                    else
                    {
                        <div style="width: 70px; height: 70px; background: #e2e8f0; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; flex-shrink: 0;">
                            📦
                        </div>
                    }

                    <div style="flex: 1; min-width: 0;">
                        <strong style="display: block; font-size: 1.1rem; margin-bottom: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            @product.Name
                        </strong>
                        <div style="font-size: .95rem; color: var(--muted, #64748b);">
                            Cena: <strong style="color: var(--brand, #0f766e);">@(product.Price == 0 ? "Za darmo" : $"{product.Price:0.##} zł")</strong> &bull; Lokalizacja: @product.City
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="admin-alert" style="margin-bottom: 16px;">@errorMessage</div>
            }

            <form @onsubmit="SendMessageAsync" @onsubmit:preventDefault="true">
                <div style="margin-bottom: 18px;">
                    <label for="messageText" style="display: block; font-weight: 600; margin-bottom: 8px;">
                        Treść wiadomości do ogłoszeniodawcy:
                    </label>
                    <textarea id="messageText"
                              class="form-control"
                              style="width: 100%; min-height: 120px; padding: 12px 16px; border: 1px solid var(--border, #cbd5e1); border-radius: 8px; font-family: inherit; font-size: 1rem; resize: vertical;"
                              placeholder="Dzień dobry, czy ogłoszenie jest nadal aktualne? Kiedy możliwy byłby odbiór?"
                              @bind="messageContent"
                              required></textarea>
                </div>

                <div style="margin-bottom: 24px;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 500; margin-bottom: 8px;">
                        <input type="checkbox" @bind="proposePrice" />
                        Chcę zaproponować inną cenę
                    </label>

                    @if (proposePrice)
                    {
                        <div style="max-width: 220px; margin-top: 8px;">
                            <label for="offeredPrice" style="font-size: .85rem; color: var(--muted, #64748b); display: block; margin-bottom: 4px;">
                                Proponowana kwota (zł):
                            </label>
                            <input id="offeredPrice"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   style="width: 100%; padding: 8px 12px; border: 1px solid var(--border, #cbd5e1); border-radius: 6px;"
                                   @bind="offeredPriceValue" />
                        </div>
                    }
                </div>

                <div style="display: flex; gap: 12px; justify-content: flex-end;">
                    <a href="@($"/details/{ProductId}")" class="home-btn home-btn-outline" style="text-decoration: none;">
                        Anuluj
                    </a>
                    <button type="submit"
                            class="home-btn home-btn-primary"
                            disabled="@(isSending || string.IsNullOrWhiteSpace(messageContent))">
                        @(isSending ? "Wysyłanie..." : "Wyślij wiadomość")
                    </button>
                </div>
            </form>

        </div>
    </div>
</section>

<SiteFooter />

@code {
    [Parameter] public int SenderId { get; set; }
    [Parameter] public int RecipientId { get; set; }
    [Parameter] public int ProductId { get; set; }

    private ProductDTO? product;
    private bool isLoadingProduct = true;
    private bool isSending;
    private string messageContent = "";
    private bool proposePrice;
    private decimal? offeredPriceValue;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var claim = user.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!int.TryParse(claim, out var loggedUserId)
            || loggedUserId != SenderId
            || SenderId == RecipientId)
        {
            Navigation.NavigateTo("/");
            return;
        }

        try
        {
            product = await ProductApi.GetProductByIdAsync(ProductId);
        }
        catch
        {
            // fallback
        }
        finally
        {
            isLoadingProduct = false;
        }
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(messageContent))
            return;

        isSending = true;
        errorMessage = null;

        var request = new SendMessageRequest
        {
            RecipientId = RecipientId,
            ProductId = ProductId,
            Content = messageContent.Trim(),
            OfferPrice = proposePrice ? offeredPriceValue : null
        };

        var result = await ChatApi.SendMessageAsync(request);
        isSending = false;

        if (result != null)
        {
            Navigation.NavigateTo($"/wiadomosci?partnerId={RecipientId}&productId={ProductId}");
        }
        else
        {
            errorMessage = "Nie udało się wysłać wiadomości. Spróbuj ponownie za chwilę.";
        }
    }
}
