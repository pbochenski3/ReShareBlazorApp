@page "/user/{Username}"
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Shared.Enums
@inject NavigationManager Navigation
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Web.ApiServices
@using ReShareBlazorApp.Web.Components.Elements
@inject UserApiService userApi
@inject ProductApiService productApi
@inject AuthenticationStateProvider AuthStateProvider

@if (exist)
{
    <section class="home-section">
        <div class="home-container">

            <!-- Karta profilu -->
            <div class="profile-card">
                @if (avatarUrl is not null)
                {
                    <img class="avatar-upload-preview" src="@avatarUrl" alt="Zdjęcie profilowe" />
                }
                else
                {
                    <span class="avatar avatar-lg">@Initials</span>
                }

                <div class="profile-info">
                    <h2>@Username</h2>
                    @if (!string.IsNullOrEmpty(profile?.City))
                    {
                        <p class="profile-email">Lokalizacja: @profile.City</p>
                    }
                    @if (!string.IsNullOrEmpty(profile?.Bio))
                    {
                        <p class="profile-bio">@profile.Bio</p>
                    }
                    <p class="home-card-verified">✔ E-mail zweryfikowany</p>
                    <p class="profile-rating">★ 4,8 <span>(12 opinii)</span></p>
                </div>

                @if (isOwner)
                {
                    <a class="home-btn home-btn-outline" href="/ustawienia">Edytuj profil</a>
                }
            </div>

            <!-- Statystyki -->
            <div class="profile-stats">
                <div class="profile-stat"><strong>@products.Count</strong><span>Ogłoszenia</span></div>
                <div class="profile-stat"><strong>@lookingForProducts.Count</strong><span>Poszukiwania</span></div>
                <div class="profile-stat"><strong>9</strong><span>Transakcje</span></div>
                <div class="profile-stat"><strong>14</strong><span>Ulubione</span></div>
            </div>

            <!-- Zakładki -->
            <div class="profile-tabs" role="tablist">
                <button class="profile-tab @(activeTab == ProfileTab.Listings ? "active" : "")" type="button" role="tab"
                        @onclick="() => activeTab = ProfileTab.Listings">Moje ogłoszenia</button>
                <button class="profile-tab @(activeTab == ProfileTab.LookingFor ? "active" : "")" type="button" role="tab"
                        @onclick="() => activeTab = ProfileTab.LookingFor">Moje poszukiwania</button>
                <button class="profile-tab" type="button" role="tab">Ulubione</button>
                <button class="profile-tab" type="button" role="tab">Transakcje</button>
                <button class="profile-tab" type="button" role="tab">Opinie</button>
            </div>

            @if (activeTab == ProfileTab.Listings)
            {
                <ProfileProducts Products="products" EmptyMessage="Użytkownik nie ma jeszcze żadnych ogłoszeń." />
            }
            else if (activeTab == ProfileTab.LookingFor)
            {
                <ProfileProducts Products="lookingForProducts" EmptyMessage="Użytkownik nie ma jeszcze żadnych poszukiwań." />
            }

            <!-- Opinie -->
            <h2 class="home-section-title profile-subtitle">Opinie o Tobie</h2>
            <div class="profile-reviews">
                <article class="profile-review">
                    <p class="profile-rating">★★★★★ <span>Anna K.</span></p>
                    <p>Szybki kontakt, wszystko zgodnie z opisem. Polecam.</p>
                </article>
                <article class="profile-review">
                    <p class="profile-rating">★★★★☆ <span>Marek N.</span></p>
                    <p>Sprawna wymiana, drobne opóźnienie w odpowiedzi.</p>
                </article>
            </div>
        </div>
    </section>
}
else
{
    <h4>Nie znaleziono użytkownika!</h4>
}


@code {
    [Parameter]
    public string Username { get; set; } = string.Empty;
    private bool exist;
    private UserProfileDTO? profile;
    private List<ProductDTO> products = new();
    private List<ProductDTO> lookingForProducts = new();
    private ProfileTab activeTab = ProfileTab.Listings;
    private string? avatarUrl;
    private string Initials => string.IsNullOrWhiteSpace(Username)
        ? "?" : Username[..Math.Min(2, Username.Length)].ToUpper();
    private bool isOwner;
    protected override async Task OnParametersSetAsync()
    {
        profile = await userApi.GetProfileAsync(Username);
        exist = profile != null;
        avatarUrl = userApi.GetAvatarUrl(profile?.AvatarUrl);
        if (profile != null)
        {
            products = await productApi.GetProductsAsync(number: 0, userId: profile.UserId);
            lookingForProducts = await productApi.GetProductsAsync(
                number: 0,
                userId: profile.UserId,
                type: ProductType.LookingFor);
        }
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        isOwner = string.Equals(state.User.FindFirst(ClaimTypes.Name)?.Value, Username, StringComparison.OrdinalIgnoreCase);
    }

    private enum ProfileTab
    {
        Listings,
        LookingFor
    }
}   