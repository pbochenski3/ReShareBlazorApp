@page "/user/{Username}"
@using ReShareBlazorApp.Shared.DTOs
@inject NavigationManager Navigation
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Web.ApiServices
@using ReShareBlazorApp.Web.Components.Elements
@inject UserApiService userApi
@inject NotificationApiService notificationApi
@inject AuthenticationStateProvider AuthStateProvider

@if (exist)
{
    <section class="home-section">
        <div class="home-container">

            <!-- Karta profilu -->
            <div class="profile-card">
                @if (avatarUrl is not null)
                {
                    <img class="avatar-upload-preview" src="@avatarUrl" alt="Zdjęcie profilowe" />
                }
                else
                {
                    <span class="avatar avatar-lg">@Initials</span>
                }

                <div class="profile-info">
                    <h2>@Username</h2>
                    @if (!string.IsNullOrEmpty(profile?.City))
                    {
                        <p class="profile-email">Lokalizacja: @profile.City</p>
                    }
                    @if (!string.IsNullOrEmpty(profile?.Bio))
                    {
                        <p class="profile-bio">@profile.Bio</p>
                    }
                    <p class="home-card-verified">✔ E-mail zweryfikowany</p>
                    <p class="profile-rating">★ 4,8 <span>(12 opinii)</span></p>
                </div>

                @if (isOwner)
                {
                    <a class="home-btn home-btn-outline" href="/ustawienia">Edytuj profil</a>
                }
            </div>

            @if (isOwner)
            {
                <section class="profile-notifications" aria-labelledby="notifications-title">
                    <h2 id="notifications-title" class="home-section-title">
                        Powiadomienia
                        @if (UnreadNotificationsCount > 0)
                        {
                            <span class="profile-notification-count">@UnreadNotificationsCount nowych</span>
                        }
                    </h2>
                    <button class="home-btn home-btn-outline" type="button"
                            @onclick="async () => notifications = await notificationApi.GetNotificationsAsync()">
                        Odśwież powiadomienia
                    </button>

                    @if (notifications.Count == 0)
                    {
                        <p class="profile-notifications-empty">Nie masz jeszcze powiadomień.</p>
                    }
                    else
                    {
                        <div class="profile-notification-list">
                            @foreach (var notification in notifications)
                            {
                                <article class="profile-notification @(notification.IsRead ? "is-read" : "is-unread")">
                                    <div>
                                        <h3>@notification.Title</h3>
                                        <p>@notification.Message</p>
                                        <time datetime="@notification.CreatedAt.ToString("O")">
                                            @notification.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        </time>
                                    </div>
                                    <div class="profile-notification-actions">
                                        @if (notification.Type == ReShareBlazorApp.Shared.Enums.NotificationType.NewMessage)
                                        {
                                            <a class="home-btn home-btn-outline" href="/wiadomosci">Przejdź do wiadomości</a>
                                        }
                                        @if (notification.ProductId is int productId)
                                        {
                                            <a class="home-btn home-btn-outline" href="@GetProductUrl(productId)">Zobacz ofertę</a>
                                        }
                                        @if (!notification.IsRead)
                                        {
                                            <button class="home-btn home-btn-outline" type="button"
                                                    @onclick="() => MarkNotificationAsReadAsync(notification)">
                                                Oznacz jako przeczytane
                                            </button>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>
            }

            <!-- Statystyki -->
            <div class="profile-stats">
                <div class="profile-stat"><strong>5</strong><span>Ogłoszenia</span></div>
                <div class="profile-stat"><strong>2</strong><span>Poszukiwania</span></div>
                <div class="profile-stat"><strong>9</strong><span>Transakcje</span></div>
                <div class="profile-stat"><strong>14</strong><span>Ulubione</span></div>
            </div>

            <!-- Zakładki -->
            <div class="profile-tabs" role="tablist">
                <button class="profile-tab active" type="button" role="tab">Moje ogłoszenia</button>
                <button class="profile-tab" type="button" role="tab">Moje poszukiwania</button>
                <button class="profile-tab" type="button" role="tab">Ulubione</button>
                <button class="profile-tab" type="button" role="tab">Transakcje</button>
                <button class="profile-tab" type="button" role="tab">Opinie</button>
            </div>

            <!-- Moje ogłoszenia -->
            @* <div class="home-cards">
            <ListingCard Title="2 bilety na koncert – Kraków" Category="Bilety i rezerwacje" Type="Sprzedam"
                         Price="240 zł" Location="Kraków" Term="12.12.2026" Published="08.11.2026" />
            <ListingCard Title="Wózek dziecięcy do oddania" Category="Rodzina i dzieci" Type="Oddam"
                         Price="Bezpłatnie" Location="Łódź" Term="od zaraz" Published="07.11.2026" />
        </div> *@

            <!-- Opinie -->
            <h2 class="home-section-title profile-subtitle">Opinie o Tobie</h2>
            <div class="profile-reviews">
                <article class="profile-review">
                    <p class="profile-rating">★★★★★ <span>Anna K.</span></p>
                    <p>Szybki kontakt, wszystko zgodnie z opisem. Polecam.</p>
                </article>
                <article class="profile-review">
                    <p class="profile-rating">★★★★☆ <span>Marek N.</span></p>
                    <p>Sprawna wymiana, drobne opóźnienie w odpowiedzi.</p>
                </article>
            </div>
        </div>
    </section>
}
else
{
    <h4>Nie znaleziono użytkownika!</h4>
}


@code {
    [Parameter]
    public string Username { get; set; } = string.Empty;
    private bool exist;
    private UserProfileDTO? profile;
    private string? avatarUrl;
    private string Initials => string.IsNullOrWhiteSpace(Username)
        ? "?" : Username[..Math.Min(2, Username.Length)].ToUpper();
    private bool isOwner;
    private List<NotificationDTO> notifications = new();
    private int UnreadNotificationsCount => notifications.Count(notification => !notification.IsRead);

    protected override async Task OnParametersSetAsync()
    {
        profile = await userApi.GetProfileAsync(Username);
        exist = profile != null;
        avatarUrl = userApi.GetAvatarUrl(profile?.AvatarUrl);
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        isOwner = string.Equals(state.User.FindFirst(ClaimTypes.Name)?.Value, Username, StringComparison.OrdinalIgnoreCase);
        notifications = isOwner
            ? await notificationApi.GetNotificationsAsync()
            : new List<NotificationDTO>();
    }

    private async Task MarkNotificationAsReadAsync(NotificationDTO notification)
    {
        if (await notificationApi.MarkAsReadAsync(notification.Id))
            notification.IsRead = true;
    }

    private static string GetProductUrl(int productId) => $"/details/{productId}";
}   