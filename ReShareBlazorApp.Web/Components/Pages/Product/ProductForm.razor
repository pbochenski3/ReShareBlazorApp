@page "/add-product"
@page "/edit-product/{ProductId:int}"
@inject NavigationManager Navigation
@rendermode InteractiveServer
@using ReShareBlazorApp.Api.Date.Enums
@using ReShareBlazorApp.Shared.Enums
@using ReShareBlazorApp.Web.ApiServices
@using ReShareBlazorApp.Web.Models
@using ReShareBlazorApp.Shared.DTOs
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@inject ProductApiService productService
@inject NotificationService notify
@if(isSelected)
{
<EditForm Model="@productModel" OnValidSubmit="SaveProduct">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="product-page">
            <div class="product-form">
        <button type="button" class="product-back" @onclick="() => isSelected = false">
            ← Wróć do wyboru
        </button>
                <div class="product-header">
                    @if (productModel.Type == ProductType.Sell)
                    {
                        <h2>@(IsEditMode ? "Edytuj produkt" : "Dodaj produkt")</h2>
                        <p>@(IsEditMode ? "Zaktualizuj dane swojego ogłoszenia." : "Udostępnij produkt, który chcesz sprzedać.")</p>
                    }
                    else if (productModel.Type == ProductType.GiveAway)
                    {
                        <h2>@(IsEditMode ? "Edytuj ogłoszenie" : "Oddaj produkt")</h2>
                        <p>@(IsEditMode ? "Zaktualizuj dane swojego ogłoszenia." : "Udostępnij produkt, który chcesz oddać za darmo.")</p>
                    }
                    else if (productModel.Type == ProductType.LookingFor)
                    {
                        <h2>@(IsEditMode ? "Edytuj ogłoszenie" : "Szukam produktu")</h2>
                        <p>@(IsEditMode ? "Zaktualizuj dane swojego ogłoszenia." : "Opublikuj ogłoszenie i znajdź produkt, którego szukasz.")</p>
                    }
                </div>

            <div class="product-field">
                <label>Nazwa produktu</label>
                <InputText @bind-Value="productModel.Name"
                           class="product-input"
                           placeholder="Wpisz nazwę produktu" />
                <ValidationMessage For="@(() => productModel.Name)" />
            </div>

            <div class="product-field">
                <label>Cena</label>
                <InputNumber @bind-Value="productModel.Price"
                             class="product-input"
                             placeholder="Wpisz cenę produktu" />
                <ValidationMessage For="@(() => productModel.Price)" />
            </div>

            <div class="product-field">
                <label>Opis</label>
                <InputTextArea @bind-Value="productModel.Description"
                               class="product-input"
                               placeholder="Wpisz opis produktu" />
                <ValidationMessage For="@(() => productModel.Description)" />
            </div>

            <div class="product-field">
                <label>Data ważności</label>
                <InputDate @bind-Value="productModel.ExpiresAt"
                           class="product-input" />
                <ValidationMessage For="@(() => productModel.ExpiresAt)" />
            </div>

            <div class="product-field">
                <label>Miejscowość</label>
                <label class="product-input">
                    @(string.IsNullOrEmpty(productModel.City)
                        ? "Pobieranie miejscowości..."
                        : productModel.City)
                </label>
                <ValidationMessage For="@(() => productModel.City)" />
            </div>

            <div class="product-field">
                <label>Kategoria produktu</label>
                <InputSelect @bind-Value="productModel.Category"
                             class="product-input">
                    <option value="">Wybierz kategorię</option>
                    @foreach (var category in Enum.GetValues<ProductCategory>())
                    {
                        <option value="@category">@GetCategoryName(category)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => productModel.Category)" />
            </div>

            <button type="submit" class="product-submit">
                @(IsEditMode ? "Zapisz zmiany" : "Dodaj produkt")
            </button>
        </div>
    </div>
</EditForm>
}
else
{
    <div class="type-selection">
        <div class="type-selection-header">
            <span class="type-selection-label">NOWE OGŁOSZENIE</span>
            <h1>Jakiego typu ogłoszenie chcesz dodać?</h1>
            <p>Wybierz jedną z poniższych opcji, aby przejść dalej.</p>
        </div>

        <div class="type-selection-options">
            <button type="button" @onclick="() => ChooseType(ProductType.Sell)" class="type-option sell">
                <span class="type-icon">💰</span>
                <span class="type-content">
                    <strong>Sprzedam</strong>
                    <small>Wystaw produkt na sprzedaż i znajdź kupca.</small>
                </span>
                <span class="type-arrow">→</span>
            </button>

            <button type="button" @onclick="() => ChooseType(ProductType.GiveAway)" class="type-option giveaway">
                <span class="type-icon">🎁</span>
                <span class="type-content">
                    <strong>Oddam</strong>
                    <small>Podaruj komuś coś, czego już nie potrzebujesz.</small>
                </span>
                <span class="type-arrow">→</span>
            </button>

            <button type="button" @onclick="() => ChooseType(ProductType.LookingFor)" class="type-option looking">
                <span class="type-icon">🔎</span>
                <span class="type-content">
                    <strong>Szukam</strong>
                    <small>Opublikuj ogłoszenie i znajdź to, czego potrzebujesz.</small>
                </span>
                <span class="type-arrow">→</span>
            </button>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool isSelected { get; set; }
    [Parameter]
    public int? ProductId { get; set; }

    public ProductModel productModel { get; set; } = new();

    private bool IsEditMode => ProductId.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        if (!ProductId.HasValue)
            return;

        var product = await productService.GetProductByIdAsync(ProductId.Value);
        productModel = new ProductModel
        {
            Name = product.Name,
            Description = product.Description,
            Price = product.Price,
            ExpiresAt = product.ExpiresAt,
            Category = product.Category,
            City = product.City,
            Type = product.Type,
            UserId = product.UserId
        };
        isSelected = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !IsEditMode)
        {
            try
            {
                var location = await JS.InvokeAsync<LocationResult>("getUserLocation");

                productModel.City = await GetCityAsync(
                    location.Latitude,
                    location.Longitude
                );

                StateHasChanged();
            }
            catch
            {
                notify.AddNotification("Lokalizacja", "Nie udało się pobrać lokalizacji.");
            }
        }
    }
    public async Task SaveProduct()
    {
        if (IsEditMode)
        {
            var result = await productService.UpdateProductAsync(ProductId!.Value, productModel);
            notify.AddNotification("Ogłoszenie", result);

            if (result == "Ogłoszenie zostało zaktualizowane!")
                Navigation.NavigateTo($"/details/{ProductId.Value}");

            return;
        }

        var addResult = await productService.AddProductAsync(productModel);
        notify.AddNotification("Ogłoszenie", addResult);
        productModel = new ProductModel();
        isSelected = false;
    }
    private void ChooseType(ProductType type)
    {
        productModel.Type = type;
        isSelected = true;
        StateHasChanged();
    }
    private string GetCategoryName(ProductCategory category)
    {
        return category switch
        {
            ProductCategory.Tickets => "Bilety",
            ProductCategory.Reservations => "Rezerwacje",
            ProductCategory.Trips => "Wyjazdy i podróże",
            ProductCategory.Transports => "Transport",
            ProductCategory.Services => "Usługi",
            _ => category.ToString()
        };
    }
    private async Task<string> GetCityAsync(double latitude, double longitude)
    {
        using var http = HttpClientFactory.CreateClient();

        http.DefaultRequestHeaders.UserAgent.ParseAdd("ReShareBlazorApp/1.0");

        var url = $"https://nominatim.openstreetmap.org/reverse?lat={latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)}&lon={longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)}&format=jsonv2&addressdetails=1";

        var response = await http.GetStringAsync(url);

        using var json = System.Text.Json.JsonDocument.Parse(response);

        var address = json.RootElement.GetProperty("address");

        foreach (var field in new[] { "city", "town", "village", "hamlet" })
        {
            if (address.TryGetProperty(field, out var value))
                return value.GetString() ?? "";
        }

        return "";
    }
}
