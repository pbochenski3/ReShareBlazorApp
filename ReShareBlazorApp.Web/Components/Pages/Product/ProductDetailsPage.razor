    private async Task SubmitReview()
    {
        errorMessage = null;

        if (!isAuthenticated)
        {
            errorMessage = "Musisz być zalogowany, aby dodać opinię.";
            return;
        }

        if (Product == null)
            return;

        if (IsOwner)
        {
            errorMessage = "Nie możesz dodać opinii do własnego ogłoszenia.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newComment))
        {
            errorMessage = "Wpisz treść opinii przed zapisaniem.";
            return;
        }

        if (newRating < 1 || newRating > 5)
        {
            errorMessage = "Ocena musi być w zakresie od 1 do 5.";
            return;
        }

        isSubmitting = true;

        try
        {
            var author = !string.IsNullOrWhiteSpace(currentUserName)
                ? currentUserName
                : "Anonim";

            var request = new CreateReviewRequest
            {
                ProductId = ProductId,
                AuthorName = author,
                Rating = newRating,
                Comment = newComment.Trim()
            };

            var success = await ReviewApiService.AddReviewAsync(request);

            if (success)
            {
                newComment = "";
                newRating = 5;
                showAddForm = false;

                await LoadReviews();
            }
            else
            {
                errorMessage = "Nie udało się zapisać opinii. Sprawdź, czy sesja logowania jest aktywna w API.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Wystąpił błąd podczas dodawania opinii: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ToggleFollowUser()
    {
        followMessage = null;

        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (Product == null)
            return;

        if (IsOwner)
        {
            followMessage = "Nie możesz obserwować samego siebie.";
            return;
        }

        if (isFollowLoading)
            return;

        isFollowLoading = true;

        try
        {
            using var request = await CreateAuthorizedRequest(
                HttpMethod.Post,
                $"api/users/{Product.UserId}/toggle-follow");

            using var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ToggleResult>();

                if (result != null)
                {
                    isFollowing = result.IsFollowing;
                }
                else
                {
                    followMessage = "Nie udało się odczytać odpowiedzi serwera.";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                followMessage = "Nie udało się zmienić obserwowania. Spróbuj ponownie.";
            }
        }
        catch (Exception ex)
        {
            followMessage = $"Błąd połączenia z API: {ex.Message}";
        }
        finally
        {
            isFollowLoading = false;
        }
    }

