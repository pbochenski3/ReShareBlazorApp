@page "/details/{ProductId:int}"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Web.ApiServices
@inject ProductApiService productApi
@inject ReviewApiService ReviewApiService
@inject AuthenticationStateProvider AuthStateProvider

<div class="details-page">
    <div class="details-container">

        <a href="/" class="details-back">
            <span>←</span> Wróć do ogłoszeń
        </a>

        @if (IsLoading)
        {
            <div class="details-state">
                <div class="details-loader"></div>
                <p>Ładowanie ogłoszenia...</p>
            </div>
        }
        else if (Product == null)
        {
            <div class="details-state">
                <div class="details-empty-icon">!</div>
                <h2>Nie znaleziono ogłoszenia</h2>
                <p>Ogłoszenie mogło zostać usunięte lub nie istnieje.</p>
                <a href="/" class="details-primary-button">Wróć na stronę główną</a>
            </div>
        }
        else
        {
            <div class="details-layout">

                <main class="details-main">

                    <div class="details-category">
                        @Product.Category
                    </div>

                    <h1 class="details-title">
                        @Product.Name
                    </h1>

                    <div class="details-location">
                        <span>📍</span>
                        @Product.City
                    </div>

                    <section class="details-section">
                        <h2>Opis ogłoszenia</h2>

                        <p class="details-description">
                            @if (string.IsNullOrWhiteSpace(Product.Description))
                            {
                                <span>Brak opisu ogłoszenia.</span>
                            }
                            else
                            {
                                @Product.Description
                            }
                        </p>
                    </section>

                    <section class="details-section">
                        <h2>Informacje o ogłoszeniu</h2>

                        <div class="details-info-grid">
                            <div class="details-info-item">
                                <span class="details-info-label">Data dodania</span>
                                <strong>@Product.AddedAt.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>

                            <div class="details-info-item">
                                <span class="details-info-label">Wygasa</span>
                                <strong>@Product.ExpiresAt.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>
                        </div>
                    </section>

                    <!-- SEKCJA OPINII DO OGŁOSZENIA -->
                    <section class="details-section mt-5 pt-4 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                            <div>
                                <h3 class="fw-bold text-dark m-0">Opinie o ogłoszeniu</h3>
                                <div class="text-warning fw-bold mt-1">
                                    <span>★</span>
                                    <span>@AverageRating.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                                    <span class="text-muted fw-normal ms-1">(@TotalReviews opinii)</span>
                                </div>
                            </div>

                            @if (!isAuthenticated)
                            {
                                <a href="/login" class="btn btn-sm rounded-pill px-4 py-2 fw-semibold shadow-sm text-white" style="background-color: #0f766e;">
                                    Zaloguj się, aby dodać opinię
                                </a>
                            }
                            else if (IsOwner)
                            {
                                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                                    To Twoje ogłoszenie – nie możesz go oceniać
                                </span>
                            }
                            else
                            {
                                <button class="btn btn-sm rounded-pill px-4 py-2 fw-semibold shadow-sm text-white" @onclick="ToggleForm" style="background-color: #0f766e;">
                                    @(showAddForm ? "Anuluj" : "+ Dodaj opinię")
                                </button>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert alert-danger rounded-3 py-2 px-3 mb-3">
                                @errorMessage
                            </div>
                        }

                        <!-- Formularz dodawania opinii -->
                        @if (showAddForm && isAuthenticated && !IsOwner)
                        {
                            <div class="card border-0 shadow-sm p-4 mb-4 rounded-4 bg-white" style="border-left: 4px solid #0f766e !important;">
                                <h5 class="fw-bold mb-3 text-dark">Wystaw opinię do tego ogłoszenia</h5>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">Twoje imię / nazwa:</label>
                                    <input type="text"
                                           class="form-control rounded-3 bg-light"
                                           value="@(currentUserName ?? "Anonim")"
                                           readonly />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">Ocena (gwiazdki):</label>
                                    <select class="form-select rounded-3" @bind="newRating">
                                        <option value="5">★★★★★ (5/5)</option>
                                        <option value="4">★★★★☆ (4/5)</option>
                                        <option value="3">★★★☆☆ (3/5)</option>
                                        <option value="2">★★☆☆☆ (2/5)</option>
                                        <option value="1">★☆☆☆☆ (1/5)</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">Treść opinii / komentarz:</label>
                                    <textarea class="form-control rounded-3" rows="3" @bind="newComment" placeholder="Napisz kilka słów o przedmiocie lub transakcji..."></textarea>
                                </div>
                                <button class="btn px-4 rounded-pill fw-semibold text-white"
                                        disabled="@isSubmitting"
                                        @onclick="SubmitReview"
                                        style="background-color: #0f766e;">
                                    @(isSubmitting ? "Zapisywanie..." : "Zapisz opinię")
                                </button>
                            </div>
                        }

                        <!-- Lista opinii -->
                        @if (reviews == null)
                        {
                            <div class="text-muted py-3">Ładowanie opinii...</div>
                        }
                        else if (!reviews.Any())
                        {
                            <div class="card border-0 shadow-sm p-4 rounded-4 text-center text-muted bg-white">
                                Brak opinii dla tego ogłoszenia. @((!isAuthenticated || IsOwner) ? "" : "Bądź pierwszy i oceń ten przedmiot!")
                            </div>
                        }
                        else
                        {
                            <div class="row g-4">
                                @foreach (var review in reviews)
                                {
                                    <div class="col-md-6">
                                        <div class="card border-0 shadow-sm p-4 rounded-4 h-100 bg-white">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="text-warning fs-6" style="letter-spacing: 2px;">
                                                    @((MarkupString)GetStarsHtml(review.Rating))
                                                </div>
                                                <span class="fw-bold text-dark">@review.AuthorName</span>
                                            </div>
                                            <p class="text-secondary mb-0" style="font-size: 0.95rem; line-height: 1.5;">@review.Comment</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                </main>

                <aside class="details-sidebar">

                    <div class="details-price-card">
                        <span class="details-price-label">Cena</span>

                        <div class="details-price">
                            @Product.Price.ToString("N2") <span>zł</span>
                        </div>

                        <div class="details-divider"></div>

                        <h3>Informacje o wystawiającym</h3>

                        <div class="details-user">
                            <div class="details-user-avatar">
                                @(string.IsNullOrWhiteSpace(Product.AddedBy)
                                    ? "?"
                                    : Product.AddedBy.Substring(0, 1).ToUpper())
                            </div>

                            <div class="details-user-info">
                                <strong>
                                    @(string.IsNullOrWhiteSpace(Product.AddedBy)
                                        ? "Użytkownik"
                                        : Product.AddedBy)
                                </strong>
                                <span>Wystawiający ogłoszenie</span>
                            </div>
                        </div>

                        <div class="details-user-id">
                            ID użytkownika: @Product.UserId
                        </div>

                        <a href="/" class="details-primary-button">
                            Przeglądaj inne ogłoszenia
                        </a>
                    </div>

                    <div class="details-safety">
                        <span>🛡️</span>
                        <div>
                            <strong>Zachowaj ostrożność</strong>
                            <p>Przed dokonaniem transakcji upewnij się, że wszystkie szczegóły są jasne.</p>
                        </div>
                    </div>

                </aside>

            </div>
        }

    </div>
</div>

@code {
    [Parameter]
    public int ProductId { get; set; }

    public ProductDTO? Product { get; set; }
    public bool IsLoading { get; set; } = true;

    private bool isAuthenticated = false;
    private string? currentUserName;
    private string? errorMessage;
    private bool isSubmitting = false;

    private bool IsOwner
    {
        get
        {
            if (!isAuthenticated || Product == null) return false;

            return !string.IsNullOrEmpty(currentUserName) &&
                   !string.IsNullOrEmpty(Product.AddedBy) &&
                   string.Equals(currentUserName, Product.AddedBy, StringComparison.OrdinalIgnoreCase);
        }
    }

    private List<ReviewDTO>? reviews;
    private bool showAddForm = false;
    private int newRating = 5;
    private string newComment = "";

    private double AverageRating => (reviews != null && reviews.Any()) ? reviews.Average(r => (double)r.Rating) : 0.0;
    private int TotalReviews => reviews != null ? reviews.Count : 0;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        showAddForm = false;
        errorMessage = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated == true;
        currentUserName = isAuthenticated ? user.Identity?.Name : null;

        Product = await productApi.GetProductByIdAsync(ProductId);
        if (Product != null)
        {
            await LoadReviews();
        }

        IsLoading = false;
    }

    private async Task LoadReviews()
    {
        reviews = await ReviewApiService.GetReviewsForProductAsync(ProductId);
    }

    private void ToggleForm()
    {
        errorMessage = null;
        if (!isAuthenticated || IsOwner) return;
        showAddForm = !showAddForm;
    }

    private async Task SubmitReview()
    {
        errorMessage = null;

        if (!isAuthenticated)
        {
            errorMessage = "Musisz być zalogowany, aby dodać opinię.";
            return;
        }

        if (IsOwner)
        {
            errorMessage = "Nie możesz dodać opinii do własnego ogłoszenia.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newComment))
        {
            errorMessage = "Wpisz treść opinii przed zapisaniem.";
            return;
        }

        isSubmitting = true;
        try
        {
            var author = !string.IsNullOrWhiteSpace(currentUserName) ? currentUserName : "Anonim";

            var request = new CreateReviewRequest
            {
                ProductId = ProductId,
                AuthorName = author,
                Rating = newRating,
                Comment = newComment
            };

            var success = await ReviewApiService.AddReviewAsync(request);
            if (success)
            {
                newComment = "";
                newRating = 5;
                showAddForm = false;
                await LoadReviews();
            }
            else
            {
                errorMessage = "Nie udało się zapisać opinii. Sprawdź, czy sesja logowania jest aktywna w API.";
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string GetStarsHtml(int rating)
    {
        string stars = "";
        for (int i = 1; i <= 5; i++)
        {
            stars += i <= rating ? "★" : "☆";
        }
        return stars;
    }
}