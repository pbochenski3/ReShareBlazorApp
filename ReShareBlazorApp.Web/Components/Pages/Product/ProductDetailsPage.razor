@page "/details/{ProductId:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Shared.Enums
@using ReShareBlazorApp.Web.ApiServices
@using ReShareBlazorApp.Web.Models
@inject ProductApiService productApi
@inject ReportApiService reportApi
@inject NotificationService notify

<div class="details-page">
    <div class="details-container">

        <a href="/" class="details-back">
            <span>←</span> Wróć do ogłoszeń
        </a>

        @if (IsLoading)
        {
            <div class="details-state">
                <div class="details-loader"></div>
                <p>Ładowanie ogłoszenia...</p>
            </div>
        }
        else if (Product == null)
        {
            <div class="details-state">
                <div class="details-empty-icon">!</div>
                <h2>Nie znaleziono ogłoszenia</h2>
                <p>Ogłoszenie mogło zostać usunięte lub nie istnieje.</p>
                <a href="/" class="details-primary-button">Wróć na stronę główną</a>
            </div>
        }
        else
        {
            <div class="details-layout">

                <main class="details-main">

                    <div class="details-category">
                        @Product.Category
                    </div>

                    <h1 class="details-title">
                        @Product.Name
                    </h1>

                    <div class="details-location">
                        <span>📍</span>
                        @Product.City
                    </div>

                    <section class="details-section">
                        <h2>Opis ogłoszenia</h2>

                        <p class="details-description">
                            @if (string.IsNullOrWhiteSpace(Product.Description))
                            {
                                <span>Brak opisu ogłoszenia.</span>
                            }
                            else
                            {
                                @Product.Description
                            }
                        </p>
                    </section>

                    <section class="details-section">
                        <h2>Informacje o ogłoszeniu</h2>

                        <div class="details-info-grid">
                            <div class="details-info-item">
                                <span class="details-info-label">Data dodania</span>
                                <strong>@Product.AddedAt.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>

                            <div class="details-info-item">
                                <span class="details-info-label">Wygasa</span>
                                <strong>@Product.ExpiresAt.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>
                        </div>
                    </section>

                </main>

                <aside class="details-sidebar">

                    <div class="details-price-card">
                        <span class="details-price-label">Cena</span>

                        <div class="details-price">
                            @Product.Price.ToString("N2") <span>zł</span>
                        </div>

                        <div class="details-divider"></div>

                        <h3>Informacje o wystawiającym</h3>

                        <div class="details-user">
                            <div class="details-user-avatar">
                                @(string.IsNullOrWhiteSpace(Product.AddedBy)
                                    ? "?"
                                    : Product.AddedBy.Substring(0, 1).ToUpper())
                            </div>

                            <div class="details-user-info">
                                <strong>
                                    @(string.IsNullOrWhiteSpace(Product.AddedBy)
                                        ? "Użytkownik"
                                        : Product.AddedBy)
                                </strong>
                                <span>Wystawiający ogłoszenie</span>
                            </div>
                        </div>

                        <div class="details-user-id">
                            ID użytkownika: @Product.UserId
                        </div>

                        <a href="/" class="details-primary-button">
                            Przeglądaj inne ogłoszenia
                        </a>
                    </div>

                    <AuthorizeView>
                        <Authorized Context="auth">
                            <div class="details-report">
                                @if (!isReporting)
                                {
                                    <button type="button"
                                            class="details-report-toggle"
                                            @onclick="() => isReporting = true">
                                        🚩 Zgłoś ogłoszenie
                                    </button>
                                }
                                else
                                {
                                    <EditForm Model="@reportModel" OnValidSubmit="SendReport">
                                        <DataAnnotationsValidator />

                                        <h3>Zgłoś ogłoszenie</h3>

                                        <div class="details-report-field">
                                            <label>Kategoria zgłoszenia</label>
                                            <InputSelect @bind-Value="reportModel.Category"
                                                         class="details-report-input">
                                                <option value="">Wybierz kategorię</option>
                                                @foreach (var category in Enum.GetValues<ReportCategory>())
                                                {
                                                    <option value="@category">@GetReportCategoryName(category)</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="@(() => reportModel.Category)" />
                                        </div>

                                        <div class="details-report-field">
                                            <label>Treść zgłoszenia</label>
                                            <InputTextArea @bind-Value="reportModel.Description"
                                                           class="details-report-input"
                                                           placeholder="Opisz, co jest nie tak z tym ogłoszeniem" />
                                            <ValidationMessage For="@(() => reportModel.Description)" />
                                        </div>

                                        <div class="details-report-actions">
                                            <button type="submit"
                                                    class="details-report-submit"
                                                    disabled="@isSendingReport">
                                                Wyślij zgłoszenie
                                            </button>
                                            <button type="button"
                                                    class="details-report-cancel"
                                                    @onclick="CancelReport">
                                                Anuluj
                                            </button>
                                        </div>
                                    </EditForm>
                                }
                            </div>
                        </Authorized>
                    </AuthorizeView>

                    <div class="details-safety">
                        <span>🛡️</span>
                        <div>
                            <strong>Zachowaj ostrożność</strong>
                            <p>Przed dokonaniem transakcji upewnij się, że wszystkie szczegóły są jasne.</p>
                        </div>
                    </div>

                </aside>

            </div>
        }

    </div>
</div>

@code {
    [Parameter]
    public int ProductId { get; set; }

    public ProductDTO? Product { get; set; }

    public bool IsLoading { get; set; } = true;

    private bool isReporting;
    private bool isSendingReport;
    private ReportModel reportModel = new();

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        isReporting = false;
        reportModel = new ReportModel();

        Product = await productApi.GetProductByIdAsync(ProductId);

        IsLoading = false;
    }

    private async Task SendReport()
    {
        isSendingReport = true;
        var result = await reportApi.AddReportAsync(ProductId, reportModel);
        isSendingReport = false;

        if (result)
        {
            notify.AddNotification("Zgłoszenie", "Dziękujemy! Zgłoszenie zostało wysłane.");
            reportModel = new ReportModel();
            isReporting = false;
        }
        else
        {
            notify.AddNotification("Zgłoszenie", "Nie udało się wysłać zgłoszenia.");
        }
    }

    private void CancelReport()
    {
        reportModel = new ReportModel();
        isReporting = false;
    }

    private string GetReportCategoryName(ReportCategory category)
    {
        return category switch
        {
            ReportCategory.Spam => "Spam lub reklama",
            ReportCategory.Fraud => "Oszustwo",
            ReportCategory.Inappropriate => "Nieodpowiednia treść",
            ReportCategory.Prohibited => "Zabroniony przedmiot lub usługa",
            ReportCategory.Duplicate => "Duplikat ogłoszenia",
            ReportCategory.Other => "Inne",
            _ => category.ToString()
        };
    }
}
