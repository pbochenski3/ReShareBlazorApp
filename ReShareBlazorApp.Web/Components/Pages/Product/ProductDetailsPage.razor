@page "/details/{ProductId:int}"
@using System.Net.Http.Headers
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Shared.Enums
@using ReShareBlazorApp.Web.ApiServices
@using ReShareBlazorApp.Web.Models
@inject ProductApiService productApi
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ReviewApiService ReviewApiService
@inject AuthenticationStateProvider AuthStateProvider
@inject ReportApiService reportApi
@inject NotificationService notify
@inject RecentlyViewedApiService RecentlyViewedApi

<div class="details-page">
    <div class="details-container">

        <a href="/" class="details-back">
            <span>←</span> Wróć do ogłoszeń
        </a>

        @if (IsLoading)
        {
            <div class="details-state">
                <div class="details-loader"></div>
                <p>Ładowanie ogłoszenia...</p>
            </div>
        }
        else if (Product == null)
        {
            <div class="details-state">
                <div class="details-empty-icon">!</div>
                <h2>Nie znaleziono ogłoszenia</h2>
                <p>Ogłoszenie mogło zostać usunięte lub nie istnieje.</p>
                <a href="/" class="details-primary-button">
                    Wróć na stronę główną
                </a>
            </div>
        }
        else
        {
            <div class="details-layout">

                <main class="details-main">

                    @if (Product.ImageIds.Count > 0)
                    {
                        <div class="details-gallery">
                            <div class="details-gallery-main">
                                <img src="@GetImageUrl(Product.ImageIds[selectedImageIndex])" alt="@Product.Name" />
                            </div>

                            @if (Product.ImageIds.Count > 1)
                            {
                                <div class="details-gallery-thumbs">
                                    @for (var i = 0; i < Product.ImageIds.Count; i++)
                                    {
                                        var index = i;
                                        <button type="button"
                                                class="details-gallery-thumb @(index == selectedImageIndex ? "active" : "")"
                                                aria-label="Pokaż zdjęcie @(index + 1)"
                                                @onclick="() => selectedImageIndex = index">
                                            <img src="@GetImageUrl(Product.ImageIds[index])" alt="Zdjęcie @(index + 1)" loading="lazy" />
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="details-category">
                        @Product.Category
                    </div>

                    <h1 class="details-title">
                        @Product.Name
                    </h1>

                    <div class="details-location">
                        <span>📍</span>
                        @Product.City
                    </div>

                    <section class="details-section">
                        <h2>Opis ogłoszenia</h2>

                        <p class="details-description">
                            @if (string.IsNullOrWhiteSpace(Product.Description))
                            {
                                <span>Brak opisu ogłoszenia.</span>
                            }

                            else
                            {
                                @Product.Description
                            }
                        </p>
                    </section>

                    <section class="details-section">
                        <h2>Informacje o ogłoszeniu</h2>

                        <div class="details-info-grid">
                            <div class="details-info-item">
                                <span class="details-info-label">Data dodania</span>
                                <strong>@Product.AddedAt.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>

                            <div class="details-info-item">
                                <span class="details-info-label">Wygasa</span>
                                <strong>@Product.ExpiresAt.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>
                        </div>
                    </section>

                    <!-- SEKCJA OPINII DO OGŁOSZENIA -->
                    <section class="details-section mt-5 pt-4 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                            <div>
                                <h3 class="fw-bold text-dark m-0">Opinie o ogłoszeniu</h3>
                                <div class="text-warning fw-bold mt-1">
                                    <span>★</span>
                                    <span>@AverageRating.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                                    <span class="text-muted fw-normal ms-1">(@TotalReviews opinii)</span>
                                </div>
                            </div>

                            @if (IsOwner)
                            {
                                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                                    To Twoje ogłoszenie – nie możesz go oceniać
                                </span>
                            }
                            else
                            {
                                <button class="btn btn-sm rounded-pill px-4 py-2 fw-semibold shadow-sm text-white" @onclick="ToggleForm" style="background-color: #0f766e;">
                                    @(showAddForm ? "Anuluj" : "+ Dodaj opinię")
                                </button>
                            }
                        </div>

                        <!-- Formularz dodawania opinii -->
                        @if (showAddForm && !IsOwner)
                        {
                            <div class="card border-0 shadow-sm p-4 mb-4 rounded-4 bg-white" style="border-left: 4px solid #0f766e !important;">
                                <h5 class="fw-bold mb-3 text-dark">Wystaw opinię do tego ogłoszenia</h5>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">Twoje imię / nazwa:</label>
                                    <input type="text"
                                           class="form-control rounded-3 bg-light"
                                           value="@(currentUserName ?? "Anonim")"
                                           readonly />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">Ocena (gwiazdki):</label>
                                    <select class="form-select rounded-3" @bind="newRating">
                                        <option value="5">★★★★★ (5/5)</option>
                                        <option value="4">★★★★☆ (4/5)</option>
                                        <option value="3">★★★☆☆ (3/5)</option>
                                        <option value="2">★★☆☆☆ (2/5)</option>
                                        <option value="1">★☆☆☆☆ (1/5)</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">Treść opinii / komentarz:</label>
                                    <textarea class="form-control rounded-3" rows="3" @bind="newComment" placeholder="Napisz kilka słów o przedmiocie lub transakcji..."></textarea>
                                </div>
                                <button class="btn px-4 rounded-pill fw-semibold text-white" @onclick="SubmitReview" style="background-color: #0f766e;">Zapisz opinię</button>
                            </div>
                        }

                        <!-- Lista opinii -->
                        @if (reviews == null)
                        {
                            <div class="text-muted py-3">Ładowanie opinii...</div>
                        }
                        else if (!reviews.Any())
                        {
                            <div class="card border-0 shadow-sm p-4 rounded-4 text-center text-muted bg-white">
                                Brak opinii dla tego ogłoszenia. @(IsOwner ? "" : "Bądź pierwszy i oceń ten przedmiot!")
                            </div>
                        }
                        else
                        {
                            <div class="row g-4">
                                @foreach (var review in reviews)
                                {
                                    <div class="col-md-6">
                                        <div class="card border-0 shadow-sm p-4 rounded-4 h-100 bg-white">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="text-warning fs-6" style="letter-spacing: 2px;">
                                                    @((MarkupString)GetStarsHtml(review.Rating))
                                                </div>
                                                <span class="fw-bold text-dark">@review.AuthorName</span>
                                            </div>
                                            <p class="text-secondary mb-0" style="font-size: 0.95rem; line-height: 1.5;">@review.Comment</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                </main>

                <aside class="details-sidebar">

                    <div class="details-price-card">
                        <span class="details-price-label">Cena</span>

                        <div class="details-price">
                            @Product.Price.ToString("N2") <span>zł</span>
                        </div>

                        <div class="details-divider"></div>

                        <h3>Informacje o wystawiającym</h3>

                        <div class="details-user">
                            <div class="details-user-avatar">
                                @(string.IsNullOrWhiteSpace(Product.AddedBy)
                                    ? "?"
                                    : Product.AddedBy.Substring(0, 1).ToUpper())
                            </div>

                            <div class="details-user-info">
                                <strong>
                                    @(string.IsNullOrWhiteSpace(Product.AddedBy)
                                        ? "Użytkownik"
                                        : Product.AddedBy)
                                </strong>
                                <span>Wystawiający ogłoszenie</span>
                            </div>
                        </div>

                        <div class="details-user-id mb-3">
                            ID użytkownika: @Product.UserId
                        </div>

                        <button class="btn w-100 mb-2 @(isFollowing ? "btn-outline-secondary" : "btn-success")"
                                style="font-weight: 600; padding: 10px;"
                                @onclick="ToggleFollowUser">
                            @(isFollowing ? "✓ Obserwujesz" : "+ Obserwuj użytkownika")
                        </button>

                        @if (!string.IsNullOrWhiteSpace(followMessage))
                        {
                            <div class="small text-danger mb-3">@followMessage</div>
                        }

                        <a href="/" class="details-primary-button">
                            Przeglądaj inne ogłoszenia
                        </a>

                        @if (IsOwner)
                        {
                            <a href="/edit-product/@Product.ProductId" class="details-secondary-button d-block text-center mt-2">
                                Edytuj ogłoszenie
                            </a>
                            <button type="button" class="details-danger-button w-100 mt-2" @onclick="OpenDeleteDialog">
                                Usuń ogłoszenie
                            </button>
                        }
                    </div>

                    <AuthorizeView>
                        <Authorized Context="auth">
                            <div class="details-report">
                                @if (!isReporting)
                                {
                                    <button type="button"
                                            class="details-report-toggle"
                                            @onclick="() => isReporting = true">
                                        🚩 Zgłoś ogłoszenie
                                    </button>
                                }
                                else
                                {
                                    <EditForm Model="@reportModel" OnValidSubmit="SendReport">
                                        <DataAnnotationsValidator />

                                        <h3>Zgłoś ogłoszenie</h3>

                                        <div class="details-report-field">
                                            <label>Kategoria zgłoszenia</label>
                                            <InputSelect @bind-Value="reportModel.Category"
                                                         class="details-report-input">
                                                <option value="">Wybierz kategorię</option>
                                                @foreach (var category in Enum.GetValues<ReportCategory>())
                                                {
                                                    <option value="@category">@GetReportCategoryName(category)</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="@(() => reportModel.Category)" />
                                        </div>

                                        <div class="details-report-field">
                                            <label>Treść zgłoszenia</label>
                                            <InputTextArea @bind-Value="reportModel.Description"
                                                           class="details-report-input"
                                                           placeholder="Opisz, co jest nie tak z tym ogłoszeniem" />
                                            <ValidationMessage For="@(() => reportModel.Description)" />
                                        </div>

                                        <div class="details-report-actions">
                                            <button type="submit"
                                                    class="details-report-submit"
                                                    disabled="@isSendingReport">
                                                Wyślij zgłoszenie
                                            </button>
                                            <button type="button"
                                                    class="details-report-cancel"
                                                    @onclick="CancelReport">
                                                Anuluj
                                            </button>
                                        </div>
                                    </EditForm>
                                }
                            </div>
                        </Authorized>
                    </AuthorizeView>

                    <div class="details-safety">
                        <span>🛡️</span>
                        <div>
                            <strong>Zachowaj ostrożność</strong>
                            <p>Przed dokonaniem transakcji upewnij się, że wszystkie szczegóły są jasne.</p>
                        </div>
                    </div>

                </aside>

            </div>
        }

        @if (IsDeleteDialogVisible)
        {
            <div class="delete-dialog-backdrop">
                <div class="delete-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-dialog-title">
                    <div class="delete-dialog-icon">!</div>
                    <h2 id="delete-dialog-title">Usunąć ogłoszenie?</h2>
                    <p>Tej operacji nie można cofnąć. Ogłoszenie zostanie trwale usunięte.</p>

                    <div class="delete-dialog-actions">
                        <button type="button" class="delete-dialog-cancel" @onclick="CloseDeleteDialog" disabled="@IsDeleting">
                            Anuluj
                        </button>
                        <button type="button" class="delete-dialog-confirm" @onclick="ConfirmDeleteAsync" disabled="@IsDeleting">
                            @(IsDeleting ? "Usuwanie..." : "Usuń ogłoszenie")
                        </button>
                    </div>
                </div>
            </div>
        }

    </div>
</div>

@code {
    [Parameter]
    public int ProductId { get; set; }

    public ProductDTO? Product { get; set; }
    public bool IsLoading { get; set; } = true;
    private bool isFollowing = false;
    private string? followMessage;
    private bool IsDeleteDialogVisible { get; set; }
    private bool IsDeleting { get; set; }

    private string? currentUserName;
    private int? currentUserIdInt;

    private bool IsOwner
    {
        get
        {
            if (Product == null) return false;

            bool matchById = currentUserIdInt.HasValue && Product.UserId == currentUserIdInt.Value;
            bool matchByName = !string.IsNullOrEmpty(currentUserName) &&
                               !string.IsNullOrEmpty(Product.AddedBy) &&
                               string.Equals(currentUserName, Product.AddedBy, StringComparison.OrdinalIgnoreCase);

            return matchById || matchByName;
        }
    }

    private List<ReviewDTO>? reviews;
    private bool showAddForm = false;
    private int newRating = 5;
    private string newComment = "";

    private double AverageRating => (reviews != null && reviews.Any()) ? reviews.Average(r => (double)r.Rating) : 0.0;
    private int TotalReviews => reviews != null ? reviews.Count : 0;

    private int selectedImageIndex;

    private static string GetImageUrl(int imageId) => $"/images/{imageId}";

    private bool isReporting;
    private bool isSendingReport;
    private ReportModel reportModel = new();

    private int _lastRecordedProductId;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        selectedImageIndex = 0;
        isReporting = false;
        reportModel = new ReportModel();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserName = user.Identity.Name;

            var userIdClaim = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? user.FindFirst("nameid")?.Value;
            if (int.TryParse(userIdClaim, out var parsedId))
            {
                currentUserIdInt = parsedId;
            }
        }

        Product = await productApi.GetProductByIdAsync(ProductId);
        if (Product != null)
        {
            await LoadReviews();
            await CheckFollowStatus();
        }

        IsLoading = false;
    }

    private async Task<HttpRequestMessage> CreateAuthorizedRequest(HttpMethod method, string url)
    {
        var request = new HttpRequestMessage(method, url);

        try
        {
            var keys = new[] { "authToken", "token", "jwt", "jwtToken", "accessToken" };
            string? token = null;

            foreach (var key in keys)
            {
                token = await JS.InvokeAsync<string?>("localStorage.getItem", key)
                     ?? await JS.InvokeAsync<string?>("sessionStorage.getItem", key);

                if (!string.IsNullOrWhiteSpace(token))
                    break;
            }

            if (!string.IsNullOrWhiteSpace(token))
            {
                token = token.Trim('"');
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
        }
        catch
        {
            // Ignorujemy błędy JS przy prerenderze
        }

        return request;
    }

    private async Task CheckFollowStatus()
    {
        try
        {
            using var request = await CreateAuthorizedRequest(HttpMethod.Get, $"api/users/{Product!.UserId}/is-following");
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                isFollowing = await response.Content.ReadFromJsonAsync<bool>();
            }
        }
        catch
        {
            isFollowing = false;
        }
    }

    private async Task ToggleFollowUser()
    {
        followMessage = null;

        try
        {
            using var request = await CreateAuthorizedRequest(HttpMethod.Post, $"api/users/{Product!.UserId}/toggle-follow");
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ToggleResult>();
                if (result != null)
                {
                    isFollowing = result.IsFollowing;
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                Navigation.NavigateTo("/login");
            }
        }
        catch (Exception ex)
        {
            followMessage = $"Błąd połączenia z API: {ex.Message}";
        }
    }

    private async Task LoadReviews()
    {
        reviews = await ReviewApiService.GetReviewsForProductAsync(ProductId);
    }

    private void ToggleForm()
    {
        if (IsOwner) return;
        showAddForm = !showAddForm;
    }

    private async Task SubmitReview()
    {
        if (IsOwner || string.IsNullOrWhiteSpace(newComment)) return;

        var author = !string.IsNullOrWhiteSpace(currentUserName) ? currentUserName : "Anonim";

        var request = new CreateReviewRequest
        {
            ProductId = ProductId,
            AuthorName = author,
            Rating = newRating,
            Comment = newComment
        };

        var success = await ReviewApiService.AddReviewAsync(request);
        if (success)
        {
            newComment = "";
            newRating = 5;
            showAddForm = false;
            await LoadReviews();
        }
    }

    private string GetStarsHtml(int rating)
    {
        string stars = "";
        for (int i = 1; i <= 5; i++)
        {
            stars += i <= rating ? "★" : "☆";
        }
        return stars;
    }

    private void OpenDeleteDialog()
    {
        if (Product == null || !IsOwner)
            return;

        IsDeleteDialogVisible = true;
    }

    private void CloseDeleteDialog()
    {
        if (!IsDeleting)
            IsDeleteDialogVisible = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (Product == null || !IsOwner || IsDeleting)
            return;

        IsDeleting = true;

        var result = await productApi.DeleteProductAsync(Product.ProductId);
        notify.AddNotification("Ogłoszenie", result);

        if (result == "Ogłoszenie zostało usunięte!")
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            IsDeleting = false;
            IsDeleteDialogVisible = false;
        }
    }

    private async Task SendReport()
    {
        isSendingReport = true;
        var result = await reportApi.AddReportAsync(ProductId, reportModel);
        isSendingReport = false;

        if (result)
        {
            notify.AddNotification("Zgłoszenie", "Dziękujemy! Zgłoszenie zostało wysłane.");
            reportModel = new ReportModel();
            isReporting = false;
        }
        else
        {
            notify.AddNotification("Zgłoszenie", "Nie udało się wysłać zgłoszenia.");
        }
    }

    private void CancelReport()
    {
        reportModel = new ReportModel();
        isReporting = false;
    }

    private string GetReportCategoryName(ReportCategory category)
    {
        return category switch
        {
            ReportCategory.Spam => "Spam lub reklama",
            ReportCategory.Fraud => "Oszustwo",
            ReportCategory.Inappropriate => "Nieodpowiednia treść",
            ReportCategory.Prohibited => "Zabroniony przedmiot lub usługa",
            ReportCategory.Duplicate => "Duplikat ogłoszenia",
            ReportCategory.Other => "Inne",
            _ => category.ToString()
        };
    }

    private class ToggleResult
    {
        public bool IsFollowing { get; set; }
        public string Message { get; set; } = "";
    }
}