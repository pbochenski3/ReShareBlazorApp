@page "/details/{ProductId:int}"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Shared.Enums
@using ReShareBlazorApp.Web.ApiServices
@using ReShareBlazorApp.Web.Models

@inject AuthenticationStateProvider AuthStateProvider
@inject ProductApiService productApi
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ReviewApiService ReviewApiService
@inject RecentlyViewedApiService RecentlyViewedApiService
@inject ReportApiService ReportApiService
@inject NotificationService notify
@inject FavoritesState Favorites
@implements IDisposable

<div class="details-page">
    <div class="details-container">

        <a href="/" class="details-back">
            <span>←</span> Wróć do ogłoszeń
        </a>

        @if (IsLoading)
        {
            <div class="details-state">
                <div class="details-loader"></div>
                <p>Ładowanie ogłoszenia...</p>
            </div>
        }
        else if (Product == null)
        {
            <div class="details-state">
                <div class="details-empty-icon">!</div>
                <h2>Nie znaleziono ogłoszenia</h2>
                <p>Ogłoszenie mogło zostać usunięte lub nie istnieje.</p>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <p class="text-danger">@errorMessage</p>
                }

                <a href="/" class="details-primary-button">Wróć na stronę główną</a>
            </div>
        }
        else
        {
            <div class="details-layout">

                <main class="details-main">

                    <div class="details-category">
                        @Product.Category
                    </div>

                    <h1 class="details-title">
                        @Product.Name
                    </h1>

                    <div class="details-location">
                        <span>📍</span>
                        @Product.City
                    </div>

                    <section class="details-section">
                        <h2>Opis ogłoszenia</h2>

                        <p class="details-description">
                            @if (string.IsNullOrWhiteSpace(Product.Description))
                            {
                                <span>Brak opisu ogłoszenia.</span>
                            }
                            else
                            {
                                @Product.Description
                            }
                        </p>
                    </section>

                    <section class="details-section">
                        <h2>Informacje o ogłoszeniu</h2>

                        <div class="details-info-grid">
                            <div class="details-info-item">
                                <span class="details-info-label">Cena</span>
                                <strong>@Product.Price.ToString("0.##") zł</strong>
                            </div>
                            <div class="details-info-item">
                                <span class="details-info-label">Data dodania</span>
                                <strong>@Product.AddedAt.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>
                            <div class="details-info-item">
                                <span class="details-info-label">Stan produktu</span>
                                <strong>@GetConditionName(Product.Condition)</strong>
                            </div>
                            <div class="details-info-item">
                                <span class="details-info-label">Wygasa</span>
                                <strong>@Product.ExpiresAt.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>
                        </div>
                    </section>

                    <section class="details-section mt-5 pt-4 border-top">

                        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                            <div>
                                <h3 class="fw-bold text-dark m-0">Opinie o ogłoszeniu</h3>

                                <div class="text-warning fw-bold mt-1">
                                    <span>★</span>
                                    <span>@AverageRating.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                                    <span class="text-muted fw-normal ms-1">(@TotalReviews opinii)</span>
                                </div>
                            </div>

                            @if (!isAuthenticated)
                            {
                                <a href="/login"
                                   class="btn btn-sm rounded-pill px-4 py-2 fw-semibold shadow-sm text-white"
                                   style="background-color: #0f766e;">
                                    Zaloguj się, aby dodać opinię
                                </a>
                            }
                            else if (IsOwner)
                            {
                                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                                    To Twoje ogłoszenie – nie możesz go oceniać
                                </span>
                            }
                            else if (HasCurrentUserReview)
                            {
                                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                                    Wystawiłeś już opinię do tego ogłoszenia
                                </span>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-sm rounded-pill px-4 py-2 fw-semibold shadow-sm text-white"
                                        @onclick="ToggleForm"
                                        style="background-color: #0f766e;">
                                    @(showAddForm ? "Anuluj" : "+ Dodaj opinię")
                                </button>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert alert-danger rounded-3 py-2 px-3 mb-3">
                                @errorMessage
                            </div>
                        }

                        @if (showAddForm && isAuthenticated && !IsOwner && !HasCurrentUserReview)
                        {
                            <div class="card border-0 shadow-sm p-4 mb-4 rounded-4 bg-white"
                                 style="border-left: 4px solid #0f766e !important;">

                                <h5 class="fw-bold mb-3 text-dark">
                                    Wystaw opinię do tego ogłoszenia
                                </h5>

                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">
                                        Twoje imię / nazwa:
                                    </label>

                                    <input type="text"
                                           class="form-control rounded-3 bg-light"
                                           value="@(currentUserName ?? "Anonim")"
                                           readonly />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">
                                        Ocena (gwiazdki):
                                    </label>

                                    <select class="form-select rounded-3" @bind="newRating">
                                        <option value="5">★★★★★ (5/5)</option>
                                        <option value="4">★★★★☆ (4/5)</option>
                                        <option value="3">★★★☆☆ (3/5)</option>
                                        <option value="2">★★☆☆☆ (2/5)</option>
                                        <option value="1">★☆☆☆☆ (1/5)</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">
                                        Treść opinii / komentarz:
                                    </label>

                                    <textarea class="form-control rounded-3"
                                              rows="3"
                                              @bind="newComment"
                                              placeholder="Napisz kilka słów o przedmiocie lub transakcji..."></textarea>
                                </div>

                                <button type="button"
                                        class="btn px-4 rounded-pill fw-semibold text-white"
                                        disabled="@isSubmitting"
                                        @onclick="SubmitReview"
                                        style="background-color: #0f766e;">
                                    @(isSubmitting ? "Zapisywanie..." : "Zapisz opinię")
                                </button>
                            </div>
                        }

                        @if (reviews == null)
                        {
                            <div class="text-muted py-3">
                                Ładowanie opinii...
                            </div>
                        }
                        else if (!reviews.Any())
                        {
                            <div class="card border-0 shadow-sm p-4 rounded-4 text-center text-muted bg-white">
                                Brak opinii dla tego ogłoszenia.
                                @((!isAuthenticated || IsOwner) ? "" : "Bądź pierwszy i oceń ten przedmiot!")
                            </div>
                        }
                        else
                        {
                            <div class="row g-4">
                                @foreach (var review in reviews)
                                {
                                    <div class="col-md-6">
                                        <div class="card border-0 shadow-sm p-4 rounded-4 h-100 bg-white">

                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="text-warning fs-6"
                                                     style="letter-spacing: 2px;">
                                                    @(new string('★', review.Rating) + new string('☆', 5 - review.Rating))
                                                </div>

                                                <span class="fw-bold text-dark">
                                                    @review.AuthorName
                                                </span>
                                            </div>

                                            <p class="text-secondary mb-0"
                                               style="font-size: 0.95rem; line-height: 1.5;">
                                                @review.Comment
                                            </p>

                                            @if (review.UserId == currentUserIdInt)
                                            {
                                                @if (editingReviewId == review.Id)
                                                {
                                                    <div class="mt-3">
                                                        <select class="form-select mb-2" @bind="editRating">
                                                            <option value="5">★★★★★ (5/5)</option>
                                                            <option value="4">★★★★☆ (4/5)</option>
                                                            <option value="3">★★★☆☆ (3/5)</option>
                                                            <option value="2">★★☆☆☆ (2/5)</option>
                                                            <option value="1">★☆☆☆☆ (1/5)</option>
                                                        </select>
                                                        <textarea class="form-control mb-2" rows="3" @bind="editComment"></textarea>
                                                        <div class="d-flex gap-2">
                                                            <button type="button" class="btn btn-sm btn-success" @onclick="SaveReviewEdit" disabled="@isReviewActionBusy">Zapisz</button>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelReviewEdit" disabled="@isReviewActionBusy">Anuluj</button>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="d-flex gap-2 mt-3">
                                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => StartReviewEdit(review)">Edytuj</button>
                                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteReview(review.Id)" disabled="@isReviewActionBusy">Usuń</button>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                </main>

                <aside class="details-sidebar">

                    <div class="details-price-card">
                        <span class="details-price-label">Cena</span>

                        <div class="details-price">
                            @Product.Price.ToString("0.##") <span>zł</span>
                        </div>

                        <div class="details-divider"></div>

                        <h3>Informacje o wystawiającym</h3>

                        <div class="details-user">
                            <div class="details-user-avatar">
                                @(string.IsNullOrWhiteSpace(Product.AddedBy)
                                    ? "?"
                                    : Product.AddedBy.Substring(0, 1).ToUpper())
                            </div>

                            <div class="details-user-info">
                                <strong>
                                    @(string.IsNullOrWhiteSpace(Product.AddedBy)
                                        ? "Użytkownik"
                                        : Product.AddedBy)
                                </strong>

                                @if (userRating.TotalReviews > 0)
                                {
                                    <p class="profile-rating">
                                        ★ @userRating.AverageRating.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("pl-PL"))
                                        <span>(@userRating.TotalReviews @GetReviewLabel(userRating.TotalReviews))</span>
                                    </p>
                                }
                                else
                                {
                                    <p class="profile-rating">
                                        ★ 0,0 <span>(0 opinii)</span>
                                    </p>
                                }

                                <span>Wystawiający ogłoszenie</span>
                                @if (!string.IsNullOrWhiteSpace(Product.AddedBy))
                                {
                                    <a class="details-secondary-button d-block text-center mt-2"
                                       href="@($"/user/{Uri.EscapeDataString(Product.AddedBy)}")">
                                        Zobacz profil wystawiającego
                                    </a>
                                }
                            </div>
                        </div>

                        <div class="details-user-id">
                            ID użytkownika: @Product.UserId
                        </div>

                        @if (!string.IsNullOrWhiteSpace(followMessage))
                        {
                            <div class="small text-danger mb-2">
                                @followMessage
                            </div>
                        }

                        @if (!IsOwner)
                        {
                            @if (Product.Type == ProductType.Sell && Product.Price > 0)
                            {
                                @if (productUnavailable)
                                {
                                    <button type="button"
                                            class="btn w-100 mb-3"
                                            style="font-weight: 700; padding: 10px;"
                                            disabled>
                                        Produkt jest obecnie niedostępny
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn w-100 mb-3"
                                            style="font-weight: 700; padding: 10px; background-color: #2563eb; color: #fff;"
                                            @onclick="BuyProductAsync"
                                            disabled="@isBuying">
                                        @(isBuying ? "Przekierowanie do płatności..." : $"Kup teraz za {Product.Price:0.##} zł")
                                    </button>
                                }
                            }

                            @if (!string.IsNullOrWhiteSpace(purchaseMessage))
                            {
                                <div class="small text-danger mb-2">@purchaseMessage</div>
                            }

                            <button type="button"
                                    class="btn w-100 mb-3"
                                    style="font-weight: 600; padding: 10px; background-color: #0f766e; color: #fff;"
                                    @onclick="WriteMessage">
                                ✉ Napisz wiadomość
                            </button>

                            <!-- ULUBIONE: żółta gwiazdka -->
                            <button type="button"
                                    class="details-fav-button @(IsFavorite ? "is-active" : "")"
                                    aria-pressed="@(IsFavorite ? "true" : "false")"
                                    disabled="@isTogglingFavorite"
                                    @onclick="ToggleFavoriteAsync">
                                <svg class="fav-star" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                </svg>
                                <span>@(IsFavorite ? "Usuń z ulubionych" : "Dodaj do ulubionych")</span>
                            </button>

                            <!-- PRZYCISK OBSERWUJ -->
                            <button type="button"
                                    class="btn w-100 mb-3 @(isFollowing ? "btn-outline-secondary" : "btn-success")"
                                    style="font-weight: 600; padding: 10px;"
                                    @onclick="ToggleFollowUser"
                                    disabled="@isFollowLoading">
                                @if (isFollowLoading)
                                {
                                    <span>Ładowanie...</span>
                                }
                                else
                                {
                                    <span>
                                        @(isFollowing ? "✓ Obserwujesz" : "+ Obserwuj użytkownika")
                                    </span>
                                }
                            </button>

                            @if (isAuthenticated)
                            {
                                <button type="button"
                                        class="btn btn-outline-danger w-100 mb-3"
                                        @onclick="ToggleReportForm">
                                    ⚑ Zgłoś ogłoszenie
                                </button>
                            }
                        }

                        <a href="/" class="details-primary-button">
                            Przeglądaj inne ogłoszenia
                        </a>

                        @if (IsOwner)
                        {
                            <a href="/edit-product/@Product.ProductId"
                               class="details-secondary-button d-block text-center mt-2">
                                Edytuj ogłoszenie
                            </a>
                            <button type="button"
                                    class="details-primary-button"
                                    style="margin-top: 10px; cursor: pointer;"
                                    @onclick="OpenSoldDialog">
                                ✓ Sprzedane
                            </button>
                            <button type="button" class="details-danger-button w-100 mt-2" @onclick="OpenDeleteDialog">
                                Usuń ogłoszenie
                            </button>
                        }
                    </div>

                    <div class="details-safety">
                        <span>🛡️</span>

                        <div>
                            <strong>Zachowaj ostrożność</strong>
                            <p>
                                Przed dokonaniem transakcji upewnij się,
                                że wszystkie szczegóły są jasne.
                            </p>
                        </div>
                    </div>

                    @if (showReportForm)
                    {
                        <div class="card border-danger mt-3 p-3">
                            <h3 class="h5">Zgłoś ogłoszenie</h3>

                            <EditForm Model="reportModel" OnValidSubmit="SubmitReport">
                                <DataAnnotationsValidator />
                                <ValidationSummary />

                                <div class="mb-3">
                                    <label class="form-label" for="report-category">Powód zgłoszenia</label>
                                    <InputSelect id="report-category"
                                                 class="form-select"
                                                 @bind-Value="reportModel.Category">
                                        <option value="">Wybierz powód</option>
                                        @foreach (var category in Enum.GetValues<ReportCategory>())
                                        {
                                            <option value="@category">@GetReportCategoryName(category)</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => reportModel.Category)" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label" for="report-description">Opis</label>
                                    <InputTextArea id="report-description"
                                                   class="form-control"
                                                   rows="4"
                                                   @bind-Value="reportModel.Description" />
                                    <ValidationMessage For="@(() => reportModel.Description)" />
                                </div>

                                @if (!string.IsNullOrWhiteSpace(reportMessage))
                                {
                                    <div class="alert @(reportSubmitted ? "alert-success" : "alert-danger")">
                                        @reportMessage
                                    </div>
                                }

                                <div class="d-flex gap-2">
                                    <button type="submit"
                                            class="btn btn-danger"
                                            disabled="@isReportSubmitting">
                                        @(isReportSubmitting ? "Wysyłanie..." : "Wyślij zgłoszenie")
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            @onclick="ToggleReportForm"
                                            disabled="@isReportSubmitting">
                                        Anuluj
                                    </button>
                                </div>
                            </EditForm>
                        </div>
                    }

                </aside>

            </div>
        }

        @if (IsSoldDialogVisible)
        {
            <div class="delete-dialog-backdrop">
                <div class="delete-dialog" role="dialog" aria-modal="true" aria-labelledby="sold-dialog-title">
                    <div class="delete-dialog-icon" style="background: #e3f1f1; color: #097171;">✓</div>
                    <h2 id="sold-dialog-title">Czy ogłoszenie zostało sprzedane?</h2>
                    <p>Ogłoszenie zniknie ze strony, a licznik odratowanych rzeczy na stronie głównej zwiększy się o 1.</p>

                    <div class="delete-dialog-actions">
                        <button type="button" class="delete-dialog-cancel" @onclick="CloseSoldDialog" disabled="@IsMarkingSold">
                            Anuluj
                        </button>
                        <button type="button" class="delete-dialog-confirm" style="background: #097171; border-color: #097171;" @onclick="ConfirmSoldAsync" disabled="@IsMarkingSold">
                            @(IsMarkingSold ? "Zapisywanie..." : "Tak, sprzedane")
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (IsDeleteDialogVisible)
        {
            <div class="delete-dialog-backdrop">
                <div class="delete-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-dialog-title">
                    <div class="delete-dialog-icon">!</div>
                    <h2 id="delete-dialog-title">Usunąć ogłoszenie?</h2>
                    <p>Tej operacji nie można cofnąć. Ogłoszenie zostanie trwale usunięte.</p>

                    <div class="delete-dialog-actions">
                        <button type="button" class="delete-dialog-cancel" @onclick="CloseDeleteDialog" disabled="@IsDeleting">
                            Anuluj
                        </button>
                        <button type="button" class="delete-dialog-confirm" @onclick="ConfirmDeleteAsync" disabled="@IsDeleting">
                            @(IsDeleting ? "Usuwanie..." : "Usuń ogłoszenie")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int ProductId { get; set; }

    public ProductDTO? Product { get; set; }

    public bool IsLoading { get; set; } = true;

    private bool isAuthenticated;
    private string? currentUserName;
    private int? currentUserIdInt;
    private int? recentlyViewedProductId;

    private bool isFollowing;
    private bool isFollowLoading;
    private string? followMessage;

    private string? errorMessage;
    private bool isSubmitting;
    private bool showReportForm;
    private bool isReportSubmitting;
    private bool reportSubmitted;
    private string? reportMessage;
    private ReportModel reportModel = new();

    private List<ReviewDTO>? reviews;

    private bool showAddForm;
    private int newRating = 5;
    private string newComment = "";
    private int? editingReviewId;
    private int editRating = 5;
    private string editComment = "";
    private bool isReviewActionBusy;

    private UserRatingDTO userRating = new();

    private bool IsDeleteDialogVisible { get; set; }
    private bool IsDeleting { get; set; }
    private bool IsSoldDialogVisible { get; set; }
    private bool IsMarkingSold { get; set; }

    private bool isTogglingFavorite;
    private bool isBuying;
    private bool productUnavailable;
    private string? purchaseMessage;
    private bool IsFavorite => Product != null && Favorites.IsFavorite(Product.ProductId);

    private bool IsOwner
    {
        get
        {
            if (!isAuthenticated || Product == null)
                return false;

            return currentUserIdInt.HasValue &&
                   currentUserIdInt.Value == Product.UserId;
        }
    }

    private async Task BuyProductAsync()
    {
        if (Product == null || IsOwner || isBuying)
            return;

        if (productUnavailable)
            return;

        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        isBuying = true;
        purchaseMessage = null;

        try
        {
            using var request = await CreateAuthorizedRequest(
                HttpMethod.Post,
                $"api/payments/checkout/{Product.ProductId}");

            using var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                purchaseMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<CheckoutResponse>();
            if (string.IsNullOrWhiteSpace(result?.CheckoutUrl))
            {
                purchaseMessage = "Nie otrzymano adresu płatności.";
                return;
            }

            Navigation.NavigateTo(result.CheckoutUrl, forceLoad: true);
        }
        catch (Exception exception)
        {
            purchaseMessage = $"Nie udało się rozpocząć płatności: {exception.Message}";
        }
        finally
        {
            isBuying = false;
        }
    }

    private sealed class CheckoutResponse
    {
        public string CheckoutUrl { get; set; } = string.Empty;
    }

    private double AverageRating =>
        reviews != null && reviews.Any()
            ? reviews.Average(r => (double)r.Rating)
            : 0.0;

    private int TotalReviews =>
        reviews?.Count ?? 0;

    private bool HasCurrentUserReview =>
        currentUserIdInt.HasValue && reviews?.Any(r => r.UserId == currentUserIdInt.Value) == true;

    protected override void OnInitialized()
    {
        Favorites.Changed += OnFavoritesChanged;
    }

    private void OnFavoritesChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Favorites.Changed -= OnFavoritesChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;

        Product = null;
        reviews = null;
        userRating = new UserRatingDTO();

        showAddForm = false;
        errorMessage = null;
        followMessage = null;
        showReportForm = false;
        reportMessage = null;
        reportSubmitted = false;
        reportModel = new ReportModel();
        isFollowing = false;
        isFollowLoading = false;
        isTogglingFavorite = false;
        currentUserIdInt = null;
        editingReviewId = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isAuthenticated = user.Identity?.IsAuthenticated == true;

        currentUserName = isAuthenticated
            ? user.FindFirst(ClaimTypes.Name)?.Value ?? user.Identity?.Name
            : null;

        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                          ?? user.FindFirst("nameid")?.Value;

        if (int.TryParse(userIdClaim, out var parsedId))
        {
            currentUserIdInt = parsedId;
        }

        try
        {
            Product = await productApi.GetProductByIdAsync(ProductId);

            if (Product != null)
            {
                if (isAuthenticated && recentlyViewedProductId != Product.ProductId)
                {
                    recentlyViewedProductId = Product.ProductId;

                    var recorded = await RecentlyViewedApiService
                        .RecordViewAsync(Product.ProductId);

                    if (!recorded)
                        recentlyViewedProductId = null;
                }

                await LoadReviews();

                if (isAuthenticated)
                {
                    await CheckFollowStatus();
                    await Favorites.EnsureLoadedAsync();
                }

                await LoadProductAvailability();

                userRating = await ReviewApiService.GetUserRatingAsync(Product.UserId)
                             ?? new UserRatingDTO();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Wystąpił błąd podczas ładowania ogłoszenia: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

