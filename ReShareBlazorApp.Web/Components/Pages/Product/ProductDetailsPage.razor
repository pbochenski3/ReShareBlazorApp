@page "/details/{ProductId:int}"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Web.ApiServices

@inject ProductApiService productApi
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ReviewApiService ReviewApiService
@inject RecentlyViewedApiService RecentlyViewedApiService
@inject AuthenticationStateProvider AuthStateProvider

<div class="details-page">
    <div class="details-container">

        <a href="/" class="details-back">
            <span>←</span> Wróć do ogłoszeń
        </a>

        @if (IsLoading)
        {
            <div class="details-state">
                <div class="details-loader"></div>
                <p>Ładowanie ogłoszenia...</p>
            </div>
        }
        else if (Product == null)
        {
            <div class="details-state">
                <div class="details-empty-icon">!</div>
                <h2>Nie znaleziono ogłoszenia</h2>
                <p>Ogłoszenie mogło zostać usunięte lub nie istnieje.</p>
                <a href="/" class="details-primary-button">Wróć na stronę główną</a>
            </div>
        }
        else
        {
            <div class="details-layout">

                <main class="details-main">

                    <div class="details-category">
                        @Product.Category
                    </div>

                    <h1 class="details-title">
                        @Product.Name
                    </h1>

                    <div class="details-location">
                        <span>📍</span>
                        @Product.City
                    </div>

                    <section class="details-section">
                        <h2>Opis ogłoszenia</h2>

                        <p class="details-description">
                            @if (string.IsNullOrWhiteSpace(Product.Description))
                            {
                                <span>Brak opisu ogłoszenia.</span>
                            }
                            else
                            {
                                @Product.Description
                            }
                        </p>
                    </section>

                    <section class="details-section">
                        <h2>Informacje o ogłoszeniu</h2>

                        <div class="details-info-grid">
                            <div class="details-info-item">
                                <span class="details-info-label">Data dodania</span>
                                <strong>@Product.AddedAt.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>

                            <div class="details-info-item">
                                <span class="details-info-label">Wygasa</span>
                                <strong>@Product.ExpiresAt.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>
                        </div>
                    </section>

                    <section class="details-section mt-5 pt-4 border-top">

                        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                            <div>
                                <h3 class="fw-bold text-dark m-0">Opinie o ogłoszeniu</h3>

                                <div class="text-warning fw-bold mt-1">
                                    <span>★</span>
                                    <span>@AverageRating.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                                    <span class="text-muted fw-normal ms-1">(@TotalReviews opinii)</span>
                                </div>
                            </div>

                            @if (!isAuthenticated)
                            {
                                <a href="/login"
                                   class="btn btn-sm rounded-pill px-4 py-2 fw-semibold shadow-sm text-white"
                                   style="background-color: #0f766e;">
                                    Zaloguj się, aby dodać opinię
                                </a>
                            }
                            else if (IsOwner)
                            {
                                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                                    To Twoje ogłoszenie – nie możesz go oceniać
                                </span>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-sm rounded-pill px-4 py-2 fw-semibold shadow-sm text-white"
                                        @onclick="ToggleForm"
                                        style="background-color: #0f766e;">
                                    @(showAddForm ? "Anuluj" : "+ Dodaj opinię")
                                </button>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert alert-danger rounded-3 py-2 px-3 mb-3">
                                @errorMessage
                            </div>
                        }

                        @if (showAddForm && isAuthenticated && !IsOwner)
                        {
                            <div class="card border-0 shadow-sm p-4 mb-4 rounded-4 bg-white"
                                 style="border-left: 4px solid #0f766e !important;">

                                <h5 class="fw-bold mb-3 text-dark">
                                    Wystaw opinię do tego ogłoszenia
                                </h5>

                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">
                                        Twoje imię / nazwa:
                                    </label>

                                    <input type="text"
                                           class="form-control rounded-3 bg-light"
                                           value="@(currentUserName ?? "Anonim")"
                                           readonly />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">
                                        Ocena (gwiazdki):
                                    </label>

                                    <select class="form-select rounded-3" @bind="newRating">
                                        <option value="5">★★★★★ (5/5)</option>
                                        <option value="4">★★★★☆ (4/5)</option>
                                        <option value="3">★★★☆☆ (3/5)</option>
                                        <option value="2">★★☆☆☆ (2/5)</option>
                                        <option value="1">★☆☆☆☆ (1/5)</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">
                                        Treść opinii / komentarz:
                                    </label>

                                    <textarea class="form-control rounded-3"
                                              rows="3"
                                              @bind="newComment"
                                              placeholder="Napisz kilka słów o przedmiocie lub transakcji...">
                                    </textarea>
                                </div>

                                <button type="button"
                                        class="btn px-4 rounded-pill fw-semibold text-white"
                                        disabled="@isSubmitting"
                                        @onclick="SubmitReview"
                                        style="background-color: #0f766e;">
                                    @(isSubmitting ? "Zapisywanie..." : "Zapisz opinię")
                                </button>
                            </div>
                        }

                        @if (reviews == null)
                        {
                            <div class="text-muted py-3">
                                Ładowanie opinii...
                            </div>
                        }
                        else if (!reviews.Any())
                        {
                            <div class="card border-0 shadow-sm p-4 rounded-4 text-center text-muted bg-white">
                                Brak opinii dla tego ogłoszenia.
                                @((!isAuthenticated || IsOwner) ? "" : "Bądź pierwszy i oceń ten przedmiot!")
                            </div>
                        }
                        else
                        {
                            <div class="row g-4">
                                @foreach (var review in reviews)
                                {
                                    <div class="col-md-6">
                                        <div class="card border-0 shadow-sm p-4 rounded-4 h-100 bg-white">

                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="text-warning fs-6"
                                                     style="letter-spacing: 2px;">
                                                    @(new string('★', review.Rating) + new string('☆', 5 - review.Rating))
                                                </div>

                                                <span class="fw-bold text-dark">
                                                    @review.AuthorName
                                                </span>
                                            </div>

                                            <p class="text-secondary mb-0"
                                               style="font-size: 0.95rem; line-height: 1.5;">
                                                @review.Comment
                                            </p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                </main>

                <aside class="details-sidebar">

                    <div class="details-price-card">
                        <span class="details-price-label">Cena</span>

                        <div class="details-price">
                            @Product.Price.ToString("N2") <span>zł</span>
                        </div>

                        <div class="details-divider"></div>

                        <h3>Informacje o wystawiającym</h3>

                        <div class="details-user">
                            <div class="details-user-avatar">
                                @(string.IsNullOrWhiteSpace(Product.AddedBy)
                                    ? "?"
                                    : Product.AddedBy.Substring(0, 1).ToUpper())
                            </div>

                            <div class="details-user-info">
                                <strong>
                                    @(string.IsNullOrWhiteSpace(Product.AddedBy)
                                        ? "Użytkownik"
                                        : Product.AddedBy)
                                </strong>

                                <span>Wystawiający ogłoszenie</span>
                            </div>
                        </div>

                        <div class="details-user-id">
                            ID użytkownika: @Product.UserId
                        </div>

                        @if (!string.IsNullOrWhiteSpace(followMessage))
                        {
                            <div class="small text-danger mb-2">
                                @followMessage
                            </div>
                        }

                        @if (!IsOwner)
                        {
                            <button type="button"
                                    class="btn w-100 mb-3 @(isFollowing ? "btn-outline-secondary" : "btn-success")"
                                    style="font-weight: 600; padding: 10px;"
                                    @onclick="ToggleFollowUser"
                                    disabled="@isFollowLoading">
                                @if (isFollowLoading)
                                {
                                    <span>Ładowanie...</span>
                                }
                                else
                                {
                                    <span>
                                        @(isFollowing ? "✓ Obserwujesz" : "+ Obserwuj użytkownika")
                                    </span>
                                }
                            </button>

                            <button type="button"
                                    class="btn w-100 mb-3"
                                    style="font-weight: 600; padding: 10px; background-color: #0f766e; color: #fff;"
                                    @onclick="WriteMessage">
                                ✉ Napisz wiadomość
                            </button>
                        }

                        <a href="/" class="details-primary-button">
                            Przeglądaj inne ogłoszenia
                        </a>

                        @if (IsOwner)
                        {
                            <a href="/edit-product/@Product.ProductId"
                               class="details-secondary-button d-block text-center mt-2">
                                Edytuj ogłoszenie
                            </a>
                        }
                    </div>

                    <div class="details-safety">
                        <span>🛡️</span>

                        <div>
                            <strong>Zachowaj ostrożność</strong>
                            <p>
                                Przed dokonaniem transakcji upewnij się,
                                że wszystkie szczegóły są jasne.
                            </p>
                        </div>
                    </div>

                </aside>

            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int ProductId { get; set; }

    public ProductDTO? Product { get; set; }

    public bool IsLoading { get; set; } = true;

    private bool isAuthenticated;
    private string? currentUserName;
    private int? currentUserIdInt;
    private int? recentlyViewedProductId;

    private bool isFollowing;
    private bool isFollowLoading;
    private string? followMessage;

    private string? errorMessage;
    private bool isSubmitting;

    private List<ReviewDTO>? reviews;

    private bool showAddForm;
    private int newRating = 5;
    private string newComment = "";

    private bool IsOwner
    {
        get
        {
            if (!isAuthenticated || Product == null)
                return false;

            return currentUserIdInt.HasValue &&
                   currentUserIdInt.Value == Product.UserId;
        }
    }

    private double AverageRating =>
        reviews != null && reviews.Any()
            ? reviews.Average(r => (double)r.Rating)
            : 0.0;

    private int TotalReviews =>
        reviews?.Count ?? 0;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;

        Product = null;
        reviews = null;

        showAddForm = false;
        errorMessage = null;
        followMessage = null;
        isFollowing = false;
        currentUserIdInt = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isAuthenticated = user.Identity?.IsAuthenticated == true;

        currentUserName = isAuthenticated
            ? user.FindFirst(ClaimTypes.Name)?.Value ?? user.Identity?.Name
            : null;

        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                          ?? user.FindFirst("nameid")?.Value;

        if (int.TryParse(userIdClaim, out var parsedId))
        {
            currentUserIdInt = parsedId;
        }

        try
        {
            Product = await productApi.GetProductByIdAsync(ProductId);

            if (Product != null)
            {
                if (isAuthenticated && recentlyViewedProductId != Product.ProductId)
                {
                    // OnParametersSetAsync może zostać wywołane ponownie dla tego
                    // samego adresu. Nie wysyłamy wtedy drugiego żądania POST.
                    recentlyViewedProductId = Product.ProductId;

                    var recorded = await RecentlyViewedApiService
                        .RecordViewAsync(Product.ProductId);

                    // Pozwól na ponowną próbę, jeśli żądanie nie powiodło się.
                    if (!recorded)
                        recentlyViewedProductId = null;
                }

                await LoadReviews();

                if (isAuthenticated)
                {
                    await CheckFollowStatus();
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Wystąpił błąd podczas ładowania ogłoszenia: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    // Pobieranie opinii dla ogłoszenia
    private async Task LoadReviews()
    {
        try
        {
            reviews = await ReviewApiService.GetReviewsForProductAsync(ProductId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Błąd podczas pobierania opinii: {ex.Message}");
            reviews = new();
        }
    }

    // Tworzenie zapytania z tokenem autoryzacyjnym
    private async Task<HttpRequestMessage> CreateAuthorizedRequest(
        HttpMethod method,
        string url)
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var token = state.User.FindFirst("access_token")?.Value;
            if (string.IsNullOrWhiteSpace(token))
                return new HttpRequestMessage(method, url);

            var request = new HttpRequestMessage(method, url);
            request.Headers.Authorization =
                new AuthenticationHeaderValue("Bearer", token);
            return request;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Nie udało się pobrać tokenu: {ex.Message}");
            return new HttpRequestMessage(method, url);
        }
    }

    // Sprawdzanie, czy aktualny użytkownik obserwuje wystawiającego
    private async Task CheckFollowStatus()
    {
        if (Product == null || !isAuthenticated)
            return;

        try
        {
            using var request = await CreateAuthorizedRequest(
                HttpMethod.Get,
                $"api/users/{Product.UserId}/is-following");

            using var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                isFollowing = await response.Content.ReadFromJsonAsync<bool>();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                isFollowing = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Błąd sprawdzania obserwowania: {ex.Message}");
            isFollowing = false;
        }
    }

    // Zmiana widoczności formularza opinii
    private void ToggleForm()
    {
        errorMessage = null;

        if (!isAuthenticated || IsOwner)
            return;

        showAddForm = !showAddForm;
    }

    // Dodawanie opinii
    private async Task SubmitReview()
    {
        errorMessage = null;

        if (!isAuthenticated)
        {
            errorMessage = "Musisz być zalogowany, aby dodać opinię.";
            return;
        }

        if (Product == null)
            return;

        if (IsOwner)
        {
            errorMessage = "Nie możesz dodać opinii do własnego ogłoszenia.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newComment))
        {
            errorMessage = "Wpisz treść opinii przed zapisaniem.";
            return;
        }

        if (newRating < 1 || newRating > 5)
        {
            errorMessage = "Ocena musi być w zakresie od 1 do 5.";
            return;
        }

        isSubmitting = true;

        try
        {
            var author = !string.IsNullOrWhiteSpace(currentUserName)
                ? currentUserName
                : "Anonim";

            var request = new CreateReviewRequest
            {
                ProductId = ProductId,
                AuthorName = author,
                Rating = newRating,
                Comment = newComment.Trim()
            };

            var success = await ReviewApiService.AddReviewAsync(request);

            if (success)
            {
                newComment = "";
                newRating = 5;
                showAddForm = false;

                await LoadReviews();
            }
            else
            {
                errorMessage = "Nie udało się zapisać opinii. Sprawdź, czy sesja logowania jest aktywna w API.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Wystąpił błąd podczas dodawania opinii: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    // Obserwowanie lub przestanie obserwowania użytkownika
    private async Task ToggleFollowUser()
    {
        followMessage = null;

        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (Product == null)
            return;

        if (IsOwner)
        {
            followMessage = "Nie możesz obserwować samego siebie.";
            return;
        }

        if (isFollowLoading)
            return;

        isFollowLoading = true;

        try
        {
            using var request = await CreateAuthorizedRequest(
                HttpMethod.Post,
                $"api/users/{Product.UserId}/toggle-follow");

            using var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ToggleResult>();

                if (result != null)
                {
                    isFollowing = result.IsFollowing;
                }
                else
                {
                    followMessage = "Nie udało się odczytać odpowiedzi serwera.";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                followMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            followMessage = $"Błąd połączenia z API: {ex.Message}";
        }
        finally
        {
            isFollowLoading = false;
        }
    }

    // Przejście do tworzenia wiadomości
    private void WriteMessage()
    {
        if (Product == null || IsOwner)
            return;

        if (!isAuthenticated || !currentUserIdInt.HasValue)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        Navigation.NavigateTo(
            $"/wiadomosci/nowa/{currentUserIdInt.Value}/{Product.UserId}/{Product.ProductId}");
    }

    private class ToggleResult
    {
        public bool IsFollowing { get; set; }
    }
}
