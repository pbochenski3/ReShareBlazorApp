@page "/admin/badges"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Web.ApiServices

@attribute [Authorize(Roles = "Admin")]

@inject BadgeApiService BadgeApiService
@inject AdminApiService AdminApiService

<PageTitle>Zarządzanie odznakami</PageTitle>

<h1 class="admin-title">Zarządzanie odznakami</h1>

<div class="admin-badges-container">

    @if (!string.IsNullOrEmpty(message))
    {
        <p class="admin-badge-message">@message</p>
    }

    <div class="admin-badge-user-select">
        <h2>Wybierz użytkownika</h2>

        <select class="form-control"
                @bind="selectedUserId"
                @bind:after="OnUserChanged">
            <option value="">-- Wybierz użytkownika --</option>

            @foreach (var user in users)
            {
                <option value="@user.Id">@user.UserName</option>
            }
        </select>
    </div>

    <div class="admin-badge-list">
        <h2>Dostępne odznaki</h2>

        @if (loading)
        {
            <p>Ładowanie...</p>
        }
        else if (badges.Count == 0)
        {
            <p>Nie ma jeszcze żadnych odznak.</p>
        }
        else
        {
            <div class="admin-badges-grid">
                @foreach (var badge in badges)
                {
                    <div class="admin-badge-item">
                        <span class="admin-badge-icon">@badge.Icon</span>
                        <h3>@badge.Name</h3>
                        <p>@badge.Description</p>

                        @if (selectedUserId != null)
                        {
                            @if (badge.IsEarned)
                            {
                                <button class="btn btn-danger"
                                        disabled="@saving"
                                        @onclick="() => RemoveBadgeAsync(badge.Id)">
                                    Odbierz odznakę
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-success"
                                        disabled="@saving"
                                        @onclick="() => AwardBadgeAsync(badge.Id)">
                                    Przyznaj odznakę
                                </button>
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>

</div>

@code {
    private List<BadgeDTO> badges = new();
    private List<AdminUserDTO> users = new();

    private int? selectedUserId;

    private bool loading = true;
    private bool saving = false;

    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadBadgesAsync();

        try
        {
            users = await AdminApiService.GetUsersAsync();
        }
        catch (Exception ex)
        {
            message = "Nie udało się pobrać użytkowników: " + ex.Message;
        }
    }

    private async Task LoadBadgesAsync()
    {
        try
        {
            badges = await BadgeApiService.GetAllBadgesAsync();
        }
        catch (Exception ex)
        {
            message = "Nie udało się pobrać odznak: " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnUserChanged()
    {
        message = null;

        if (selectedUserId == null)
        {
            await LoadBadgesAsync();
            return;
        }

        try
        {
            badges = await BadgeApiService.GetUserBadgesAsync(selectedUserId.Value);
        }
        catch (Exception ex)
        {
            message = "Nie udało się pobrać odznak użytkownika: " + ex.Message;
        }
    }

    private async Task AwardBadgeAsync(int badgeId)
    {
        if (selectedUserId == null)
            return;

        saving = true;
        message = null;

        try
        {
            await BadgeApiService.AwardBadgeToUserAsync(
                selectedUserId.Value, badgeId);

            message = "Odznaka została przyznana użytkownikowi.";

            await OnUserChanged();
        }
        catch (Exception ex)
        {
            message = "Nie udało się przyznać odznaki: " + ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task RemoveBadgeAsync(int badgeId)
    {
        if (selectedUserId == null)
            return;

        saving = true;
        message = null;

        try
        {
            await BadgeApiService.RemoveBadgeFromUserAsync(
                selectedUserId.Value, badgeId);

            message = "Odznaka została odebrana użytkownikowi.";

            await OnUserChanged();
        }
        catch (Exception ex)
        {
            message = "Nie udało się odebrać odznaki: " + ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
