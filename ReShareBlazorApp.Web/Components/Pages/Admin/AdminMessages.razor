@page "/admin/messages"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Web.ApiServices
@attribute [Authorize(Roles = "Admin")]
@inject ContactApiService contactApi
@inject AdminSupportApiService supportApi

<h1 class="admin-title">Wiadomości kontaktowe</h1>

@if (!string.IsNullOrEmpty(message))
{
    <div class="admin-alert">@message</div>
}

@if (messages is null)
{
    <p class="admin-muted">Ładowanie...</p>
}
else if (!messages.Any())
{
    <p class="admin-muted">Brak wiadomości z formularza kontaktowego.</p>
}
else
{
    <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin-bottom:16px;">
        <input class="admin-search"
               style="margin-bottom:0;"
               placeholder="Szukaj po nadawcy, e-mailu, tytule lub treści..."
               @bind="searchQuery"
               @bind:event="oninput" />

        <select class="admin-search"
                style="margin-bottom:0; max-width:200px;"
                @bind="statusFilter">
            <option value="all">Status: Wszystkie</option>
            <option value="unread">Status: Nowe</option>
            <option value="read">Status: Przeczytane</option>
        </select>

        <select class="admin-search"
                style="margin-bottom:0; max-width:260px;"
                @bind="subjectFilter">
            <option value="">Tytuł: Wszystkie</option>
            @foreach (var subj in AvailableSubjects)
            {
                <option value="@subj">@subj</option>
            }
        </select>

        @if (HasActiveFilters)
        {
            <button type="button" class="admin-btn" @onclick="ClearFilters">
                Wyczyść filtry
            </button>
        }
    </div>

    <p class="admin-muted" style="margin-bottom:12px;">
        Wyświetlane: <strong>@FilteredMessages.Count()</strong> z @messages.Count
    </p>

    @if (!FilteredMessages.Any())
    {
        <p class="admin-muted">Brak wiadomości spełniających wybrane filtry.</p>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Nadawca</th>
                        <th>E-mail</th>
                        <th>Tytuł</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in FilteredMessages)
                    {
                        <tr>
                            <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.Name</td>
                            <td>@item.Email</td>
                            <td><strong>@item.Subject</strong></td>
                            <td>
                                @if (item.IsRead)
                                {
                                    <span class="admin-badge admin-badge-ok">przeczytana</span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge-info">nowa</span>
                                }
                            </td>
                            <td class="admin-actions">
                                <button type="button" class="admin-btn" @onclick="() => OpenMessage(item)">
                                    Pokaż / odpowiedz
                                </button>
                                @if (!item.IsRead)
                                {
                                    <button type="button" class="admin-btn" @onclick="() => MarkRead(item)">
                                        Oznacz jako przeczytaną
                                    </button>
                                }
                                <button type="button" class="admin-btn admin-btn-danger" @onclick="() => Delete(item)">
                                    Usuń
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (selectedMessage is not null)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,.45); display:flex; align-items:center; justify-content:center; padding:20px; z-index:999;"
         @onclick="CloseMessage">
        <div style="background:#fff; border-radius:12px; max-width:640px; width:100%; max-height:85vh; overflow-y:auto; padding:24px; box-shadow:0 12px 32px rgba(0,0,0,.2);"
             @onclick:stopPropagation="true">
            <h2 style="margin:0 0 12px; font-size:1.35rem;">@selectedMessage.Subject</h2>

            <p style="margin:0 0 6px; font-size:.9rem; color:#555;">
                <strong>Nadawca:</strong> @selectedMessage.Name (@selectedMessage.Email)
            </p>
            <p style="margin:0 0 16px; font-size:.9rem; color:#555;">
                <strong>Data:</strong> @selectedMessage.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
            </p>

            <div style="background:#f8f9fa; border:1px solid #e5e7eb; border-radius:8px; padding:16px; white-space:pre-wrap; overflow-wrap:anywhere; line-height:1.6; font-size:1rem;">
                @selectedMessage.Message
            </div>

            @if (replies.Count > 0)
            {
                <div class="admin-reply-history">
                    <span class="report-label">Wysłane odpowiedzi</span>
                    @foreach (var r in replies)
                    {
                        <div class="admin-reply-item">
                            <small>@r.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @r.AdminName · @r.Recipient (@(r.Channel == "InApp" ? "czat" : "e-mail"))</small>
                            <p>@r.Body</p>
                        </div>
                    }
                </div>
            }

            <div class="admin-reply-box">
                <span class="report-label">Odpowiedź trafi na czat użytkownika (konto z adresem @selectedMessage.Email). Jeśli nadawca nie ma konta – zostanie wysłana e-mailem.</span>
                <textarea class="admin-reply-textarea"
                          rows="4"
                          maxlength="@ChatConstants.MaxAdminReplyLength"
                          placeholder="Treść odpowiedzi…"
                          @bind="replyText"
                          @bind:event="oninput"></textarea>

                @if (!string.IsNullOrEmpty(replyMessage))
                {
                    <div class="admin-alert @(replyOk ? "admin-alert-success" : "")">@replyMessage</div>
                }

                <div>
                    <button type="button"
                            class="admin-btn admin-btn-primary"
                            disabled="@(isSendingReply || string.IsNullOrWhiteSpace(replyText))"
                            @onclick="SendReplyAsync">
                        @(isSendingReply ? "Wysyłanie…" : "Wyślij odpowiedź")
                    </button>
                </div>
            </div>

            <div style="margin-top:20px; display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" class="admin-btn admin-btn-danger" @onclick="() => Delete(selectedMessage)">
                    Usuń
                </button>
                <button type="button" class="admin-btn" @onclick="CloseMessage">
                    Zamknij
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ContactMessageDTO>? messages;
    private ContactMessageDTO? selectedMessage;
    private string? message;

    private string searchQuery = "";
    private string statusFilter = "all";
    private string subjectFilter = "";

    private List<AdminReplyDTO> replies = new();
    private string replyText = "";
    private string? replyMessage;
    private bool replyOk;
    private bool isSendingReply;

    private IEnumerable<string> AvailableSubjects =>
        messages?
            .Select(m => m.Subject)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct()
            .OrderBy(s => s)
        ?? Enumerable.Empty<string>();

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchQuery)
        || statusFilter != "all"
        || !string.IsNullOrWhiteSpace(subjectFilter);

    private IEnumerable<ContactMessageDTO> FilteredMessages =>
        (messages ?? Enumerable.Empty<ContactMessageDTO>()).Where(m =>
        {
            if (statusFilter == "unread" && m.IsRead) return false;
            if (statusFilter == "read" && !m.IsRead) return false;

            if (!string.IsNullOrWhiteSpace(subjectFilter)
                && !string.Equals(m.Subject, subjectFilter, StringComparison.OrdinalIgnoreCase))
                return false;

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim();
                var match = m.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                            || m.Email.Contains(q, StringComparison.OrdinalIgnoreCase)
                            || m.Subject.Contains(q, StringComparison.OrdinalIgnoreCase)
                            || m.Message.Contains(q, StringComparison.OrdinalIgnoreCase);
                if (!match) return false;
            }

            return true;
        });

    protected override async Task OnInitializedAsync()
    {
        messages = await contactApi.GetContactMessagesAsync() ?? new List<ContactMessageDTO>();
    }

    private void ClearFilters()
    {
        searchQuery = "";
        statusFilter = "all";
        subjectFilter = "";
    }

    private async Task OpenMessage(ContactMessageDTO item)
    {
        selectedMessage = item;
        replyText = "";
        replyMessage = null;
        replies = new List<AdminReplyDTO>();

        if (!item.IsRead)
        {
            await MarkRead(item);
        }

        var loaded = await supportApi.GetContactRepliesAsync(item.Id);
        if (selectedMessage?.Id == item.Id)
            replies = loaded;
    }

    private void CloseMessage()
    {
        selectedMessage = null;
    }

    private async Task MarkRead(ContactMessageDTO item)
    {
        message = null;
        if (await contactApi.MarkContactMessageAsReadAsync(item.Id))
            item.IsRead = true;
        else
            message = "Nie udało się zaktualizować statusu wiadomości.";
    }

    private async Task SendReplyAsync()
    {
        var target = selectedMessage;
        if (target is null || isSendingReply)
            return;

        var text = replyText.Trim();
        if (text.Length == 0)
            return;

        isSendingReply = true;
        replyMessage = null;

        var (success, error, reply) = await supportApi.ReplyToContactAsync(target.Id, text);

        isSendingReply = false;

        if (success && reply is not null)
        {
            if (selectedMessage?.Id == target.Id)
                replies.Add(reply);

            replyText = "";
            replyOk = true;
            replyMessage = reply.Channel == "InApp"
                ? "Odpowiedź została wysłana na czat użytkownika."
                : "Nadawca nie ma konta, więc odpowiedź została wysłana e-mailem.";
            target.IsRead = true;
        }
        else
        {
            replyOk = false;
            replyMessage = error ?? "Nie udało się wysłać odpowiedzi.";
        }
    }

    private async Task Delete(ContactMessageDTO item)
    {
        message = null;
        if (await contactApi.DeleteContactMessageAsync(item.Id))
        {
            messages!.Remove(item);
            if (selectedMessage?.Id == item.Id)
                selectedMessage = null;
        }
        else
            message = "Nie udało się usunąć wiadomości.";
    }
}