@page "/admin/users"
@layout AdminLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Web.ApiServices
@attribute [Authorize(Roles = "Admin")]
@inject AdminApiService adminApi
@inject AuthenticationStateProvider authStateProvider

<div class="admin-header">
    <div class="admin-header-title-wrap">
        <h1 class="admin-title">Użytkownicy</h1>
        <p class="admin-muted" style="margin: 0;">Zarządzaj kontami użytkowników oraz uprawnieniami administratora.</p>
    </div>
    <button type="button" class="admin-btn admin-btn-primary" @onclick="OpenAddModal" disabled="@isActionInProgress">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="8.5" cy="7" r="4"></circle>
            <line x1="20" y1="8" x2="20" y2="14"></line>
            <line x1="23" y1="11" x2="17" y2="11"></line>
        </svg>
        Dodaj użytkownika
    </button>
</div>

<input class="admin-search"
       placeholder="Szukaj po nazwie, e-mailu lub roli..."
       @bind="search"
       @bind:event="oninput" />

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="admin-alert">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="admin-alert-success">@successMessage</div>
}

@if (users is null)
{
    <p class="admin-muted">Ładowanie...</p>
}
else
{
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nazwa</th>
                    <th>E-mail</th>
                    <th>Rola</th>
                    <th>Status</th>
                    <th style="text-align: right;">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Filtered)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>
                            <strong>@user.UserName</strong>
                            @if (user.Id == currentUserId)
                            {
                                <span class="admin-badge admin-badge-info">to Ty</span>
                            }
                        </td>
                        <td>@user.Email</td>
                        <td>
                            @if (user.IsAdmin)
                            {
                                <span class="admin-badge admin-badge-admin">Administrator</span>
                            }
                            else
                            {
                                <span class="admin-badge admin-badge-user">Użytkownik</span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="admin-badge admin-badge-ok">aktywny</span>
                            }
                            else
                            {
                                <span class="admin-badge admin-badge-bad">zablokowany</span>
                            }
                        </td>
                        <td class="admin-actions">
                            @if (user.Id != currentUserId && !string.Equals(user.UserName, "admin12345", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="admin-actions-inner">
                                    @if (user.IsAdmin)
                                    {
                                        <button class="admin-btn admin-btn-role admin-btn-role-demote"
                                                @onclick="() => PromptToggleRole(user)"
                                                disabled="@isActionInProgress"
                                                title="Odbierz uprawnienia administratora">
                                            Odbierz admina
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="admin-btn admin-btn-role admin-btn-role-promote"
                                                @onclick="() => PromptToggleRole(user)"
                                                disabled="@isActionInProgress"
                                                title="Nadaj uprawnienia administratora">
                                            Nadaj admina
                                        </button>
                                    }

                                    <button class="admin-btn @(user.IsActive ? "admin-btn-danger" : "")"
                                            @onclick="() => ToggleActive(user)"
                                            disabled="@isActionInProgress">
                                        @(user.IsActive ? "Zablokuj" : "Odblokuj")
                                    </button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Modal: Dodaj użytkownika *@
@if (isAddModalOpen)
{
    <div class="admin-modal-backdrop" @onclick="CloseAddModal">
        <div class="admin-modal" @onclick:stopPropagation="true">
            <div class="admin-modal-header">
                <div>
                    <h2 class="admin-modal-title">Dodaj użytkownika</h2>
                    <p class="admin-modal-desc">Wprowadź dane nowego konta oraz wybierz jego rolę.</p>
                </div>
                <button type="button" class="admin-modal-close" @onclick="CloseAddModal" aria-label="Zamknij">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(modalError))
            {
                <div class="admin-alert" style="margin: 0;">@modalError</div>
            }

            <form @onsubmit="HandleCreateUser" style="display: flex; flex-direction: column; gap: 14px;">
                <div class="admin-form-group">
                    <label for="new-username">Nazwa użytkownika *</label>
                    <input id="new-username"
                           class="admin-form-input"
                           placeholder="np. jan_kowalski"
                           @bind="newModel.UserName"
                           required />
                </div>

                <div class="admin-form-group">
                    <label for="new-email">Adres e-mail *</label>
                    <input id="new-email"
                           type="email"
                           class="admin-form-input"
                           placeholder="np. jan@example.com"
                           @bind="newModel.Email"
                           required />
                </div>

                <div class="admin-form-group">
                    <label for="new-password">Hasło *</label>
                    <input id="new-password"
                           type="password"
                           class="admin-form-input"
                           placeholder="Minimum 8 znaków"
                           @bind="newModel.Password"
                           required />
                    <span class="admin-form-hint">Wymagane min. 8 znaków, wielka i mała litera oraz cyfra.</span>
                </div>

                <div class="admin-form-group">
                    <label>Uprawnienia</label>
                    <label class="admin-role-card @(newModel.IsAdmin ? "selected" : "")">
                        <input type="checkbox" @bind="newModel.IsAdmin" />
                        <div class="admin-role-info">
                            <strong>
                                Rola Administratora
                                <span class="admin-badge admin-badge-admin">Admin</span>
                            </strong>
                            <span>Zaznacz, aby nadać użytkownikowi pełne uprawnienia administratora i dostęp do panelu /admin.</span>
                        </div>
                    </label>
                </div>

                <div class="admin-modal-actions">
                    <button type="button" class="admin-btn admin-btn-secondary" @onclick="CloseAddModal" disabled="@isSubmitting">
                        Anuluj
                    </button>
                    <button type="submit" class="admin-btn admin-btn-primary" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span>Tworzenie...</span>
                        }
                        else
                        {
                            <span>Utwórz użytkownika</span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@* Modal: Potwierdzenie zmiany roli *@
@if (roleConfirmUser != null)
{
    <div class="admin-modal-backdrop" @onclick="CancelRoleChange">
        <div class="admin-modal" @onclick:stopPropagation="true" style="max-width: 440px;">
            <div class="admin-modal-header">
                <div>
                    <h2 class="admin-modal-title">
                        @(roleConfirmIsAdmin ? "Nadanie roli Administratora" : "Odebranie roli Administratora")
                    </h2>
                </div>
                <button type="button" class="admin-modal-close" @onclick="CancelRoleChange" aria-label="Zamknij">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <p style="margin: 0; color: var(--ink); line-height: 1.5;">
                @if (roleConfirmIsAdmin)
                {
                    <span>Czy na pewno chcesz nadać uprawnienia administratora użytkownikowi <strong>@roleConfirmUser.UserName</strong>? Użytkownik uzyska dostęp do panelu /admin.</span>
                }
                else
                {
                    <span>Czy na pewno chcesz odebrać uprawnienia administratora użytkownikowi <strong>@roleConfirmUser.UserName</strong>? Użytkownik straci uprawnienia i dostęp do panelu administracyjnego.</span>
                }
            </p>

            <div class="admin-modal-actions">
                <button type="button" class="admin-btn admin-btn-secondary" @onclick="CancelRoleChange" disabled="@isActionInProgress">
                    Anuluj
                </button>
                <button type="button"
                        class="admin-btn @(roleConfirmIsAdmin ? "admin-btn-primary" : "admin-btn-danger")"
                        @onclick="ExecuteRoleChange"
                        disabled="@isActionInProgress">
                    @if (isActionInProgress)
                    {
                        <span>Zapisywanie...</span>
                    }
                    else
                    {
                        <span>@(roleConfirmIsAdmin ? "Nadaj uprawnienia" : "Odbierz uprawnienia")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<AdminUserDTO>? users;
    private string search = "";
    private string? errorMessage;
    private string? successMessage;
    private int currentUserId;

    // Modal dodawania
    private bool isAddModalOpen = false;
    private bool isSubmitting = false;
    private string? modalError;
    private AdminCreateUserRequest newModel = new();

    // Modal potwierdzenia roli
    private AdminUserDTO? roleConfirmUser;
    private bool roleConfirmIsAdmin;
    private bool isActionInProgress = false;

    private IEnumerable<AdminUserDTO> Filtered =>
        (users ?? Enumerable.Empty<AdminUserDTO>()).Where(u =>
            string.IsNullOrWhiteSpace(search)
            || u.UserName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || u.Email.Contains(search, StringComparison.OrdinalIgnoreCase)
            || (u.IsAdmin && "administrator admin".Contains(search, StringComparison.OrdinalIgnoreCase))
            || (!u.IsAdmin && "użytkownik user".Contains(search, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        var authState = await authStateProvider.GetAuthenticationStateAsync();
        int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out currentUserId);

        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        users = await adminApi.GetUsersAsync();
    }

    private void OpenAddModal()
    {
        newModel = new AdminCreateUserRequest { IsAdmin = true };
        modalError = null;
        isAddModalOpen = true;
    }

    private void CloseAddModal()
    {
        if (isSubmitting) return;
        isAddModalOpen = false;
        modalError = null;
    }

    private async Task HandleCreateUser()
    {
        modalError = null;

        if (string.IsNullOrWhiteSpace(newModel.UserName) || newModel.UserName.Trim().Length < 3)
        {
            modalError = "Nazwa użytkownika musi mieć co najmniej 3 znaki.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newModel.Email) || !newModel.Email.Contains("@"))
        {
            modalError = "Podaj poprawny adres e-mail.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newModel.Password) || newModel.Password.Length < 8)
        {
            modalError = "Hasło musi mieć co najmniej 8 znaków.";
            return;
        }

        isSubmitting = true;
        try
        {
            var (success, error, createdUser) = await adminApi.CreateUserAsync(newModel);
            if (success && createdUser != null)
            {
                isAddModalOpen = false;
                errorMessage = null;
                successMessage = $"Użytkownik '{createdUser.UserName}' został pomyślnie utworzony" +
                                 (createdUser.IsAdmin ? " z rolą Administratora." : ".");

                await LoadUsers();
            }
            else
            {
                modalError = error ?? "Wystąpił błąd podczas tworzenia użytkownika.";
            }
        }
        catch (Exception ex)
        {
            modalError = $"Wystąpił błąd: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void PromptToggleRole(AdminUserDTO user)
    {
        roleConfirmUser = user;
        roleConfirmIsAdmin = !user.IsAdmin;
    }

    private void CancelRoleChange()
    {
        if (isActionInProgress) return;
        roleConfirmUser = null;
    }

    private async Task ExecuteRoleChange()
    {
        if (roleConfirmUser == null || isActionInProgress) return;

        isActionInProgress = true;
        errorMessage = null;
        successMessage = null;

        var targetUser = roleConfirmUser;
        var newAdminState = roleConfirmIsAdmin;

        try
        {
            var (ok, error) = await adminApi.SetUserRoleAsync(targetUser.Id, newAdminState);
            if (ok)
            {
                roleConfirmUser = null;
                successMessage = newAdminState
                    ? $"Nadano rolę administratora użytkownikowi '{targetUser.UserName}'."
                    : $"Odebrano rolę administratora użytkownikowi '{targetUser.UserName}'.";
                await LoadUsers();
            }
            else
            {
                errorMessage = error ?? "Nie udało się zmienić roli użytkownika.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Wystąpił błąd: {ex.Message}";
        }
        finally
        {
            isActionInProgress = false;
        }
    }

    private async Task ToggleActive(AdminUserDTO user)
    {
        errorMessage = null;
        successMessage = null;
        isActionInProgress = true;

        try
        {
            var ok = await adminApi.SetUserActiveAsync(user.Id, !user.IsActive);
            if (ok)
            {
                successMessage = !user.IsActive
                    ? $"Odblokowano użytkownika '{user.UserName}'."
                    : $"Zablokowano użytkownika '{user.UserName}'.";
                await LoadUsers();
            }
            else
            {
                errorMessage = "Nie udało się zmienić statusu użytkownika.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Wystąpił błąd: {ex.Message}";
        }
        finally
        {
            isActionInProgress = false;
        }
    }
}
