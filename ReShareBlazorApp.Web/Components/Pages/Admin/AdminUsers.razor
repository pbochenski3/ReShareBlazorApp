private async Task ToggleActive(AdminUserDTO user)
{
message = null;

var newStatus = !user.IsActive;
var ok = await adminApi.SetUserActiveAsync(user.Id, newStatus);

if (ok)
{
user.IsActive = newStatus;

if (newStatus)
{
user.LockoutEnd = null;
}

message = $"Zmieniono status użytkownika '{user.UserName}' na: {(user.IsActive ? "aktywny" : "zablokowany")}.";
messageIsError = false;
}
else
{
message = "Nie udało się zmienić statusu użytkownika.";
messageIsError = true;
}
}

private void OpenWarnModal(AdminUserDTO user)
{
warnUser = user;

warnMessageText = !string.IsNullOrWhiteSpace(user.WarningMessage)
? user.WarningMessage
: "Twoje konto narusza zasady serwisu. W przypadku kolejnych naruszeń zostanie natychmiast zablokowane.";
}

private void CloseWarnModal()
{
warnUser = null;
}

private async Task ApplyWarning()
{
if (warnUser == null)
return;

message = null;

var text = string.IsNullOrWhiteSpace(warnMessageText)
? "Twoje konto narusza zasady serwisu. W przypadku kolejnych naruszeń zostanie natychmiast zablokowane."
: warnMessageText.Trim();

var ok = await adminApi.WarnUserAsync(warnUser.Id, text);

if (ok)
{
warnUser.WarningMessage = text;

message = $"Wysłano ostrzeżenie do użytkownika {warnUser.UserName}.";
messageIsError = false;

CloseWarnModal();
}
else
{
message = "Nie udało się zapisać ostrzeżenia.";
messageIsError = true;
}
}

private async Task ClearWarning(AdminUserDTO user)
{
message = null;

var ok = await adminApi.ClearWarningAsync(user.Id);

if (ok)
{
user.WarningMessage = null;

message = $"Usunięto ostrzeżenie użytkownika {user.UserName}.";
messageIsError = false;
}
else
{
message = "Nie udało się usunąć ostrzeżenia.";
messageIsError = true;
}
}

private string GetInitials(string? name)
{
if (string.IsNullOrWhiteSpace(name))
return "?";

return name[..Math.Min(2, name.Length)].ToUpperInvariant();
}