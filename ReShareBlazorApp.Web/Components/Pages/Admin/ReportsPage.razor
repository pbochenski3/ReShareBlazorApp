@page "/admin/reports"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Shared.Enums
@using ReShareBlazorApp.Web.ApiServices
@attribute [Authorize(Roles = "Admin")]
@inject ReportApiService reportApi

<h1 class="admin-title">Zgłoszenia</h1>

@if (!string.IsNullOrEmpty(message))
{
    <div class="admin-alert @(messageOk ? "admin-alert-ok" : "")">@message</div>
}

@if (isLoading)
{
    <p class="admin-muted">Ładowanie...</p>
}
else if (loadFailed)
{
    <div class="admin-alert">Nie udało się pobrać zgłoszeń. Sprawdź, czy API działa.</div>
}
else if (!reports.Any())
{
    <p class="admin-muted">Brak zgłoszeń.</p>
}
else
{
    <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin-bottom:16px;">
        <input class="admin-search"
               style="margin-bottom:0; max-width:320px;"
               placeholder="Szukaj po ogłoszeniu, zgłaszającym lub treści..."
               @bind="searchQuery"
               @bind:event="oninput" />

        <select class="admin-search"
                style="margin-bottom:0; max-width:200px;"
                @bind="statusFilter">
            <option value="all">Wszystkie statusy</option>
            <option value="pending">Oczekujące na odpowiedź</option>
            <option value="resolved">Odpowiedziano</option>
        </select>

        @if (!string.IsNullOrWhiteSpace(searchQuery) || statusFilter != "all")
        {
            <button type="button" class="admin-btn" @onclick="ClearFilters">
                Wyczyść filtry
            </button>
        }
    </div>

    <p class="admin-muted">
        Wyświetlane: <strong>@FilteredReports.Count()</strong> z @reports.Count. Kliknij zgłoszenie, aby je rozwinąć.
    </p>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Kategoria</th>
                    <th>Ogłoszenie</th>
                    <th>Zgłosił</th>
                    <th>Data</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in FilteredReports)
                {
                    var isOpen = expandedReportId == report.ReportId;

                    <tr class="admin-row-click @(isOpen ? "admin-row-open" : "")"
                        tabindex="0"
                        aria-expanded="@(isOpen ? "true" : "false")"
                        @onclick="() => ToggleReport(report.ReportId)"
                        @onkeydown="e => OnRowKeyDown(e, report.ReportId)">
                        <td>
                            @if (!string.IsNullOrEmpty(report.AdminResponse) || report.Status == ReportStatus.Resolved)
                            {
                                <span class="admin-badge admin-badge-ok">odpowiedziano</span>
                            }
                            else
                            {
                                <span class="admin-badge admin-badge-info">oczekujące</span>
                            }
                        </td>
                        <td><span class="admin-badge admin-badge-bad">@GetCategoryName(report.Category)</span></td>
                        <td>@report.ProductName</td>
                        <td>@report.ReportedBy</td>
                        <td>@report.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="admin-actions">@(isOpen ? "▲" : "▼")</td>
                    </tr>

                    @if (isOpen)
                    {
                        <tr class="admin-detail">
                            <td colspan="6" class="admin-detail-cell">

                                <div class="report-info-grid">
                                    <div>
                                        <span class="report-label">Zgłaszający</span>
                                        <strong>@report.ReportedBy</strong>
                                    </div>
                                    <div>
                                        <span class="report-label">Data zgłoszenia</span>
                                        <strong>@report.CreatedAt.ToString("dd.MM.yyyy HH:mm")</strong>
                                    </div>
                                    <div>
                                        <span class="report-label">Kategoria zgłoszenia</span>
                                        <strong>@GetCategoryName(report.Category)</strong>
                                    </div>
                                    <div>
                                        <span class="report-label">Autor ogłoszenia</span>
                                        <strong>@(string.IsNullOrWhiteSpace(report.ProductAddedBy) ? "-" : report.ProductAddedBy)</strong>
                                    </div>
                                </div>

                                <span class="report-label">Treść zgłoszenia</span>
                                <p class="report-description">@report.Description</p>

                                @if (!string.IsNullOrWhiteSpace(report.AdminResponse))
                                {
                                    <div style="margin-top:14px; margin-bottom:14px; padding:14px 18px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px;">
                                        <div style="font-weight:600; color:#166534; margin-bottom:6px; font-size:.9rem;">
                                            Odpowiedź administratora (@(report.AdminRespondedBy ?? "Administrator") &bull; @(report.AdminRespondedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")):
                                        </div>
                                        <p style="margin:0; color:#15803d; white-space:pre-wrap; line-height:1.5;">@report.AdminResponse</p>
                                    </div>
                                }

                                <!-- Formularz odesłania odpowiedzi do użytkownika -->
                                <div style="margin-top:16px; margin-bottom:18px; padding:16px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px;">
                                    <label style="display:block; font-weight:600; margin-bottom:6px; color:#1e293b;">
                                        @(string.IsNullOrWhiteSpace(report.AdminResponse) ? "✉ Odpowiedz użytkownikowi na to zgłoszenie:" : "✉ Zaktualizuj / prześlij kolejną odpowiedź do użytkownika:")
                                    </label>
                                    <textarea class="admin-search"
                                              style="width:100%; min-height:85px; margin-bottom:10px; resize:vertical; font-family:inherit; padding:10px 14px;"
                                              placeholder="Wpisz treść wiadomości, która zostanie wysłana do użytkownika w powiadomieniach..."
                                              value="@GetReplyText(report.ReportId)"
                                              @oninput="(e) => SetReplyText(report.ReportId, e.Value?.ToString() ?? string.Empty)">
                                    </textarea>
                                    <button type="button"
                                            class="admin-btn"
                                            style="background:#0f766e; color:#fff; font-weight:600; border:none; padding:8px 18px;"
                                            disabled="@(isBusy || string.IsNullOrWhiteSpace(GetReplyText(report.ReportId)))"
                                            @onclick="() => SendReply(report)">
                                        Odeślij odpowiedź użytkownikowi
                                    </button>
                                </div>

                                <div class="admin-detail-actions">
                                    <a class="admin-btn"
                                       href="@($"/details/{report.ProductId}")"
                                       target="_blank"
                                       rel="noopener">
                                        Zobacz ogłoszenie
                                    </a>

                                    <button type="button"
                                            class="admin-btn"
                                            disabled="@isBusy"
                                            @onclick="() => AskDismiss(report)">
                                        Usuń zgłoszenie (ogłoszenie zostaje)
                                    </button>

                                    <button type="button"
                                            class="admin-btn admin-btn-danger"
                                            disabled="@isBusy"
                                            @onclick="() => AskDeleteProduct(report)">
                                        Usuń ogłoszenie
                                    </button>
                                </div>

                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@if (pendingReport != null)
{
    <div class="confirm-backdrop" @onclick="CancelConfirm">
        <div class="confirm-modal"
             role="dialog"
             aria-modal="true"
             @onclick:stopPropagation="true">

            <h3>@(pendingDeleteProduct ? "Usunąć ogłoszenie?" : "Usunąć zgłoszenie?")</h3>

            @if (pendingDeleteProduct)
            {
                <p>
                    Ogłoszenie <strong>„@pendingReport.ProductName”</strong> zostanie trwale usunięte
                    razem ze wszystkimi zgłoszeniami tego ogłoszenia. Tej operacji nie można cofnąć.
                </p>
            }
            else
            {
                <p>
                    Zgłoszenie zostanie usunięte, a ogłoszenie
                    <strong>„@pendingReport.ProductName”</strong> zostanie na stronie.
                </p>
            }

            <div class="confirm-actions">
                <button type="button"
                        class="home-btn home-btn-outline"
                        disabled="@isBusy"
                        @onclick="CancelConfirm">
                    Anuluj
                </button>

                <button type="button"
                        class="home-btn @(pendingDeleteProduct ? "home-btn-danger" : "home-btn-primary")"
                        disabled="@isBusy"
                        @onclick="ConfirmAction">
                    @(pendingDeleteProduct ? "Usuń ogłoszenie" : "Usuń zgłoszenie")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ReportDTO> reports = new();
    private bool isLoading = true;
    private bool loadFailed;
    private bool isBusy;
    private int? expandedReportId;
    private ReportDTO? pendingReport;
    private bool pendingDeleteProduct;
    private string? message;
    private bool messageOk;

    private string searchQuery = "";
    private string statusFilter = "all";
    private Dictionary<int, string> replyInputs = new();

    private IEnumerable<ReportDTO> FilteredReports =>
        reports.Where(r =>
        {
            if (statusFilter == "pending" && (!string.IsNullOrEmpty(r.AdminResponse) || r.Status == ReportStatus.Resolved))
                return false;
            if (statusFilter == "resolved" && string.IsNullOrEmpty(r.AdminResponse) && r.Status != ReportStatus.Resolved)
                return false;

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim();
                var match = r.ProductName.Contains(q, StringComparison.OrdinalIgnoreCase)
                            || r.ReportedBy.Contains(q, StringComparison.OrdinalIgnoreCase)
                            || r.Description.Contains(q, StringComparison.OrdinalIgnoreCase);
                if (!match) return false;
            }

            return true;
        });

    private void ClearFilters()
    {
        searchQuery = "";
        statusFilter = "all";
    }

    private string GetReplyText(int reportId) =>
        replyInputs.TryGetValue(reportId, out var val) ? val : "";

    private void SetReplyText(int reportId, string val) =>
        replyInputs[reportId] = val;

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async Task LoadReports()
    {
        var result = await reportApi.GetReportsAsync();
        loadFailed = result == null;
        reports = result ?? new List<ReportDTO>();
        isLoading = false;
    }

    private void ToggleReport(int reportId)
    {
        expandedReportId = expandedReportId == reportId ? null : reportId;
    }

    private void OnRowKeyDown(KeyboardEventArgs e, int reportId)
    {
        if (e.Key == "Enter")
            ToggleReport(reportId);
    }

    private async Task SendReply(ReportDTO report)
    {
        var replyText = GetReplyText(report.ReportId).Trim();
        if (string.IsNullOrWhiteSpace(replyText))
            return;

        isBusy = true;
        message = null;

        var success = await reportApi.ReplyToReportAsync(report.ReportId, replyText);
        isBusy = false;

        if (success)
        {
            report.AdminResponse = replyText;
            report.AdminRespondedAt = DateTime.UtcNow;
            report.Status = ReportStatus.Resolved;
            replyInputs.Remove(report.ReportId);
            SetMessage($"Odpowiedź do użytkownika {report.ReportedBy} została pomyślnie wysłana.", true);
        }
        else
        {
            SetMessage("Nie udało się wysłać odpowiedzi. Upewnij się, że API działa.", false);
        }
    }

    private void AskDismiss(ReportDTO report)
    {
        pendingReport = report;
        pendingDeleteProduct = false;
    }

    private void AskDeleteProduct(ReportDTO report)
    {
        pendingReport = report;
        pendingDeleteProduct = true;
    }

    private void CancelConfirm()
    {
        if (isBusy)
            return;
        pendingReport = null;
    }

    private async Task ConfirmAction()
    {
        if (pendingReport == null)
            return;

        if (pendingDeleteProduct)
            await DeleteProduct(pendingReport);
        else
            await DismissReport(pendingReport);

        pendingReport = null;
    }

    private async Task DismissReport(ReportDTO report)
    {
        isBusy = true;
        var result = await reportApi.DeleteReportAsync(report.ReportId);
        isBusy = false;

        if (result)
        {
            SetMessage("Zgłoszenie zostało usunięte.", true);
            expandedReportId = null;
            await LoadReports();
        }
        else
        {
            SetMessage("Nie udało się usunąć zgłoszenia.", false);
        }
    }

    private async Task DeleteProduct(ReportDTO report)
    {
        isBusy = true;
        var result = await reportApi.DeleteReportedProductAsync(report.ReportId);
        isBusy = false;

        if (result)
        {
            SetMessage("Ogłoszenie zostało usunięte.", true);
            expandedReportId = null;
            await LoadReports();
        }
        else
        {
            SetMessage("Nie udało się usunąć ogłoszenia.", false);
        }
    }

    private void SetMessage(string text, bool ok)
    {
        message = text;
        messageOk = ok;
    }

    private string GetCategoryName(ReportCategory category)
    {
        return category switch
        {
            ReportCategory.Spam => "Spam lub reklama",
            ReportCategory.Fraud => "Oszustwo",
            ReportCategory.Inappropriate => "Nieodpowiednia treść",
            ReportCategory.Prohibited => "Zabroniony przedmiot lub usługa",
            ReportCategory.Duplicate => "Duplikat ogłoszenia",
            ReportCategory.Other => "Inne",
            _ => category.ToString()
        };
    }
}
