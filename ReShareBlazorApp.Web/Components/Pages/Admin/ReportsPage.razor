@page "/admin/reports"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Shared.Enums
@using ReShareBlazorApp.Web.ApiServices
@attribute [Authorize(Roles = "Admin")]
@inject ReportApiService reportApi

<h1 class="admin-title">Zgłoszenia</h1>

@if (!string.IsNullOrEmpty(message))
{
    <div class="admin-alert @(messageOk ? "admin-alert-ok" : "")">@message</div>
}

@if (isLoading)
{
    <p class="admin-muted">Ładowanie...</p>
}
else if (loadFailed)
{
    <div class="admin-alert">Nie udało się pobrać zgłoszeń. Sprawdź, czy API działa.</div>
}
else if (!reports.Any())
{
    <p class="admin-muted">Brak zgłoszeń.</p>
}
else
{
    <p class="admin-muted">Liczba zgłoszeń: @reports.Count. Kliknij zgłoszenie, aby je rozwinąć.</p>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Kategoria</th>
                    <th>Ogłoszenie</th>
                    <th>Zgłosił</th>
                    <th>Data</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in reports)
                {
                    var isOpen = expandedReportId == report.ReportId;

                    <tr class="admin-row-click @(isOpen ? "admin-row-open" : "")"
                        tabindex="0"
                        aria-expanded="@(isOpen ? "true" : "false")"
                        @onclick="() => ToggleReportAsync(report.ReportId)"
                        @onkeydown="e => OnRowKeyDownAsync(e, report.ReportId)">
                        <td><span class="admin-badge admin-badge-bad">@GetCategoryName(report.Category)</span></td>
                        <td>@report.ProductName</td>
                        <td>@report.ReportedBy</td>
                        <td>@report.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="admin-actions">@(isOpen ? "▲" : "▼")</td>
                    </tr>

                    @if (isOpen)
                    {
                        <tr class="admin-detail">
                            <td colspan="5" class="admin-detail-cell">

                                <div class="report-info-grid">
                                    <div>
                                        <span class="report-label">Zgłaszający</span>
                                        <strong>@report.ReportedBy</strong>
                                    </div>
                                    <div>
                                        <span class="report-label">Data zgłoszenia</span>
                                        <strong>@report.CreatedAt.ToString("dd.MM.yyyy HH:mm")</strong>
                                    </div>
                                    <div>
                                        <span class="report-label">Kategoria zgłoszenia</span>
                                        <strong>@GetCategoryName(report.Category)</strong>
                                    </div>
                                    <div>
                                        <span class="report-label">Autor ogłoszenia</span>
                                        <strong>@(string.IsNullOrWhiteSpace(report.ProductAddedBy) ? "-" : report.ProductAddedBy)</strong>
                                    </div>
                                </div>

                                <span class="report-label">Treść zgłoszenia</span>
                                <p class="report-description">@report.Description</p>

                                <div class="admin-detail-actions">
                                    <a class="admin-btn"
                                       href="@($"/details/{report.ProductId}")"
                                       target="_blank"
                                       rel="noopener">
                                        Zobacz ogłoszenie
                                    </a>

                                    <button type="button"
                                            class="admin-btn"
                                            disabled="@isBusy"
                                            @onclick="() => AskDismiss(report)">
                                        Usuń zgłoszenie (ogłoszenie zostaje)
                                    </button>

                                    <button type="button"
                                            class="admin-btn admin-btn-danger"
                                            disabled="@isBusy"
                                            @onclick="() => AskDeleteProduct(report)">
                                        Usuń ogłoszenie
                                    </button>
                                </div>

                                <div class="admin-reply-section">
                                    <h3>Kontakt z uczestnikami zgłoszenia (czat SignalR)</h3>

                                    @if (isLoadingThreads)
                                    {
                                        <p class="admin-muted">Ładowanie historii wiadomości...</p>
                                    }
                                    else if (activeThreads is not null)
                                    {
                                        @if (activeThreads.Messages.Count > 0)
                                        {
                                            <div class="admin-thread-list">
                                                @foreach (var msg in activeThreads.Messages)
                                                {
                                                    <div class="admin-thread-item @(msg.IsAdminMessage ? "is-admin" : "is-user")">
                                                        <div class="admin-thread-meta">
                                                            <strong>@msg.SenderName → @msg.RecipientName</strong>
                                                            <span>@msg.SentAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                                        </div>
                                                        <p>@msg.Content</p>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="admin-muted" style="margin:0;">Brak wysłanych wiadomości w sprawie tego zgłoszenia.</p>
                                        }

                                        @if (!string.IsNullOrEmpty(replyStatus))
                                        {
                                            <div class="admin-alert @(replyStatusOk ? "admin-alert-ok" : "")" style="margin-top:10px;">
                                                @replyStatus
                                            </div>
                                        }

                                        <div class="admin-form-group" style="margin-top:12px;">
                                            <label class="admin-form-label">Odbiorca wiadomości</label>
                                            <select class="admin-form-select" @bind="replyTarget">
                                                <option value="@AdminReportReplyTarget.Reporter">
                                                    Zgłaszający: @activeThreads.ReporterUserName
                                                </option>
                                                <option value="@AdminReportReplyTarget.ProductOwner">
                                                    Autor ogłoszenia: @activeThreads.ProductOwnerUserName
                                                </option>
                                            </select>
                                        </div>

                                        <div class="admin-form-group" style="margin-top:10px;">
                                            <label class="admin-form-label" for="@($"report-reply-{report.ReportId}")">Treść wiadomości</label>
                                            <textarea id="@($"report-reply-{report.ReportId}")"
                                                      class="admin-form-textarea"
                                                      rows="3"
                                                      maxlength="2000"
                                                      placeholder="Napisz wiadomość do wybranego użytkownika (dostarczana na żywo przez SignalR)..."
                                                      @bind="replyText"></textarea>
                                        </div>

                                        <div style="margin-top:10px;">
                                            <button type="button"
                                                    class="admin-btn admin-btn-primary"
                                                    disabled="@(isReplying || string.IsNullOrWhiteSpace(replyText))"
                                                    @onclick="() => SendReportReplyAsync(report.ReportId)">
                                                @(isReplying ? "Wysyłanie..." : "Wyślij wiadomość")
                                            </button>
                                        </div>
                                    }
                                </div>

                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@if (pendingReport != null)
{
    <div class="confirm-backdrop" @onclick="CancelConfirm">
        <div class="confirm-modal"
             role="dialog"
             aria-modal="true"
             @onclick:stopPropagation="true">

            <h3>@(pendingDeleteProduct ? "Usunąć ogłoszenie?" : "Usunąć zgłoszenie?")</h3>

            @if (pendingDeleteProduct)
            {
                <p>
                    Ogłoszenie <strong>„@pendingReport.ProductName”</strong> zostanie trwale usunięte
                    razem ze wszystkimi zgłoszeniami tego ogłoszenia. Tej operacji nie można cofnąć.
                </p>
            }
            else
            {
                <p>
                    Zgłoszenie zostanie usunięte, a ogłoszenie
                    <strong>„@pendingReport.ProductName”</strong> zostanie na stronie.
                </p>
            }

            <div class="confirm-actions">
                <button type="button"
                        class="home-btn home-btn-outline"
                        disabled="@isBusy"
                        @onclick="CancelConfirm">
                    Anuluj
                </button>

                <button type="button"
                        class="home-btn @(pendingDeleteProduct ? "home-btn-danger" : "home-btn-primary")"
                        disabled="@isBusy"
                        @onclick="ConfirmAction">
                    @(pendingDeleteProduct ? "Usuń ogłoszenie" : "Usuń zgłoszenie")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ReportDTO> reports = new();
    private bool isLoading = true;
    private bool loadFailed;
    private bool isBusy;
    private int? expandedReportId;
    private ReportDTO? pendingReport;
    private bool pendingDeleteProduct;
    private string? message;
    private bool messageOk;

    private AdminReportThreadsDTO? activeThreads;
    private bool isLoadingThreads;
    private AdminReportReplyTarget replyTarget = AdminReportReplyTarget.Reporter;
    private string replyText = "";
    private bool isReplying;
    private string? replyStatus;
    private bool replyStatusOk;

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async Task LoadReports()
    {
        var result = await reportApi.GetReportsAsync();
        loadFailed = result == null;
        reports = result ?? new List<ReportDTO>();
        isLoading = false;
    }

    private async Task ToggleReportAsync(int reportId)
    {
        if (expandedReportId == reportId)
        {
            expandedReportId = null;
            activeThreads = null;
            replyStatus = null;
            return;
        }

        expandedReportId = reportId;
        replyText = "";
        replyStatus = null;
        replyTarget = AdminReportReplyTarget.Reporter;
        isLoadingThreads = true;
        try
        {
            activeThreads = await reportApi.GetReportThreadsAsync(reportId);
        }
        finally
        {
            isLoadingThreads = false;
        }
    }

    private async Task OnRowKeyDownAsync(KeyboardEventArgs e, int reportId)
    {
        if (e.Key == "Enter")
            await ToggleReportAsync(reportId);
    }

    private async Task SendReportReplyAsync(int reportId)
    {
        if (isReplying || string.IsNullOrWhiteSpace(replyText))
            return;

        isReplying = true;
        replyStatus = null;
        try
        {
            var res = await reportApi.ReplyToReportAsync(reportId, new AdminReportReplyRequest
            {
                Target = replyTarget,
                Message = replyText.Trim()
            });

            if (res.Success)
            {
                if (res.Message is not null && activeThreads is not null)
                    activeThreads.Messages.Add(res.Message);

                replyText = "";
                replyStatusOk = true;
                replyStatus = "Wiadomość została wysłana na żywo przez SignalR i zapisana w szyfrowanych logach.";
            }
            else
            {
                replyStatusOk = false;
                replyStatus = res.ErrorMessage ?? "Nie udało się wysłać wiadomości.";
            }
        }
        finally
        {
            isReplying = false;
        }
    }

    private void AskDismiss(ReportDTO report)
    {
        pendingReport = report;
        pendingDeleteProduct = false;
    }

    private void AskDeleteProduct(ReportDTO report)
    {
        pendingReport = report;
        pendingDeleteProduct = true;
    }

    private void CancelConfirm()
    {
        if (isBusy)
            return;
        pendingReport = null;
    }

    private async Task ConfirmAction()
    {
        if (pendingReport == null)
            return;

        if (pendingDeleteProduct)
            await DeleteProduct(pendingReport);
        else
            await DismissReport(pendingReport);

        pendingReport = null;
    }

    private async Task DismissReport(ReportDTO report)
    {
        isBusy = true;
        var result = await reportApi.DeleteReportAsync(report.ReportId);
        isBusy = false;

        if (result)
        {
            SetMessage("Zgłoszenie zostało usunięte.", true);
            expandedReportId = null;
            activeThreads = null;
            await LoadReports();
        }
        else
        {
            SetMessage("Nie udało się usunąć zgłoszenia.", false);
        }
    }

    private async Task DeleteProduct(ReportDTO report)
    {
        isBusy = true;
        var result = await reportApi.DeleteReportedProductAsync(report.ReportId);
        isBusy = false;

        if (result)
        {
            SetMessage("Ogłoszenie zostało usunięte.", true);
            expandedReportId = null;
            activeThreads = null;
            await LoadReports();
        }
        else
        {
            SetMessage("Nie udało się usunąć ogłoszenia.", false);
        }
    }

    private void SetMessage(string text, bool ok)
    {
        message = text;
        messageOk = ok;
    }

    private string GetCategoryName(ReportCategory category)
    {
        return category switch
        {
            ReportCategory.Spam => "Spam lub reklama",
            ReportCategory.Fraud => "Oszustwo",
            ReportCategory.Inappropriate => "Nieodpowiednia treść",
            ReportCategory.Prohibited => "Zabroniony przedmiot lub usługa",
            ReportCategory.Duplicate => "Duplikat ogłoszenia",
            ReportCategory.Other => "Inne",
            _ => category.ToString()
        };
    }
}
