@page "/admin/reports"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Shared.Enums
@using ReShareBlazorApp.Web.ApiServices
@attribute [Authorize(Roles = "Admin")]
@inject ReportApiService reportApi
@inject ReShareBlazorApp.Web.ApiServices.MessageApiService messageApi

<h1 class="admin-title">Zgłoszenia</h1>

@if (!string.IsNullOrEmpty(message))
{
    <div class="admin-alert @(messageOk ? "admin-alert-ok" : "")">@message</div>
}

@if (isLoading)
{
    <p class="admin-muted">Ładowanie...</p>
}
else if (loadFailed)
{
    <div class="admin-alert">Nie udało się pobrać zgłoszeń. Sprawdź, czy API działa.</div>
}
else if (!reports.Any())
{
    <p class="admin-muted">Brak zgłoszeń.</p>
}
else
{
    <p class="admin-muted">Liczba zgłoszeń: @reports.Count. Kliknij zgłoszenie, aby je rozwinąć.</p>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Kategoria</th>
                    <th>Ogłoszenie</th>
                    <th>Zgłosił</th>
                    <th>Data</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in reports)
                {
                    var isOpen = expandedReportId == report.ReportId;

                    <tr class="admin-row-click @(isOpen ? "admin-row-open" : "")"
                        tabindex="0"
                        aria-expanded="@(isOpen ? "true" : "false")"
                        @onclick="() => ToggleReport(report.ReportId)"
                        @onkeydown="e => OnRowKeyDown(e, report.ReportId)">
                        <td><span class="admin-badge admin-badge-bad">@GetCategoryName(report.Category)</span></td>
                        <td>@report.ProductName</td>
                        <td>@report.ReportedBy</td>
                        <td>@report.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="admin-actions">@(isOpen ? "▲" : "▼")</td>
                    </tr>

                    @if (isOpen)
                    {
                        <tr class="admin-detail">
                            <td colspan="5" class="admin-detail-cell">

                                <div class="report-info-grid">
                                    <div>
                                        <span class="report-label">Zgłaszający</span>
                                        <strong>@report.ReportedBy</strong>
                                    </div>
                                    <div>
                                        <span class="report-label">Data zgłoszenia</span>
                                        <strong>@report.CreatedAt.ToString("dd.MM.yyyy HH:mm")</strong>
                                    </div>
                                    <div>
                                        <span class="report-label">Kategoria zgłoszenia</span>
                                        <strong>@GetCategoryName(report.Category)</strong>
                                    </div>
                                    <div>
                                        <span class="report-label">Autor ogłoszenia</span>
                                        <strong>@(string.IsNullOrWhiteSpace(report.ProductAddedBy) ? "-" : report.ProductAddedBy)</strong>
                                    </div>
                                </div>

                                <span class="report-label">Treść zgłoszenia</span>
                                <p class="report-description">@report.Description</p>

                                <div class="admin-detail-actions">
                                    <a class="admin-btn"
                                       href="@($"/details/{report.ProductId}")"
                                       target="_blank"
                                       rel="noopener">
                                        Zobacz ogłoszenie
                                    </a>

                                    <button type="button"
                                            class="admin-btn"
                                            disabled="@isBusy"
                                            @onclick="() => OpenMessageBox(report)">
                                        ✉ Napisz do zgłaszającego
                                    </button>

                                    <button type="button"
                                            class="admin-btn"
                                            disabled="@isBusy"
                                            @onclick="() => AskDismiss(report)">
                                        Usuń zgłoszenie (ogłoszenie zostaje)
                                    </button>

                                    <button type="button"
                                            class="admin-btn admin-btn-danger"
                                            disabled="@isBusy"
                                            @onclick="() => AskDeleteProduct(report)">
                                        Usuń ogłoszenie
                                    </button>
                                </div>

                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@if (messagingReport != null)
{
    <div class="confirm-backdrop" @onclick="CloseMessageBox">
        <div class="confirm-modal"
             role="dialog"
             aria-modal="true"
             @onclick:stopPropagation="true">

            <h3>Napisz do zgłaszającego</h3>
            <p>
                Wiadomość trafi do użytkownika <strong>@messagingReport.ReportedBy</strong> na czacie,
                w sekcji „Wiadomości”, jako wiadomość od <strong>Support</strong>.
                Dotyczy zgłoszenia ogłoszenia <strong>„@messagingReport.ProductName”</strong>.
            </p>

            @if (!string.IsNullOrEmpty(messageError))
            {
                <div class="admin-alert">@messageError</div>
            }
            @if (!string.IsNullOrEmpty(messageSuccess))
            {
                <div class="admin-alert admin-alert-ok">@messageSuccess</div>
            }

            <textarea class="product-input"
                      rows="5"
                      maxlength="2000"
                      placeholder="Treść wiadomości do zgłaszającego..."
                      disabled="@messageSending"
                      @bind="messageContent"></textarea>

            <div class="confirm-actions">
                <button type="button"
                        class="home-btn home-btn-outline"
                        disabled="@messageSending"
                        @onclick="CloseMessageBox">
                    Zamknij
                </button>

                <button type="button"
                        class="home-btn home-btn-primary"
                        disabled="@messageSending"
                        @onclick="SendMessageToReporterAsync">
                    @(messageSending ? "Wysyłanie..." : "Wyślij wiadomość")
                </button>
            </div>
        </div>
    </div>
}

@if (pendingReport != null)
{
    <div class="confirm-backdrop" @onclick="CancelConfirm">
        <div class="confirm-modal"
             role="dialog"
             aria-modal="true"
             @onclick:stopPropagation="true">

            <h3>@(pendingDeleteProduct ? "Usunąć ogłoszenie?" : "Usunąć zgłoszenie?")</h3>

            @if (pendingDeleteProduct)
            {
                <p>
                    Ogłoszenie <strong>„@pendingReport.ProductName”</strong> zostanie trwale usunięte
                    razem ze wszystkimi zgłoszeniami tego ogłoszenia. Tej operacji nie można cofnąć.
                </p>
            }
            else
            {
                <p>
                    Zgłoszenie zostanie usunięte, a ogłoszenie
                    <strong>„@pendingReport.ProductName”</strong> zostanie na stronie.
                </p>
            }

            <div class="confirm-actions">
                <button type="button"
                        class="home-btn home-btn-outline"
                        disabled="@isBusy"
                        @onclick="CancelConfirm">
                    Anuluj
                </button>

                <button type="button"
                        class="home-btn @(pendingDeleteProduct ? "home-btn-danger" : "home-btn-primary")"
                        disabled="@isBusy"
                        @onclick="ConfirmAction">
                    @(pendingDeleteProduct ? "Usuń ogłoszenie" : "Usuń zgłoszenie")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ReportDTO> reports = new();
    private bool isLoading = true;
    private bool loadFailed;
    private bool isBusy;
    private int? expandedReportId;
    private ReportDTO? pendingReport;
    private bool pendingDeleteProduct;
    private string? message;
    private bool messageOk;

    private ReportDTO? messagingReport;
    private string messageContent = "";
    private bool messageSending;
    private string? messageError;
    private string? messageSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async Task LoadReports()
    {
        var result = await reportApi.GetReportsAsync();
        loadFailed = result == null;
        reports = result ?? new List<ReportDTO>();
        isLoading = false;
    }

    private void ToggleReport(int reportId)
    {
        expandedReportId = expandedReportId == reportId ? null : reportId;
    }

    private void OnRowKeyDown(KeyboardEventArgs e, int reportId)
    {
        if (e.Key == "Enter")
            ToggleReport(reportId);
    }

    private void AskDismiss(ReportDTO report)
    {
        pendingReport = report;
        pendingDeleteProduct = false;
    }

    private void AskDeleteProduct(ReportDTO report)
    {
        pendingReport = report;
        pendingDeleteProduct = true;
    }

    private void CancelConfirm()
    {
        if (isBusy)
            return;
        pendingReport = null;
    }

    private void OpenMessageBox(ReportDTO report)
    {
        messagingReport = report;
        messageContent = "";
        messageError = null;
        messageSuccess = null;
    }

    private void CloseMessageBox()
    {
        if (messageSending)
            return;
        messagingReport = null;
    }

    private async Task SendMessageToReporterAsync()
    {
        if (messagingReport is null)
            return;

        if (string.IsNullOrWhiteSpace(messageContent))
        {
            messageError = "Wpisz treść wiadomości.";
            return;
        }

        messageSending = true;
        messageError = null;
        messageSuccess = null;

        var conversation = await messageApi.StartSupportConversationAsync(
            messagingReport.ReportId, messageContent.Trim());

        messageSending = false;

        if (conversation is null)
        {
            messageError = "Nie udało się wysłać wiadomości. Spróbuj ponownie.";
            return;
        }

        messageSuccess = "Wiadomość została wysłana.";
        messageContent = "";
    }

    private async Task ConfirmAction()
    {
        if (pendingReport == null)
            return;

        if (pendingDeleteProduct)
            await DeleteProduct(pendingReport);
        else
            await DismissReport(pendingReport);

        pendingReport = null;
    }

    private async Task DismissReport(ReportDTO report)
    {
        isBusy = true;
        var result = await reportApi.DeleteReportAsync(report.ReportId);
        isBusy = false;

        if (result)
        {
            SetMessage("Zgłoszenie zostało usunięte.", true);
            expandedReportId = null;
            await LoadReports();
        }
        else
        {
            SetMessage("Nie udało się usunąć zgłoszenia.", false);
        }
    }

    private async Task DeleteProduct(ReportDTO report)
    {
        isBusy = true;
        var result = await reportApi.DeleteReportedProductAsync(report.ReportId);
        isBusy = false;

        if (result)
        {
            SetMessage("Ogłoszenie zostało usunięte.", true);
            expandedReportId = null;
            await LoadReports();
        }
        else
        {
            SetMessage("Nie udało się usunąć ogłoszenia.", false);
        }
    }

    private void SetMessage(string text, bool ok)
    {
        message = text;
        messageOk = ok;
    }

    private string GetCategoryName(ReportCategory category)
    {
        return category switch
        {
            ReportCategory.Spam => "Spam lub reklama",
            ReportCategory.Fraud => "Oszustwo",
            ReportCategory.Inappropriate => "Nieodpowiednia treść",
            ReportCategory.Prohibited => "Zabroniony przedmiot lub usługa",
            ReportCategory.Duplicate => "Duplikat ogłoszenia",
            ReportCategory.Other => "Inne",
            _ => category.ToString()
        };
    }
}
