@page "/zglos-naduzycie"
@using ReShareBlazorApp.Web.ApiServices
@using ReShareBlazorApp.Web.Components.Elements
@rendermode InteractiveServer
@inject NotificationService notify
@inject IJSRuntime JS

<PageTitle>Zgłaszanie nadużyć – ODDAJ DALEJ</PageTitle>

<div class="legal-page">
    <header class="legal-hero">
        <div class="home-container">
            <span class="legal-hero-badge">Bezpieczeństwo i prawo</span>
            <h1 class="legal-hero-title">Zgłaszanie Nadużyć i Naruszeń</h1>
            <p class="legal-hero-subtitle">
                Dbamy o to, by ODDAJ DALEJ było bezpieczną, uczciwą platformą wolną od oszustw i spekulacji.
                Jeśli zauważyłeś podejrzane ogłoszenie, zawyżoną cenę biletu lub nieuczciwego użytkownika – zgłoś to nam.
            </p>
            <div class="legal-hero-meta">
                <span class="legal-hero-meta-item">🛡️ Moderacja Notice & Action (DSA)</span>
                <span class="legal-hero-meta-item">⚡ Średni czas reakcji: do 24h</span>
                <span class="legal-hero-meta-item">🔒 Pełna poufność zgłoszeń</span>
            </div>
        </div>
    </header>

    <LegalNav ActiveRoute="/zglos-naduzycie" CurrentTitle="Zgłaszanie nadużyć" />

    <section class="legal-body">
        <div class="home-container">
            <div class="legal-grid">

                <main class="legal-main">
                    <!-- Nagłówek widoczny na wydruku / PDF -->
                    <div class="legal-print-banner">
                        <div class="legal-print-brand">
                            <strong>ODDAJ DALEJ</strong>
                            <span>Platforma wymiany i bezpiecznego przekazywania rezerwacji</span>
                        </div>
                        <div class="legal-print-doc-info">
                            Procedura Zgłaszania Nadużyć i Bezpieczeństwa<br />
                            Obowiązuje od: 18 listopada 2026 r.
                        </div>
                    </div>

                    @if (isSubmitted)
                    {
                        <div class="abuse-success-box">
                            <div class="abuse-success-icon">✅</div>
                            <h2>Zgłoszenie zostało pomyślnie przyjęte!</h2>
                            <p>
                                Dziękujemy za pomoc w dbaniu o bezpieczeństwo społeczności ODDAJ DALEJ.
                                Twoje zgłoszenie zostało zarejestrowane w naszym systemie moderacji pod numerem:
                            </p>
                            <div class="abuse-success-number">@reportNumber</div>
                            <p style="font-size:0.92rem; color:#15803d; max-width:540px; margin: 0 auto 20px;">
                                Zespół moderacji zweryfikuje ogłoszenie najszybciej jak to możliwe (standardowo w ciągu kilku godzin,
                                maksymalnie do 24 godzin). W razie potrzeby skontaktujemy się z Tobą na adres: <strong>@reporterEmail</strong>.
                            </p>
                            <button type="button" class="home-btn home-btn-primary" @onclick="ResetForm">
                                Zgłoś kolejne nadużycie
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="abuse-form-card" id="formularz">
                            <h2 style="margin-top:0; margin-bottom:8px; font-size:1.45rem;">
                                Formularz zgłoszenia incydentu
                            </h2>
                            <p style="color:var(--muted); font-size:0.92rem; margin-bottom:24px;">
                                Wypełnij poniższy formularz. Każde zgłoszenie jest analizowane indywidualnie przez nasz zespół bezpieczeństwa.
                            </p>

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="legal-callout legal-callout-danger" style="margin-top:0;">
                                    <span class="legal-callout-icon">⚠️</span>
                                    <div>@errorMessage</div>
                                </div>
                            }

                            <!-- 1. Wybór powodu -->
                            <div class="abuse-field">
                                <label>1. Wybierz powód zgłoszenia *</label>
                                <small>Wskaż rodzaj naruszenia, które najlepiej opisuje problem:</small>
                            </div>

                            <div class="abuse-reasons-grid">
                                @foreach (var reason in reasonsList)
                                {
                                    <div class="abuse-reason-option @(selectedReason == reason.Key ? "selected" : "")"
                                         @onclick="() => SelectReason(reason.Key)">
                                        <span style="font-size:1.3rem; line-height:1;">@reason.Icon</span>
                                        <div>
                                            <div class="abuse-reason-title">@reason.Title</div>
                                            <div class="abuse-reason-desc">@reason.Description</div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- 2. Link lub identyfikator ogłoszenia -->
                            <div class="abuse-field">
                                <label for="listingRef">2. Link lub ID ogłoszenia / nazwa użytkownika *</label>
                                <input id="listingRef"
                                       type="text"
                                       @bind="listingRef"
                                       placeholder="np. https://oddajdalej.pl/details/14 lub ID: 14" />
                                <small>Wklej adres z paska przeglądarki lub podaj numer/tytuł zgłaszanego ogłoszenia.</small>
                            </div>

                            <!-- 3. Adres e-mail zgłaszającego -->
                            <div class="abuse-field">
                                <label for="reporterEmail">3. Twój adres e-mail do kontaktu *</label>
                                <input id="reporterEmail"
                                       type="email"
                                       @bind="reporterEmail"
                                       placeholder="twoj-email@domena.pl" />
                                <small>Potrzebny do przesłania potwierdzenia i wyniku weryfikacji zgłoszenia.</small>
                            </div>

                            <!-- 4. Opis sytuacji -->
                            <div class="abuse-field">
                                <label for="description">4. Szczegółowy opis sytuacji *</label>
                                <textarea id="description"
                                          rows="5"
                                          @bind="description"
                                          placeholder="Opisz dokładnie, dlaczego zgłaszasz to ogłoszenie (np. próba wyłudzenia przelewu, zawyżona cena biletu, nielegalny przedmiot)..."></textarea>
                                <small>Im dokładniejszy opis, tym szybciej i skuteczniej nasz zespół podejmie działania.</small>
                            </div>

                            <!-- 5. Oświadczenie -->
                            <label class="abuse-checkbox-label">
                                <input type="checkbox" @bind="declarationChecked" />
                                <span>
                                    Oświadczam, że powyższe zgłoszenie składam w dobrej wierze i podane informacje
                                    są zgodne z prawdą według mojej najlepszej wiedzy.
                                </span>
                            </label>

                            <!-- Przycisk wysłania -->
                            <button type="button"
                                    class="home-btn home-btn-primary"
                                    style="width:100%; font-size:1.05rem; padding:13px;"
                                    @onclick="SubmitReport">
                                🚨 Wyślij zgłoszenie do moderacji
                            </button>
                        </div>
                    }

                    <article class="legal-article">
                        <h2 id="kiedy-zglosic">Kiedy należy niezwłocznie zgłosić ofertę?</h2>
                        <p>
                            Reaguj natychmiast, gdy zauważysz którąkolwiek z poniższych sytuacji:
                        </p>
                        <ul>
                            <li><strong>Próby oszustwa:</strong> Sprzedający żąda wpłaty zaliczki poza platformą, przesyła podejrzane linki do płatności kurierskich lub wyłudza dane kart bankowych.</li>
                            <li><strong>Konikowanie (spekulacja cenowa):</strong> Cena biletu w ogłoszeniu przewyższa cenę nominalną wydrukowaną na bilecie.</li>
                            <li><strong>Fałszywe wejściówki:</strong> Oferowany bilet budzi wątpliwości autentyczności, jest zduplikowany lub pochodzi z podejrzanego źródła.</li>
                            <li><strong>Brak możliwości cesji:</strong> Bilet jest imienny, a regulamin wydarzenia uniemożliwia legalną zmianę danych uczestnika.</li>
                            <li><strong>Naruszenie godności lub prawa:</strong> Treści wulgarne, obraźliwe, hejt lub próby zastraszania na czacie.</li>
                        </ul>

                        <div class="legal-callout legal-callout-warn">
                            <span class="legal-callout-icon">🛡️</span>
                            <div>
                                <strong>Co dzieje się po zgłoszeniu?</strong>
                                Zgłoszone ogłoszenie trafia do kolejki weryfikacyjnej zespołu bezpieczeństwa. W przypadku stwierdzenia
                                naruszenia regulaminu, ogłoszenie jest natychmiast ukrywane lub trwale usuwane, a wobec użytkownika
                                wyciągane są konsekwencje (upomnienie, czasowa blokada lub permanentne usunięcie konta).
                            </div>
                        </div>

                        <div class="legal-print-footer">
                            Dokument wygenerowany z serwisu ODDAJ DALEJ (oddajdalej.pl) · Wszelkie prawa zastrzeżone
                        </div>
                    </article>
                </main>

                <aside class="legal-sidebar">
                    <div class="legal-sidebar-card">
                        <div class="legal-sidebar-title">
                            <span>🛡️</span> Zasady bezpieczeństwa
                        </div>
                        <p style="font-size:0.86rem; color:var(--muted); line-height:1.5; margin-bottom:12px;">
                            Pamiętaj o podstawowych zasadach bezpieczeństwa przy każdej transakcji:
                        </p>
                        <ul style="font-size:0.84rem; padding-left:18px; margin:0; color:#334155; line-height:1.6;">
                            <li>Nigdy nie klikaj w linki do płatności wysyłane w wiadomościach prywatnych.</li>
                            <li>Weryfikuj autentyczność biletu przed realizacją płatności.</li>
                            <li>Przy biletach imiennych wymagaj oficjalnej zmiany danych u organizatora.</li>
                            <li>Preferuj odbiór osobisty lub sprawdzone systemy depozytowe.</li>
                        </ul>
                    </div>

                    <div class="legal-sidebar-card">
                        <div class="legal-sidebar-title">
                            <span>📑</span> Szybka nawigacja
                        </div>
                        <ul class="legal-toc-list">
                            <li><button type="button" class="legal-toc-link @(activeSection == "formularz" ? "active" : "")" @onclick='() => ScrollToSection("formularz")'>📝 Formularz zgłoszenia</button></li>
                            <li><button type="button" class="legal-toc-link @(activeSection == "kiedy-zglosic" ? "active" : "")" @onclick='() => ScrollToSection("kiedy-zglosic")'>⚠️ Kiedy zgłaszać ofertę?</button></li>
                        </ul>
                    </div>

                    <div class="legal-sidebar-card">
                        <div class="legal-sidebar-title">
                            <span>⚖️</span> Związane dokumenty
                        </div>
                        <ul class="legal-toc-list">
                            <li><a href="/zasady-publikowania" class="legal-toc-link">📋 Zasady publikowania ogłoszeń</a></li>
                            <li><a href="/regulamin" class="legal-toc-link">⚖️ Regulamin Serwisu</a></li>
                            <li><a href="/polityka-prywatnosci" class="legal-toc-link">🛡️ Polityka prywatności</a></li>
                        </ul>
                    </div>

                    <div class="legal-sidebar-card" style="background:var(--brand-soft); border-color:rgba(9,113,113,0.25);">
                        <div class="legal-sidebar-title" style="color:var(--brand-dark);">
                            <span>🚨</span> Bezpośredni kontakt DSA
                        </div>
                        <p style="font-size:0.84rem; color:var(--brand-dark); margin-bottom:8px;">
                            Punkt kontaktowy ds. nielegalnych treści (Digital Services Act):
                        </p>
                        <a href="mailto:safety@oddajdalej.pl" style="font-size:0.88rem; font-weight:700; color:var(--brand-dark); text-decoration:none;">
                            ✉️ safety@oddajdalej.pl
                        </a>
                    </div>
                </aside>

            </div>
        </div>
    </section>

    <!-- Pływający przycisk powrotu na górę -->
    <button type="button" id="legalBackToTop" class="legal-back-to-top" title="Przewiń na górę strony" @onclick="ScrollToTop">
        ↑
    </button>

    <SiteFooter />
</div>

@code {
    private string activeSection = "";
    private string selectedReason = "fraud";
    private string listingRef = "";
    private string reporterEmail = "";
    private string description = "";
    private bool declarationChecked = false;

    private bool isSubmitted = false;
    private string reportNumber = "";
    private string? errorMessage = null;

    private class ReasonItem
    {
        public string Key { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private readonly List<ReasonItem> reasonsList = new()
    {
        new ReasonItem { Key = "fraud", Icon = "⚠️", Title = "Podejrzenie oszustwa", Description = "Wyłudzenie zaliczki, fałszywy link do płatności lub kuriera" },
        new ReasonItem { Key = "scalping", Icon = "📈", Title = "Zawyżona cena (konik)", Description = "Cena wyższa niż nominalna wartość biletu (art. 133 KW)" },
        new ReasonItem { Key = "fake_ticket", Icon = "🎟️", Title = "Fałszywy bilet / rezerwacja", Description = "Podejrzenie sfałszowania, bilet nieważny lub wykorzystany" },
        new ReasonItem { Key = "prohibited", Icon = "🚫", Title = "Przedmiot zabroniony", Description = "Alkohol, leki, tytoń, przedmioty nielegalne" },
        new ReasonItem { Key = "spam", Icon = "📢", Title = "Spam lub złe dane", Description = "Niewłaściwa kategoria, powielone oferty, reklama" },
        new ReasonItem { Key = "abuse", Icon = "⛔", Title = "Nękanie / wulgaryzmy", Description = "Obraźliwe zachowanie na czacie, mowa nienawiści" }
    };

    private void SelectReason(string key)
    {
        selectedReason = key;
    }

    private async Task ScrollToSection(string id)
    {
        activeSection = id;
        await JS.InvokeVoidAsync("scrollToLegalSection", id);
    }

    private async Task ScrollToTop()
    {
        await JS.InvokeVoidAsync("scrollToTop");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initLegalScrollspy");
        }
    }

    private void SubmitReport()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(listingRef))
        {
            errorMessage = "Podaj link lub identyfikator ogłoszenia.";
            return;
        }

        if (string.IsNullOrWhiteSpace(reporterEmail) || !reporterEmail.Contains('@'))
        {
            errorMessage = "Podaj poprawny adres e-mail do kontaktu.";
            return;
        }

        if (string.IsNullOrWhiteSpace(description) || description.Trim().Length < 10)
        {
            errorMessage = "Wpisz szczegółowy opis sytuacji (minimum 10 znaków).";
            return;
        }

        if (!declarationChecked)
        {
            errorMessage = "Musisz zaznaczyć oświadczenie o prawdziwości zgłoszenia.";
            return;
        }

        var randomCode = Random.Shared.Next(10000, 99999);
        reportNumber = $"NAD-2026-{randomCode}";
        isSubmitted = true;

        notify.AddNotification(
            "Zgłoszenie przyjęte",
            $"Zgłoszenie #{reportNumber} zostało zarejestrowane. Zespół moderacji zweryfikuje sprawę."
        );
    }

    private void ResetForm()
    {
        isSubmitted = false;
        listingRef = "";
        description = "";
        declarationChecked = false;
        errorMessage = null;
    }
}
