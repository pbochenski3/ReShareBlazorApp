        ),
        new FaqItem(
            9,
            "Bezpieczeństwo",
            "Jak zgłosić podejrzane ogłoszenie lub użytkownika?",
            "<p>Jeśli natrafisz na ogłoszenie naruszające zasady lub podejrzewasz próbę oszustwa, kliknij link <strong>„Zgłaszanie nadużyć”</strong> w stopce strony lub wyślij wiadomość bezpośrednio na <strong>pomoc@oddajdalej.pl</strong> z linkiem do ogłoszenia.</p>"
        ),
        new FaqItem(
            10,
            "Konto użytkownika",
            "Jak założyć konto i czy jest to konieczne?",
            "<p>Przeglądanie i wyszukiwanie ogłoszeń jest dostępne dla wszystkich bez logowania. Jednak aby dodać własne ogłoszenie lub prowadzić konwersacje w module wiadomości, należy posiadać bezpłatne konto.</p><p>Rejestracja trwa kilkanaście sekund – wystarczy podać nazwę użytkownika, adres e-mail i hasło na stronie <a href='/register'>Rejestracji</a>.</p>"
        ),
        new FaqItem(
            11,
            "Konto użytkownika",
            "Gdzie mogę zobaczyć moje ogłoszenia i edytować profil?",
            "<p>Po zalogowaniu kliknij w link <strong>„Profil”</strong> w prawym górnym rogu strony. Zobaczysz tam podsumowanie swojego konta, dodane ogłoszenia oraz opinie.</p>"
        )
    };

    private IEnumerable<FaqItem> FilteredFaqs
    {
        get
        {
            var items = faqItems.AsEnumerable();

            if (selectedCategory != "Wszystkie")
            {
                items = items.Where(x => x.Category == selectedCategory);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var query = searchQuery.Trim();
                items = items.Where(x =>
                    x.Question.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    x.AnswerHtml.Contains(query, StringComparison.OrdinalIgnoreCase));
            }

            return items;
        }
    }

    private void ToggleQuestion(int id)
    {
        if (openQuestionIds.Contains(id))
        {
            openQuestionIds.Remove(id);
        }
        else
        {
            openQuestionIds.Add(id);
        }
    }

    private void SelectCategory(string category)
    {
        selectedCategory = category;
    }
}
