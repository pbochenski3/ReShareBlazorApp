@page "/pomoc"
@page "/help"
@page "/faq"
@rendermode InteractiveServer

@using ReShareBlazorApp.Web.Components.Elements
@using ReShareBlazorApp.Web.Components.Pages.NavBar

<PageTitle>Centrum Pomocy – ODDAJ DALEJ</PageTitle>

<PageHeader Title="Centrum Pomocy"
            Subtitle="Masz pytania dotyczące korzystania z serwisu? Sprawdź odpowiedzi na najczęściej zadawane pytania lub skontaktuj się z nami." />

<div class="help-page">
    <div class="home-container">

        <!-- Pole wyszukiwania pytań -->
        <div class="help-search-container">
            <div class="help-search-input-wrapper">
                <span class="help-search-icon">🔍</span>
                <input type="text"
                       class="help-search-input"
                       placeholder="Wpisz pytanie lub słowo kluczowe (np. jak dodać, odbiór, konto)..."
                       @bind="searchQuery"
                       @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <button type="button" class="help-search-clear" @onclick="() => searchQuery = string.Empty" title="Wyczyść">
                        ✕
                    </button>
                }
            </div>
        </div>

        <!-- Szybkie kafelki pomocy -->
        <div class="help-quick-cards">
            <a href="/add-product" class="help-quick-card">
                <div class="help-quick-icon">📝</div>
                <h3 class="help-quick-title">Dodaj ogłoszenie</h3>
                <p class="help-quick-desc">Dowiedz się, jak wystawić produkt, bilet lub oddać niepotrzebną rzecz.</p>
            </a>

            <div class="help-quick-card" style="cursor: pointer;" @onclick='() => SelectCategory("Bezpieczeństwo")'>
                <div class="help-quick-icon">🛡️</div>
                <h3 class="help-quick-title">Zasady bezpieczeństwa</h3>
                <p class="help-quick-desc">Sprawdź, jak bezpiecznie przeprowadzać transakcje i unikać oszustw.</p>
            </div>

            <a href="mailto:pomoc@oddajdalej.pl" class="help-quick-card">
                <div class="help-quick-icon">💬</div>
                <h3 class="help-quick-title">Napisz do nas</h3>
                <p class="help-quick-desc">Nasz zespół wsparcia chętnie pomoże rozwiązać każdy Twój problem.</p>
            </a>
        </div>

        <!-- Zakładki kategorii pytań -->
        <div class="help-nav-tabs">
            @foreach (var cat in categories)
            {
                <button type="button"
                        class="help-tab-btn @(selectedCategory == cat ? "active" : "")"
                        @onclick="() => SelectCategory(cat)">
                    @cat
                </button>
            }
        </div>

        <!-- Lista pytań i odpowiedzi (Akordeon) -->
        <div class="help-faq-section">
            @if (FilteredFaqs.Any())
            {
                <div class="help-faq-list">
                    @foreach (var item in FilteredFaqs)
                    {
                        var isOpen = openQuestionIds.Contains(item.Id);
                        <div class="faq-card @(isOpen ? "open" : "")">
                            <button type="button" class="faq-toggle-btn" @onclick="() => ToggleQuestion(item.Id)">
                                <span>@item.Question</span>
                                <span class="faq-arrow">▼</span>
                            </button>

                            @if (isOpen)
                            {
                                <div class="faq-content">
                                    @((MarkupString)item.AnswerHtml)
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="help-empty-results">
                    <h3>Nie znaleziono odpowiedzi na zapytanie „@searchQuery”</h3>
                    <p>Spróbuj użyć innych słów kluczowych lub skontaktuj się bezpośrednio z naszym działem pomocy.</p>
                </div>
            }
        </div>

        <!-- Baner wsparcia / kontaktu -->
        <div class="help-contact-banner">
            <div class="help-contact-info">
                <h3>Potrzebujesz indywidualnej pomocy?</h3>
                <p>Nasz zespół jest do Twojej dyspozycji od poniedziałku do piątku w godzinach 8:00 – 18:00.<br />Napisz do nas na <strong>pomoc@oddajdalej.pl</strong>.</p>
            </div>
            <div class="help-contact-actions">
                <a href="mailto:pomoc@oddajdalej.pl" class="help-btn-white">Skontaktuj się</a>
            </div>
        </div>

    </div>
</div>

<SiteFooter />

@code {
    private string searchQuery = "";
    private string selectedCategory = "Wszystkie";
    private HashSet<int> openQuestionIds = new() { 1 }; // pierwsze pytanie domyślnie otwarte

    private readonly List<string> categories = new()
    {
        "Wszystkie",
        "Dodawanie ogłoszeń",
        "Kupowanie i odbiór",
        "Bezpieczeństwo",
        "Konto użytkownika"
    };

    private record FaqItem(int Id, string Category, string Question, string AnswerHtml);

    private readonly List<FaqItem> faqItems = new()
    {
        new FaqItem(
            1,
            "Dodawanie ogłoszeń",
