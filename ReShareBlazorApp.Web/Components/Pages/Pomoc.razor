        ),
        new FaqItem(
            2,
            "Dodawanie ogłoszeń",
            "Czy wystawianie ogłoszeń jest płatne?",
            "<p><strong>Nie!</strong> Dodawanie ogłoszeń na platformie ODDAJ DALEJ jest w 100% bezpłatne – bez żadnych ukrytych prowizji czy opłat za wystawienie, zarówno przy sprzedaży, oddawaniu za darmo, jak i w poszukiwaniu ofert.</p>"
        ),
        new FaqItem(
            3,
            "Dodawanie ogłoszeń",
            "Czym różnią się typy ogłoszeń: Sprzedam, Oddam, Szukam?",
            "<p>Platforma obsługuje 3 główne typy ogłoszeń:</p><ul><li><strong>Sprzedam:</strong> Gdy posiadasz bilet, rezerwację, transport lub rzecz i chcesz ją odpłatnie odsprzedać.</li><li><strong>Oddam:</strong> Gdy chcesz przekazać coś zupełnie za darmo innej osobie (np. bilet, którego nie wykorzystasz, książkę, sprzęt).</li><li><strong>Szukam:</strong> Gdy pilnie potrzebujesz biletów, transportu lub pomocy w określonym terminie.</li></ul>"
        ),
        new FaqItem(
            4,
            "Dodawanie ogłoszeń",
            "Jak długo moje ogłoszenie będzie widoczne?",
            "<p>Termin ważności określasz samodzielnie w polu <strong>„Data ważności”</strong> podczas tworzenia ogłoszenia. Po nadejściu wskazanego terminu ogłoszenie automatycznie przestaje być prezentowane w wynikach wyszukiwania.</p>"
        ),
        new FaqItem(
            5,
            "Kupowanie i odbiór",
            "Jak mogę skontaktować się z autorem ogłoszenia?",
            "<p>Przejdź na stronę szczegółów wybranego ogłoszenia i kliknij przycisk <strong>„Skontaktuj się”</strong> lub <strong>„Napisz wiadomość”</strong>. Zostaniesz przeniesiony do wewnętrznego czatu <em>Wiadomości</em>, gdzie możesz bezpiecznie omówić szczegóły przekazania i warunki.</p>"
        ),
        new FaqItem(
            6,
            "Kupowanie i odbiór",
            "W jaki sposób realizowana jest płatność i przekazanie przedmiotu?",
            "<p>Ustalenia dotyczące sposobu zapłaty oraz przekazania przedmiotu lub biletów leżą w gestii użytkowników. <strong>Rekomendujemy odbiór osobisty</strong> w publicznym, oświetlonym miejscu lub bezpośrednie przekazanie cyfrowe biletów po potwierdzeniu tożsamości.</p>"
        ),
        new FaqItem(
            7,
            "Kupowanie i odbiór",
            "Co zrobić, gdy ogłoszenie jest już nieaktualne?",
            "<p>Jeśli autor ogłoszenia poinformuje Cię, że przedmiot został już oddany lub sprzedany, autor może usunąć ogłoszenie. Możesz również zgłosić nieaktualną ofertę za pomocą formularza zgłoszeń.</p>"
        ),
        new FaqItem(
            8,
            "Bezpieczeństwo",
            "Jakie są podstawowe zasady bezpieczeństwa transakcji?",
