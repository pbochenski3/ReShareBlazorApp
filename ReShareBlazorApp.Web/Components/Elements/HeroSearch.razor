@using ReShareBlazorApp.Api.Date.Enums
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Web.ApiServices
@inject ProductApiService productApi

<section class="home-hero" id="szukaj">
    <div class="home-container">
        <h1 class="home-hero-title">
            Oddaj dalej to, czego już nie potrzebujesz
        </h1>

        <p class="home-hero-lead">
            Bilety, miejsca w aucie, noclegi, sprzęt i wolne terminy.
            Znajdź je albo wystaw własne ogłoszenie.
        </p>

        <form class="home-search" method="get" action="/odkrywaj" role="search">

            <div class="home-search-row">
                <label class="home-field home-field-wide">
                    <span>Czego szukasz?</span>
                    <SearchAutocomplete Name="q"
                                        ListId="home-suggestions"
                                        Value="@q"
                                        Placeholder="np. bilety na koncert" />
                </label>

                <label class="home-field">
                    <span>Kategoria</span>
                    <select name="kategoria" value="@kategoria">
                        <option value="">Wszystkie</option>
                        @foreach (var category in Enum.GetValues<ProductCategory>())
                        {
                            <option value="@category">@GetCategoryName(category)</option>
                        }
                    </select>
                </label>

                <label class="home-field">
                    <span>Typ ogłoszenia</span>
                    <select name="typ" value="@typ">
                        <option value="">Wszystkie</option>
                        <option value="Sprzedam">Sprzedam</option>
                        <option value="Oddam">Oddam</option>
                        <option value="Mam wolne miejsce">Mam wolne miejsce</option>
                        <option value="Szukam">Szukam</option>
                        <option value="Oferuję wolny termin">Oferuję wolny termin</option>
                    </select>
                </label>
            </div>

            <div class="home-search-row">
                <label class="home-field home-field-wide">
                    <span>Lokalizacja</span>
                    <input type="text"
                           name="lokalizacja"
                           @bind="lokalizacja"
                           @bind:event="oninput"
                           @bind:after="LoadSuggestedLocations"
                           list="polskie-miasta"
                           placeholder="Wpisz miejscowość..." />

                    <datalist id="polskie-miasta">
                        @foreach (var city in SuggestedLocations)
                        {
                            <option value="@city.Name"></option>
                        }
                    </datalist>
                </label>

                <label class="home-field">
                    <span>Od</span>
                    <input type="date" name="od" value="@od" />
                </label>

                <label class="home-field">
                    <span>Do</span>
                    <input type="date" name="do" value="@dataDo" />
                </label>
            </div>

            <div class="home-search-row">
                <label class="home-field">
                    <span>Cena od (zł)</span>
                    <input type="number" name="cenaMin"
                           value="@cenaMin" min="0" placeholder="0" />
                </label>

                <label class="home-field">
                    <span>Cena do (zł)</span>
                    <input type="number" name="cenaMax"
                           value="@cenaMax" min="0" placeholder="1000" />
                </label>

                <button class="home-btn home-btn-primary home-search-submit"
                        type="submit">
                    SZUKAJ
                </button>
            </div>
        </form>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? q { get; set; }

    [SupplyParameterFromQuery(Name = "kategoria")]
    public string? kategoria { get; set; }

    [SupplyParameterFromQuery(Name = "typ")]
    public string? typ { get; set; }

    [SupplyParameterFromQuery(Name = "lokalizacja")]
    public string? lokalizacja { get; set; }

    [SupplyParameterFromQuery(Name = "od")]
    public string? od { get; set; }

    [SupplyParameterFromQuery(Name = "do")]
    public string? dataDo { get; set; }

    [SupplyParameterFromQuery(Name = "cenaMin")]
    public string? cenaMin { get; set; }

    [SupplyParameterFromQuery(Name = "cenaMax")]
    public string? cenaMax { get; set; }
    private List<LocationDTO> SuggestedLocations = new();

    private async Task LoadSuggestedLocations()
    {
        if (string.IsNullOrWhiteSpace(lokalizacja) ||
            lokalizacja.Trim().Length < 2)
        {
            SuggestedLocations.Clear();
            return;
        }

        SuggestedLocations = await productApi.SearchLocationsAsync(
            lokalizacja.Trim());
    }
    private string GetCategoryName(ProductCategory category)
    {
        return category switch
        {
            ProductCategory.Tickets => "Bilety",
            ProductCategory.Reservations => "Rezerwacje",
            ProductCategory.Trips => "Wyjazdy i podróże",
            ProductCategory.Transports => "Transport",
            ProductCategory.Services => "Usługi",
            _ => category.ToString()
        };
    }
}
