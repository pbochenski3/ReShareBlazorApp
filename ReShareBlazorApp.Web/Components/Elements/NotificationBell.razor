@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Shared.Enums
@using ReShareBlazorApp.Web.ApiServices
@implements IDisposable
@inject NotificationApiService NotificationApi
@inject NavigationManager Navigation
@implements IDisposable

<div class="notification-center">
    <button type="button"
            class="notification-bell"
            aria-label="Powiadomienia"
            aria-expanded="@isOpen"
            title="Powiadomienia"
            @onclick="Toggle">
<NavLink class="navbar-notifications-link" href="/powiadomienia" ActiveClass="active" aria-label="@AriaLabel">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
            <path d="M10 21h4" />
        </svg>
    <span>Powiadomienia</span>
        @if (UnreadCount > 0)
        {
            <span class="notification-bell-count">@UnreadCountLabel</span>
        <span class="navbar-notifications-count">@((UnreadCount > 99) ? "99+" : UnreadCount.ToString())</span>
        }
    </button>
</NavLink>

    @if (isOpen)
    {
        <section class="notification-dropdown" aria-label="Lista powiadomień">
            <header class="notification-dropdown-header">
                <div>
                    <strong>Powiadomienia</strong>
                    <span>@(UnreadCount == 0 ? "Wszystko przeczytane" : $"{UnreadCount} nieprzeczytanych")</span>
                </div>
                <button type="button" class="notification-refresh" @onclick="RefreshAsync" title="Odśwież">↻</button>
            </header>

            @if (isLoading)
            {
                <div class="notification-empty">Ładowanie powiadomień…</div>
            }
            else if (notifications.Count == 0)
            {
                <div class="notification-empty">
                    <span class="notification-empty-icon">♧</span>
                    <strong>Brak powiadomień</strong>
                    <span>W tym miejscu zobaczysz nowe opinie i ważne aktywności konta.</span>
                </div>
            }
            else
            {
                <div class="notification-list">
                    @foreach (var item in notifications)
                    {
                        <article class="notification-item @(item.IsRead ? "" : "unread")" @key="item.Id">
                            <button type="button" class="notification-item-main" @onclick="() => OpenAsync(item)">
                                <span class="notification-item-icon">@GetIcon(item.Type)</span>
                                <span class="notification-item-content">
                                    <strong>@item.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.ActorName))
                                    {
                                        <span class="notification-actor">@item.ActorName</span>
                                    }
                                    <span class="notification-message">@item.Message</span>
                                    <time>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy, HH:mm")</time>
                                </span>
                                @if (!item.IsRead)
                                {
                                    <span class="notification-unread-dot" aria-label="Nieprzeczytane"></span>
                                }
                            </button>
                            <button type="button" class="notification-delete" title="Usuń powiadomienie" aria-label="Usuń powiadomienie" @onclick="() => DeleteAsync(item.Id)">×</button>
                        </article>
                    }
                </div>
            }
            <footer class="notification-dropdown-footer">
                <span>Ostatnie 100 powiadomień</span>
            </footer>
        </section>
    }
</div>

@code {
    private List<NotificationDTO> notifications = new();
    private bool isOpen;
    private bool isLoading;
    private bool disposed;
    private CancellationTokenSource? pollingCts;
    private int UnreadCount;
    private CancellationTokenSource? _cancellation;

    private int UnreadCount => notifications.Count(item => !item.IsRead);
    private string UnreadCountLabel => UnreadCount > 99 ? "99+" : UnreadCount.ToString();
    private string AriaLabel => UnreadCount > 0
        ? $"Powiadomienia, nieprzeczytane: {UnreadCount}"
        : "Powiadomienia";

    protected override async Task OnInitializedAsync()
    // Nie wykonujemy zapytań HTTP w OnInitializedAsync.
    // Komponent może być wtedy renderowany statycznie (prerendering) po logowaniu.
    // Dopiero OnAfterRenderAsync uruchamia się po rozpoczęciu interaktywnego obwodu Blazora.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        NotificationApi.NotificationsChanged += OnNotificationsChanged;
        await RefreshAsync();
        pollingCts = new CancellationTokenSource();
        _ = PollAsync(pollingCts.Token);

        _cancellation = new CancellationTokenSource();
        _ = PollAsync(_cancellation.Token);
    }

    private async Task PollAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(45));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                var latest = await NotificationApi.GetNotificationsAsync();
                if (disposed) return;
                await InvokeAsync(() =>
                {
                    notifications = latest;
                    StateHasChanged();
                });
            }
                await RefreshAsync();
        }
        catch (OperationCanceledException) { }
    }

    private void Toggle() => isOpen = !isOpen;
    private void OnNotificationsChanged()
    {
        _ = InvokeAsync(RefreshAsync);
    }

    private async Task RefreshAsync()
    {
        isLoading = true;
        try
        {
            notifications = await NotificationApi.GetNotificationsAsync();
            var notifications = await NotificationApi.GetNotificationsAsync();
            UnreadCount = notifications.Count(item => !item.IsRead);
            await InvokeAsync(StateHasChanged);
        }
        finally
        catch (OperationCanceledException)
        {
            isLoading = false;
        }
            // Żądanie mogło zostać przerwane podczas zamykania/nawigacji.
    }

    private async Task OpenAsync(NotificationDTO item)
        catch (HttpRequestException)
    {
        if (!item.IsRead && await NotificationApi.MarkAsReadAsync(item.Id))
            item.IsRead = true;

        isOpen = false;
        if (item.ProductId.HasValue)
            Navigation.NavigateTo($"/details/{item.ProductId.Value}");
        else if (item.Type == NotificationType.NewMessage)
            Navigation.NavigateTo("/wiadomosci");
            // Chwilowy brak połączenia z API nie powinien psuć nawigacji.
    }

    private async Task DeleteAsync(int id)
    {
        if (await NotificationApi.DeleteAsync(id))
            notifications.RemoveAll(item => item.Id == id);
    }

    private static string GetIcon(NotificationType type) => type switch
    {
        NotificationType.NewReview => "★",
        NotificationType.NewMessage => "✉",
        NotificationType.OfferMatch => "⌕",
        _ => "•"
    };

    public void Dispose()
    {
        disposed = true;
        pollingCts?.Cancel();
        pollingCts?.Dispose();
        NotificationApi.NotificationsChanged -= OnNotificationsChanged;
        _cancellation?.Cancel();
        _cancellation?.Dispose();
    }
}
