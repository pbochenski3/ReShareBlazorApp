@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Web.ApiServices
@inject ProductApiService productApi
<section class="home-section">
    <div class="home-container">
        <div class="home-section-head">
            <h2 class="home-section-title">Najnowsze okazje</h2>

            <div class="home-view-switch" role="group" aria-label="Widok ogłoszeń">
                <button class="home-view-btn active" type="button">Kafelki</button>
                <button class="home-view-btn" type="button">Lista</button>
                <button class="home-view-btn" type="button">Mapa</button>
            </div>
        </div>

        <div class="home-cards">
            @foreach (var product in ProductsList)
            {
                <ListingCard Title="@product.Name"
                             Category="@product.Category.ToString()"
                             Type="Sprzedam"
                             Price="@product.Price.ToString("F2")"
                             Location="Kraków"
                             Term="@product.ExpiresAt.ToString("dd.MM.yyyy HH:mm")"
                             Published="@product.AddedAt.ToString("dd.MM.yyyy HH:mm")"
                             />
            }
        </div>

        <div class="home-section-footer">
            <a class="home-btn home-btn-outline" href="/oferty">Zobacz wszystkie oferty</a>
        </div>
    </div>
</section>
@code
{
    public List<ProductDTO> ProductsList { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        ProductsList = await productApi.GetProductsAsync();
    }
}
