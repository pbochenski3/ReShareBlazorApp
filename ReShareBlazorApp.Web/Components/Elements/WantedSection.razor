@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Shared.Enums
@using ReShareBlazorApp.Web.ApiServices

@inject ProductApiService productApi

<section class="home-section">

    <div class="home-container">

        <div class="home-section-head">

            <h2 class="home-section-title">
                Czego szukają użytkownicy?
            </h2>

            <a href="/type/szukam">
                Zobacz wszystkie
            </a>

        </div>

        <div class="looking-for-grid">

            @foreach (var product in LookingForProducts)
            {
                <LookingForCard Product="product" />
            }

        </div>

    </div>

</section>

@code {

    private List<ProductDTO> LookingForProducts = new();

    protected override async Task OnInitializedAsync()
    {
        var products =
            await productApi.GetProductsAsync();

        LookingForProducts = products
            .Where(x => x.Type == ProductType.LookingFor)
            .OrderByDescending(x => x.AddedAt)
            .Take(3)
            .ToList();
    }

}