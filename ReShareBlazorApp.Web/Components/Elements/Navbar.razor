@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ReShareBlazorApp.Api.Date.Enums
@using ReShareBlazorApp.Web.Components.Elements
@inject NavigationManager Navigation
@inject AuthenticationStateProvider asp

<nav class="main-navbar">
    <div class="main-navbar-container">

        <a class="main-navbar-brand" href="/">ODDAJ DALEJ</a>

        <ul class="main-navbar-links">
            <li class="main-navbar-item">
                <NavLink class="main-navbar-link" ActiveClass="active" href="/" Match="NavLinkMatch.All">
                    Home
                </NavLink>
            </li>

            <li class="main-navbar-item">
                <NavLink class="main-navbar-link" ActiveClass="active" href="/odkrywaj">
                    Odkrywaj
                </NavLink>
            </li>

            <AuthorizeView>
                <Authorized Context="auth">
                    <li class="main-navbar-item">
                        <NavLink class="main-navbar-link" ActiveClass="active" href="/wiadomosci">
                            Wiadomości
                        </NavLink>
                    </li>

                    <li class="main-navbar-item">
                        <NavLink class="main-navbar-link"
                                 ActiveClass="active"
                                 href="@($"/user/{auth.User.FindFirst(ClaimTypes.Name)?.Value}")">
                            Profil
                        </NavLink>
                    </li>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView>
                <NotAuthorized>
                    <li class="main-navbar-item">
                        <NavLink class="main-navbar-link" ActiveClass="active" href="/login">
                            Zaloguj się
                        </NavLink>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>

        
        <form class="navbar-search"
              role="search"
              @onsubmit="HandleSearch"
              @onsubmit:preventDefault>

            <div class="navbar-search-input">
                <SearchAutocomplete Name="q"
                                    ListId="navbar-suggestions"
                                    @bind-Value="searchText"
                                    AdditionalSuggestions="@CategorySuggestions"
                                    Placeholder="Szukaj ogłoszeń" />
            </div>

            <button class="navbar-search-button"
                    type="submit"
                    aria-label="Szukaj">
                <svg width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round">
                    <circle cx="11" cy="11" r="7" />
                    <line x1="16.5" y1="16.5" x2="22" y2="22" />
                </svg>
            </button>
        </form>


        <AuthorizeView>
            <Authorized>
                <a class="home-btn home-btn-primary" href="/add-product">
                    + Dodaj ogłoszenie
                </a>
            </Authorized>

            <NotAuthorized>
                <a class="home-btn home-btn-primary" href="/login">
                    + Dodaj ogłoszenie
                </a>
            </NotAuthorized>
        </AuthorizeView>

    </div>
</nav>

@code {
    private string? searchText = "";

    private List<string> CategorySuggestions =>
    Enum.GetValues<ProductCategory>()
        .Select(GetCategoryName)
        .ToList();

    private void HandleSearch()
    {
        var phrase = searchText?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(phrase))
            return;

        var category = GetCategoryFromName(phrase);

        if (category.HasValue)
        {
            Navigation.NavigateTo(
                $"/odkrywaj?kategoria={Uri.EscapeDataString(category.Value.ToString())}"
            );
        }
        else
        {
            Navigation.NavigateTo(
                $"/odkrywaj?q={Uri.EscapeDataString(phrase)}"
            );
        }
    }

    private ProductCategory? GetCategoryFromName(string phrase)
    {
        foreach (var category in Enum.GetValues<ProductCategory>())
        {
            if (string.Equals(
                GetCategoryName(category),
                phrase,
                StringComparison.OrdinalIgnoreCase))
            {
                return category;
            }
        }

        return null;
    }

    private string GetCategoryName(ProductCategory category)
    {
        return category switch
        {
            ProductCategory.Tickets => "Bilety",
            ProductCategory.Reservations => "Rezerwacje",
            ProductCategory.Trips => "Wyjazdy i podróże",
            ProductCategory.Transports => "Transport",
            ProductCategory.Services => "Usługi",
            _ => category.ToString()
        };
    }
}