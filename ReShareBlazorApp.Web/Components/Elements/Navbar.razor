@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider asp

<nav class="main-navbar">
    <div class="main-navbar-container">

        <a class="main-navbar-brand" href="/">ODDAJ DALEJ</a>

        <ul class="main-navbar-links">
            <li class="main-navbar-item">
                <NavLink class="main-navbar-link" ActiveClass="active" href="/" Match="NavLinkMatch.All">
                    Home
                </NavLink>
            </li>

            <li class="main-navbar-item">
                <NavLink class="main-navbar-link" ActiveClass="active" href="/odkrywaj">
                    Odkrywaj
                </NavLink>
            </li>

            <AuthorizeView>
                <Authorized Context="auth">
                    <li class="main-navbar-item">
                        <NavLink class="main-navbar-link" ActiveClass="active" href="/wiadomosci">
                            Wiadomości
                        </NavLink>
                    </li>

                    <li class="main-navbar-item">
                        <NavLink class="main-navbar-link"
                                 ActiveClass="active"
                                 href="@($"/user/{auth.User.FindFirst(ClaimTypes.Name)?.Value}")">
                            Profil
                        </NavLink>
                    </li>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView>
                <NotAuthorized>
                    <li class="main-navbar-item">
                        <NavLink class="main-navbar-link" ActiveClass="active" href="/login">
                            Zaloguj się
                        </NavLink>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>

        <form class="navbar-search" role="search" method="get" action="/odkrywaj">
            <input class="navbar-search-input"
                   type="search"
                   name="q"
                   placeholder="Szukaj ogłoszeń"
                   aria-label="Szukaj" />

            <button class="navbar-search-button" type="submit" aria-label="Szukaj">
                <svg width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round">
                    <circle cx="11" cy="11" r="7" />
                    <line x1="16.5" y1="16.5" x2="22" y2="22" />
                </svg>
            </button>
        </form>

        <AuthorizeView>
            <Authorized>
                <a class="home-btn home-btn-primary" href="/add-product/false">
                    + Dodaj ogłoszenie
                </a>
            </Authorized>

            <NotAuthorized>
                <a class="home-btn home-btn-primary" href="/login">
                    + Dodaj ogłoszenie
                </a>
            </NotAuthorized>
        </AuthorizeView>

    </div>
</nav>
