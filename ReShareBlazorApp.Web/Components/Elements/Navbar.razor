@using Microsoft.AspNetCore.Components.Authorization

<nav class="main-navbar" aria-label="Główna nawigacja">
    <div class="main-navbar-container">
        <a class="main-navbar-brand" href="/">ODDAJ DALEJ</a>

        <ul class="main-navbar-links">
            <li class="main-navbar-item">
                <NavLink class="main-navbar-link" ActiveClass="active" href="/" Match="NavLinkMatch.All">Home</NavLink>
            </li>
            <li class="main-navbar-item">
                <NavLink class="main-navbar-link" ActiveClass="active" href="/odkrywaj">Odkrywaj</NavLink>
            </li>

            <AuthorizeView>
                <Authorized>
                    @* zalogowany: ulubione, wiadomości, profil i wylogowanie *@
                    <li class="main-navbar-item">
                        <NavLink class="main-navbar-link" ActiveClass="active" href="/ulubione">Ulubione</NavLink>
                    </li>
                    <li class="main-navbar-item">
                        <NavLink class="main-navbar-link" ActiveClass="active" href="/wiadomosci">Wiadomości</NavLink>
                    </li>

                    @if (!string.IsNullOrWhiteSpace(context.User.Identity?.Name))
                    {
                        <li class="main-navbar-item">
                            <NavLink class="main-navbar-link" ActiveClass="active" href="@ProfileHref(context.User.Identity!.Name!)">Profil</NavLink>
                        </li>
                    }

                    @if (context.User.IsInRole("Admin"))
                    {
                        <li class="main-navbar-item">
                            <NavLink class="main-navbar-link" ActiveClass="active" href="/admin">Panel admina</NavLink>
                        </li>
                    }

                    <li class="main-navbar-item">
                        <form method="post" action="/auth/logout" class="main-navbar-logout">
                            <AntiforgeryToken />
                            <button type="submit" class="main-navbar-link main-navbar-logout-btn">Wyloguj się</button>
                        </form>
                    </li>
                </Authorized>
                <NotAuthorized>
                    @* niezalogowany: tylko logowanie *@
                    <li class="main-navbar-item">
                        <NavLink class="main-navbar-link" ActiveClass="active" href="/login">Zaloguj się</NavLink>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>

        <form class="navbar-search" role="search" method="get" action="/odkrywaj">
            <input class="navbar-search-input"
                   type="search"
                   name="q"
                   placeholder="Szukaj ogłoszeń"
                   aria-label="Szukaj"
                   autocomplete="off" />

            <button class="navbar-search-button" type="submit" aria-label="Szukaj">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <line x1="16.5" y1="16.5" x2="22" y2="22" />
                </svg>
            </button>
        </form>

        <a class="home-btn home-btn-primary" href="/add-product">+ Dodaj ogłoszenie</a>
    </div>
</nav>

@code {
    // Profil użytkownika żyje pod adresem /user/{nazwa}
    private static string ProfileHref(string userName)
        => "/user/" + Uri.EscapeDataString(userName);
}