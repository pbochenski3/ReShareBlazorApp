@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider asp

<nav class="main-navbar">
    <div class="main-navbar-container">

        <a class="main-navbar-brand" href="/">ODDAJ DALEJ</a>

        <ul class="main-navbar-links">
            <li class="main-navbar-item">
                <NavLink class="main-navbar-link" ActiveClass="active" href="/" Match="NavLinkMatch.All">
                    Home
                </NavLink>
            </li>

            <li class="main-navbar-item">
                <NavLink class="main-navbar-link" ActiveClass="active" href="/odkrywaj">
                    Odkrywaj
                </NavLink>
            </li>

            <AuthorizeView>
                <Authorized Context="auth">
                    <li class="main-navbar-item">
                        <NavLink class="main-navbar-link" ActiveClass="active" href="/wiadomosci">
                            Wiadomości
                        </NavLink>
                    </li>

                    <li class="main-navbar-item">
                        <NavLink class="main-navbar-link"
                                 ActiveClass="active"
                                 href="@($"/user/{auth.User.FindFirst(ClaimTypes.Name)?.Value}")">
                            Profil

                        </NavLink>
                    </li>
                    <li class="main-navbar-item">
                        <form method="post" action="/auth/logout">
                            <AntiforgeryToken />
                            <button type="submit" class="main-navbar-link main-navbar-logout">
                                Wyloguj się
                            </button>
                        </form>
                    </li>
                </Authorized>
            </AuthorizeView>
      
            <AuthorizeView>
                <NotAuthorized>
                    <li class="main-navbar-item">
                        <NavLink class="main-navbar-link" ActiveClass="active" href="/login">
                            Zaloguj się
                        </NavLink>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>

        <form class="navbar-search" role="search" method="get" action="/odkrywaj">
            <input class="navbar-search-input"
                   type="search"
                   name="q"
                   placeholder="Szukaj ogłoszeń"
                   aria-label="Szukaj" />

            <button class="navbar-search-button" type="submit" aria-label="Szukaj">
                <svg width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round">
                    <circle cx="11" cy="11" r="7" />
                    <line x1="16.5" y1="16.5" x2="22" y2="22" />
                </svg>
            </button>
        </form>

        <button type="button"
                class="theme-toggle"
                onclick="toggleTheme()"
                aria-label="Przełącz motyw jasny/ciemny"
                title="Przełącz motyw">
            <svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
            <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
        </button>

        <AuthorizeView>
            <Authorized>
                <a class="home-btn home-btn-primary" href="/add-product">
                    + Dodaj ogłoszenie
                </a>
            </Authorized>

            <NotAuthorized>
                <a class="home-btn home-btn-primary" href="/login">
                    + Dodaj ogłoszenie
                </a>
            </NotAuthorized>
        </AuthorizeView>

    </div>
</nav>
