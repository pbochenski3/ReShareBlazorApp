@using ReShareBlazorApp.Api.Date.Enums

<section class="home-section home-section-alt">
    <div class="home-container">
        <h2 class="home-section-title">Kategorie</h2>

        <div class="home-categories">
            @foreach (var cat in Enum.GetValues<ProductCategory>())
            {
                <a class="home-category" href="@($"/category/{(int)cat}")">
                    <strong>
                        @GetCategoryName(cat)
                    </strong>

                    <span>
                        @GetCategoryDescription(cat)
                    </span>
                </a>
            }
        </div>
    </div>
</section>

@code {
    private string GetCategoryName(ProductCategory category)
    {
        return category switch
        {
            ProductCategory.Tickets => "Bilety",
            ProductCategory.Reservations => "Rezerwacje",
            ProductCategory.Trips => "Wyjazdy i podróże",
            ProductCategory.Transports => "Transport i miejsca",
            ProductCategory.Services => "Usługi i wolne terminy",
            _ => "Inne"
        };
    }

    private string GetCategoryDescription(ProductCategory category)
    {
        return category switch
        {
            ProductCategory.Tickets => "Koncerty, mecze, vouchery, bilety",
            ProductCategory.Reservations => "Hotele, wakacje, wycieczki, noclegi",
            ProductCategory.Trips => "Wakacje, wycieczki, podróże",
            ProductCategory.Transports => "Przejazdy, samochody, busy, przewóz",
            ProductCategory.Services => "Fachowcy, fotografia, opieka, instruktorzy",
            _ => ""
        };
    }
}
