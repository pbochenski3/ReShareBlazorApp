@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Shared.Enums

<div class="looking-card">

    @if (Product.ImageIds != null && Product.ImageIds.Count > 0)
    {
        <img class="looking-card-image"
             src="@($"/images/{Product.ImageIds[0]}")"
             alt="@Product.Name" />
    }
    else
    {
        <div class="looking-card-image looking-card-image-placeholder">
            Brak zdjęcia
        </div>
    }

    <div class="looking-card-content">

        <h3 class="looking-card-title">
            @Product.Name
        </h3>

        <p class="looking-card-description">
            @Product.Description
        </p>

        <div class="looking-card-details">
            <div>
                <i class="fa-solid fa-location-dot"></i>
                @Product.City
            </div>

            <div>
                <i class="fa-regular fa-calendar"></i>
                
                Stan produktu: @GetConditionName(Product.Condition)
            </div>
            <div>
                <i class="fa-regular fa-calendar"></i>
                Termin: @Product.ExpiresAt.ToString("dd.MM.yyyy")
            </div>

            <div>
                <i class="fa-solid fa-coins"></i>
                Budżet: do @Product.Price zł
            </div>
        </div>

        <div class="looking-card-actions">

            <a class="home-btn home-btn-primary"
               href="@($"/details/{Product.ProductId}")">
                Szczegóły ogłoszenia
            </a>

            <a class="home-btn home-btn-outline"
               href="#">
                Skontaktuj się
            </a>

        </div>

    </div>
</div>

@code {
    [Parameter]
    public ProductDTO Product { get; set; } = default!;
    private string GetConditionName(ProductCondition condition)
    {
        return condition switch
        {
            ProductCondition.New => "Nowy",
            ProductCondition.LikeNew => "Jak nowy",
            ProductCondition.Good => "Dobry",
            ProductCondition.Fair => "Dostateczny",
            ProductCondition.Damaged => "Uszkodzony",
            _ => condition.ToString()
        };
    }
}
